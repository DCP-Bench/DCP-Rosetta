{
  "id": "gurobipy_python",
  "name": "Gurobi (Python)",
  "language": "python",
  "framework": "gurobipy",
  "solver": "gurobi",
  "paradigms": [
    "mip"
  ],
  "image": "dcp-eval/gurobipy_python:v1",
  "extension": ".py",
  "enumeration": true,
  "protocol_version": 1,
  "licence": {
    "id": "gurobi",
    "kind": "server",
    "port": 41954,
    "target": "/run/licence/gurobi.lic",
    "env": {
      "GRB_LICENSE_FILE": "/run/licence/gurobi.lic"
    },
    "without": "size-limited",
    "errors": [
      "No Gurobi license",
      "token server",
      "HostID mismatch"
    ]
  }
}
