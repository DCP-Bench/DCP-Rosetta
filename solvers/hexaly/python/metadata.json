{
  "id": "hexaly_python",
  "name": "Hexaly (Python)",
  "language": "python",
  "framework": "hexaly",
  "solver": "hexaly",
  "paradigms": [
    "cp"
  ],
  "image": "dcp-eval/hexaly_python:v1",
  "extension": ".py",
  "enumeration": true,
  "readiness_level": 2,
  "protocol_version": 1,
  "licence": {
    "id": "hexaly",
    "kind": "file",
    "target": "/run/licence/license.dat",
    "env": {
      "HX_LICENSE_PATH": "/run/licence/license.dat"
    },
    "without": "unavailable",
    "errors": [
      "Cannot open file [",
      "LICENSE_KEY",
      "Invalid license",
      "This license is no longer valid"
    ]
  }
}
