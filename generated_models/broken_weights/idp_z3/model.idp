// broken_weights: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// A merchant's measuring weight broke into a number of pieces when it fell. Each piece weighs a whole number of pounds,
// and the pieces can be used to weigh every integral weight between 1 and the total weight, on a balance scale, by
// placing weights on both pans.
//
// Save this file as model.idp. Download `broken_weights.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/broken_weights.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py broken_weights.json
//   idp-engine model_1.idp

vocabulary V {
    type Range_m <: Int                // the whole weights 1..m that must be weighed
    type Range_n <: Int                // the pieces, numbered 1..n
    m: () -> Int                       // the total weight of the broken measuring weight
    n: () -> Int                       // the number of pieces
    weights: Range_n -> Int            // weights(i): the weight of piece i in pounds (the output)
    with_object: Range_m * Range_n -> Bool   // with_object(k, i): piece i is on the same pan as the object of weight k
    other_pan: Range_m * Range_n -> Bool     // other_pan(k, i): piece i is on the other pan from the object of weight k
}

theory T:V {
    // every piece weighs a positive whole number of pounds
    ! i in Range_n: weights(i) >= 1.
    // the pieces together weigh the total weight m
    sum{{ weights(i) | i in Range_n }} = m().
    // a piece is on at most one pan
    ! k in Range_m, i in Range_n: ~(with_object(k, i) & other_pan(k, i)).
    // for every whole weight k from 1 to m, the pieces can balance an object of weight k: the pieces on the pan
    // opposite to the object weigh k more than the pieces on its pan
    ! k in Range_m: sum{{ weights(i) | i in Range_n: other_pan(k, i) }} = k + sum{{ weights(i) | i in Range_n: with_object(k, i) }}.
}

procedure main() {
    pretty_print(model_expand(T, S, max=1))
}
