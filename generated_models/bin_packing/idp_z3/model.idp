// bin_packing: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Given several items of specific weights and a number of bins of a fixed capacity, assign each item to a bin so that the total weight of the items in each bin does not exceed the capacity.
//
// Save this file as model.idp. Download `bin_packing.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/bin_packing.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py bin_packing.json
//   idp-engine model_1.idp

vocabulary V {
    type I <: Int                      // the items, numbered from 0, sized from weights
    type Range_num_bins <: Int         // the bins numbered 1..num_bins (the output bin is this number minus 1)
    capacity: () -> Int                // the capacity of each bin
    num_bins: () -> Int                // the number of bins available
    weights: I -> Int                  // weights(i): the weight of item i
    bins: I -> Int                     // bins(i): the bin item i is assigned to, 0-indexed
}

theory T:V {
    // every item is assigned to one of the bins, numbered from 0 to num_bins - 1
    ! i in I: 0 =< bins(i) & bins(i) =< num_bins() - 1.

    // the total weight of the items in each bin does not exceed the capacity
    ! b in Range_num_bins: sum{{ weights(i) | i in I: bins(i) + 1 = b }} =< capacity().
}

procedure main() {
    pretty_print(model_expand(T, S, max=1))
}
