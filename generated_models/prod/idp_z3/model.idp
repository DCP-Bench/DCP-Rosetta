// prod: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Consider a set of products P. For each product j in P, there is a parameter a(j), a parameter c(j) and a parameter
// u(j), and there is a global parameter b. The production quantity of each product j is X(j). The goal is to maximize
// the total profit, which is the sum of c(j) * X(j) over all products j in P. The constraints are that the sum of
// (1/a(j)) * X(j) over all products j in P is less than or equal to b, and that X(j) is between 0 and u(j) for every j
// in P.
//
// Save this file as model.idp. Download `prod.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/prod.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py prod.json
//   idp-engine model_1.idp
vocabulary V {
    type P <: Int                      // the products, numbered from 0, sized from a
    a: P -> Int                        // a(j): the divisor of product j in the resource constraint
    c: P -> Int                        // c(j): the profit per unit of product j
    u: P -> Int                        // u(j): the largest production quantity of product j
    b: () -> Int                       // the bound on the sum of X(j) / a(j)
    x: P -> Int                        // x(j): the production quantity of product j (declared output)
    q: P -> Real                       // q(j): the exact value of X(j) / a(j), as a real number
    total_profit: () -> Int            // the total profit of the production
    maximize: () -> Int                // the total profit, to maximize
}
theory T:V {
    // the production quantity of each product is between 0 and its largest quantity
    ! j in P: 0 =< x(j) & x(j) =< u(j).
    // q(j) is X(j) / a(j) when a(j) is not zero
    ! j in P: a(j) ~= 0 => q(j) * a(j) = x(j).
    // (assumption, not in the statement, where 1/a(j) is undefined for a(j) = 0: such a product adds nothing to the sum)
    ! j in P: a(j) = 0 => q(j) = 0.
    // the sum of X(j) / a(j) over all products is at most b
    sum{{ q(j) | j in P }} =< b().
    // the total profit is the sum of c(j) * X(j) over all products
    total_profit() = sum{{ (c(j) * x(j)) | j in P }}.
    // the total profit is maximized
    maximize() = total_profit().
}
procedure main() {
    pretty_print(maximize(T, S, term="maximize()"))
}
