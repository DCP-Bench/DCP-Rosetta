// csplib_003_quasigroup_existence: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// An order m quasigroup is a Latin square of size m: an m by m multiplication table in which each element occurs once in
// every row and once in every column. The problem asks for an order m quasigroup with the QG3 property, that is
// (a*b)*(b*a) = a for all elements a and b. The quasigroup is written as a table of integers from 0 to m-1.
//
// Save this file as model.idp. Download `csplib_003_quasigroup_existence.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/csplib_003_quasigroup_existence.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py csplib_003_quasigroup_existence.json
//   idp-engine model_1.idp

vocabulary V {
    type Range_m <: Int                       // the elements, numbered 1 to m (element k is the value k - 1)
    prod: Range_m * Range_m -> Range_m        // prod(a, b): the product a*b of two elements, numbered from 1
    quasigroup: Range_m * Range_m -> Int      // quasigroup(i, j): the value of i*j, from 0 to m-1
}

theory T:V {
    // each element occurs once in every row: for each a, the products a*b differ for different b
    ! a, b1, b2 in Range_m: b1 ~= b2 => prod(a, b1) ~= prod(a, b2).

    // each element occurs once in every column: for each b, the products a*b differ for different a
    ! a1, a2, b in Range_m: a1 ~= a2 => prod(a1, b) ~= prod(a2, b).

    // the QG3 property: (a*b)*(b*a) = a for all elements a and b
    ! a, b in Range_m: prod(prod(a, b), prod(b, a)) = a.

    // the table holds the values from 0 to m-1: element k is written k - 1
    ! i, j in Range_m: quasigroup(i, j) = prod(i, j) - 1.
}

procedure main() {
    pretty_print(model_expand(T, S, max=1))
}
