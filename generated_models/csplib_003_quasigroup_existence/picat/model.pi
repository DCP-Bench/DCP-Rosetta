% csplib_003_quasigroup_existence: a Picat model from DCP Rosetta.
%
% An order m quasigroup is a Latin square of size m. That is, a m x m multiplication table in which each
% element occurs once in every row and column. A quasigroup can be specified by a set and a binary
% multiplication operator, * defined over this set. Quasigroup existence problems determine the existence or
% non-existence of quasigroups of a given size with additional properties.
%
% QG3.m problems are order m quasigroups for which (a*b)*(b*a) = a, for every a and b.
%
% Save this file as model.pi. Download `csplib_003_quasigroup_existence.json` and `dcp_convert_picat.py` from the
% problem's page:
%   https://dcp-bench.github.io/DCP-Rosetta/problems/csplib_003_quasigroup_existence.html
% Convert the instances once, then run the first one (Picat 3.9, https://picat-lang.org):
%   python dcp_convert_picat.py csplib_003_quasigroup_existence.json
%   picat model.pi csplib_003_quasigroup_existence_1.dat
%
% Data.get(m): the order m of the quasigroup.
import cp.

model(Data, Vars, Outputs, Options) =>
    M = Data.get(m),
    % Table[I,J] = the product I*J, numbered from 1 (the value V stands for the element V-1)
    Table = new_array(M, M),
    Table :: 1..M,
    % each element occurs once in every row of the table
    foreach (I in 1..M)
        all_different([Table[I,J] : J in 1..M])
    end,
    % each element occurs once in every column of the table
    foreach (J in 1..M)
        all_different([Table[I,J] : I in 1..M])
    end,
    % the table as a flat list, so that an entry can be looked up by its row and column
    Flat = [Table[I,J] : I in 1..M, J in 1..M],
    % (a*b)*(b*a) = a for every a and b
    foreach (A in 1..M, B in 1..M)
        U = Table[A,B],                    % a*b
        V = Table[B,A],                    % b*a
        Index #= (U - 1) * M + V,
        element(Index, Flat, A)            % the entry of row a*b and column b*a is a
    end,
    Vars = Table,
    % the output: the elements are numbered from 0
    Quasigroup = new_array(M, M),
    Quasigroup :: 0..M - 1,
    foreach (I in 1..M, J in 1..M)
        Quasigroup[I,J] #= Table[I,J] - 1
    end,
    Outputs = [quasigroup = Quasigroup],
    % any quasigroup with this property will do
    Options = [].

main([File]) =>
    Fd = open(File),
    Term = read_term(Fd),
    Term = $json_object(Keys, Values),
    close(Fd),
    Data = new_map([K = V : {K, V} in zip(Keys, Values)]),
    model(Data, Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
