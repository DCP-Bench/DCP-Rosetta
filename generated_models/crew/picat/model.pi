% crew: a Picat model from DCP Rosetta.
%
% Assign flight attendants to flights. Each flight needs a certain number of cabin crew, and they have to
% speak certain languages. attributes[p] describes person p as five 0/1 values: steward, hostess, speaks
% French, speaks Spanish, speaks German. required_crew[f] describes flight f as six numbers: the number of
% cabin crew, then the numbers of stewards, hostesses, French speakers, Spanish speakers and German speakers
% needed. A flight has exactly that number of cabin crew, and at least the required number of each of the
% others; one person can count towards several of them. Every cabin crew member has at least two flights off
% after an attended flight, so nobody attends more than one of any three consecutive flights.
%
% Save this file as model.pi. Download `crew.json` and `dcp_convert_picat.py` from the
% problem's page:
%   https://dcp-bench.github.io/DCP-Rosetta/problems/crew.html
% Convert the instances once, then run the first one (Picat 3.9, https://picat-lang.org):
%   python dcp_convert_picat.py crew.json
%   picat model.pi crew_1.dat
%
% Data.get(attributes): for each person, the five 0/1 values (steward, hostess, French, Spanish, German);
% Data.get(required_crew): for each flight, the crew size and the required numbers of stewards, hostesses,
% French, Spanish and German speakers (lists indexed from 1).
import cp.

model(Data, Vars, Outputs, Options) =>
    Attributes = Data.get(attributes),
    RequiredCrew = Data.get(required_crew),
    NumPeople = len(Attributes),           % the number of people
    NumFlights = len(RequiredCrew),        % the number of flights
    % Crew[F][P] = 1 when person P is assigned to flight F
    Crew = [new_list(NumPeople) : _F in 1..NumFlights],
    foreach (F in 1..NumFlights)
        Crew[F] :: 0..1
    end,
    % each flight has exactly the required number of cabin crew
    foreach (F in 1..NumFlights)
        sum(Crew[F]) #= RequiredCrew[F,1]
    end,
    % each flight has at least the required number of stewards, hostesses and speakers of each language
    foreach (F in 1..NumFlights, K in 2..6)
        sum([Attributes[P,K - 1] * Crew[F,P] : P in 1..NumPeople]) #>= RequiredCrew[F,K]
    end,
    % nobody attends more than one of any three consecutive flights
    foreach (F in 1..NumFlights - 2, P in 1..NumPeople)
        Crew[F,P] + Crew[F + 1,P] + Crew[F + 2,P] #=< 1
    end,
    Vars = Crew,
    Outputs = [crew = Crew],
    % any assignment that meets the requirements will do
    Options = [].

main([File]) =>
    Fd = open(File),
    Term = read_term(Fd),
    Term = $json_object(Keys, Values),
    close(Fd),
    Data = new_map([K = V : {K, V} in zip(Keys, Values)]),
    model(Data, Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
