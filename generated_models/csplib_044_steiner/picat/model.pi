% csplib_044_steiner: a Picat model from DCP Rosetta.
%
% The ternary Steiner problem of order n consists of finding a set of n * (n-1)/6 triples of distinct integer
% elements in {1, ..., n} such that any two triples have at most one common element. It is a hypergraph problem
% coming from combinatorial mathematics where n modulo 6 has to be equal to 1 or 3.
%
% Save this file as model.pi. Download `csplib_044_steiner.json` and `dcp_convert_picat.py` from the
% problem's page:
%   https://dcp-bench.github.io/DCP-Rosetta/problems/csplib_044_steiner.html
% Convert the instances once, then run the first one (Picat 3.9, https://picat-lang.org):
%   python dcp_convert_picat.py csplib_044_steiner.json
%   picat model.pi csplib_044_steiner_1.dat
%
% Data.get(n): the order n of the system; its elements are 1..n.
import sat.

model(Data, Vars, Outputs, Options) =>
    N = Data.get(n),
    NSets = N * (N - 1) // 6,          % the number of triples
    % Sets[I, J] = 1 when element J belongs to triple I
    Sets = new_array(NSets, N),
    Sets :: 0..1,
    % each triple holds exactly three distinct elements
    foreach (I in 1..NSets)
        sum([Sets[I, J] : J in 1..N]) #= 3
    end,
    % any two triples have at most one element in common
    foreach (I1 in 1..NSets - 1, I2 in I1 + 1..NSets)
        sum([Sets[I1, J] #/\ Sets[I2, J] : J in 1..N]) #=< 1
    end,
    Vars = Sets,
    Outputs = [sets = Sets],
    Options = [].

main([File]) =>
    Fd = open(File),
    Term = read_term(Fd),
    Term = $json_object(Keys, Values),
    close(Fd),
    Data = new_map([K = V : {K, V} in zip(Keys, Values)]),
    model(Data, Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
