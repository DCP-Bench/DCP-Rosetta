// frog_circle: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Cards numbered 1 to n are arranged in a circle. A frog jumps on card 1, then jumps to the card 1 place clockwise
// around the circle. Then, from card k, it jumps directly to the card k places clockwise around the circle. The frog
// continues jumping in this way forever. Find an arrangement of the cards that allows the frog to jump on every card,
// starting from card 1.
//
// Save this file as model.idp. Download `frog_circle.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/frog_circle.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py frog_circle.json
//   idp-engine model_1.idp
vocabulary V {
    type Range_n <: Int                // the positions around the circle, numbered 1 to n clockwise
    n: () -> Int                       // the number of cards
    x: Range_n -> Int                  // x(p): the card at position p, a number from 1 to n (declared output)
    nxt: Range_n -> Range_n            // nxt(p): the position reached by one jump from position p
    visit: Range_n -> Range_n          // visit(t): the position of the frog at step t, starting from card 1
}
theory T:V {
    // the cards are numbers from 1 to n
    ! p in Range_n: 1 =< x(p) & x(p) =< n().
    // each card is used once: different positions hold different cards
    ! p, q in Range_n: p ~= q => x(p) ~= x(q).
    // symmetry break: card 1 is placed at the first position (the canonical rotation)
    x(1) = 1.
    // the frog starts on card 1, that is, at the first position
    visit(1) = 1.
    // from the card at position p, the frog jumps as many places clockwise as the card number, wrapping round
    ! p in Range_n: nxt(p) = (p - 1 + x(p)) % n() + 1.
    // the frog's next position after step i is the jump from its position at step i
    ! i in Range_n: i < n() => visit(i + 1) = nxt(visit(i)).
    // the frog lands on every position, each once: it jumps on every card
    ! i, j in Range_n: i ~= j => visit(i) ~= visit(j).
}
procedure main() {
    pretty_print(model_expand(T, S, max=1, timeout_seconds=300))
}
