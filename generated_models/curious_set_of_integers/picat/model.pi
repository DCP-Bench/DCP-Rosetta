% curious_set_of_integers: a Picat model from DCP Rosetta.
%
% The integers 1, 3, 8 and 120 form a set with a remarkable property: the product of any two of them is one
% less than a perfect square. Find a fifth number, larger than or equal to 0, that can be added to the set
% without destroying this property.
%
% Save this file as model.pi. Download `curious_set_of_integers.json` and `dcp_convert_picat.py` from the
% problem's page:
%   https://dcp-bench.github.io/DCP-Rosetta/problems/curious_set_of_integers.html
% Convert the instances once, then run the first one (Picat 3.9, https://picat-lang.org):
%   python dcp_convert_picat.py curious_set_of_integers.json
%   picat model.pi curious_set_of_integers_1.dat

% Data.get(max_val): the largest number to try for the fifth number. The model reads no other field.
import cp.

model(Data, Vars, Outputs, Options) =>
    MaxVal = Data.get(max_val),
    Set = [1, 3, 8, 120],                 % the four integers already in the set
    X :: 0..MaxVal,                       % the fifth number
    Hi = to_int(sqrt(max(Set) * MaxVal + 1)) + 1,   % a bound on each square root
    Roots = new_list(len(Set)),
    foreach (I in 1..len(Set))
        Roots[I] :: 0..Hi,
        % the product of the fifth number and the I-th integer of the set is one less than a square
        Roots[I] * Roots[I] #= Set[I] * X + 1
    end,
    Vars = [X | Roots],
    Outputs = [number = X],
    Options = [].                         % satisfaction: no objective

main([File]) =>
    Fd = open(File),
    Term = read_term(Fd),
    Term = $json_object(Keys, Values),
    close(Fd),
    Data = new_map([K = V : {K, V} in zip(Keys, Values)]),
    model(Data, Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
