// curious_set_of_integers: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// The integers 1, 3, 8 and 120 form a set with a remarkable property: the product of any two integers is one less
// than a perfect square. Find a fifth number (larger than or equal to 0) that can be added to the set without
// destroying this property.
//
// Save this file as model.idp. Download `curious_set_of_integers.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/curious_set_of_integers.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py curious_set_of_integers.json
//   idp-engine model_1.idp
vocabulary V {
    max_val: () -> Int                 // the largest number allowed for the fifth number
    number: () -> Int                  // the fifth number (declared output)
    r1: () -> Int                      // the square root of 1 * number + 1
    r3: () -> Int                      // the square root of 3 * number + 1
    r8: () -> Int                      // the square root of 8 * number + 1
    r120: () -> Int                    // the square root of 120 * number + 1
}
theory T:V {
    // the fifth number is between 0 and max_val
    0 =< number() & number() =< max_val().
    // the square roots are bounded, which keeps the search finite
    0 =< r1() & r1() =< max_val() + 1.
    0 =< r3() & r3() =< 3 * max_val() + 1.
    0 =< r8() & r8() =< 8 * max_val() + 1.
    0 =< r120() & r120() =< 120 * max_val() + 1.
    // the products of the number with 1, 3, 8 and 120 are each one less than a perfect square
    number() * 1 + 1 = r1() * r1().
    number() * 3 + 1 = r3() * r3().
    number() * 8 + 1 = r8() * r8().
    number() * 120 + 1 = r120() * r120().
}
procedure main() {
    pretty_print(model_expand(T, S, max=1, timeout_seconds=300))
}
