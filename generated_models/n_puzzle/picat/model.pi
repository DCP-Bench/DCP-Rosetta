% n_puzzle: a Picat model from DCP Rosetta.
%
% The N-Puzzle is a sliding puzzle: a square board holds the tiles 1 to N and one empty square,
% marked 0. Trace the steps from the start board to the end board, in exactly N_STEPS boards, the
% start board and the end board included. Each step moves one tile that is horizontally or
% vertically next to the empty square into the empty square, so the board changes at every step.
%
% Save this file as model.pi. Download `n_puzzle.json` and `dcp_convert_picat.py` from the
% problem's page:
%   https://dcp-bench.github.io/DCP-Rosetta/problems/n_puzzle.html
% Convert the instances once, then run the first one (Picat 3.9, https://picat-lang.org):
%   python dcp_convert_picat.py n_puzzle.json
%   picat model.pi n_puzzle_1.dat
%
% Data.get('N_STEPS'): the number of boards, the start and the end board included;
% Data.get(puzzle_start), Data.get(puzzle_end): the start and the end board, each a 3 x 3 list of
% rows (lists indexed from 1), 0 being the empty square.
import sat.

model(Data, Vars, Outputs, Options) =>
    NSteps = Data.get('N_STEPS'),
    Start = Data.get(puzzle_start),
    End = Data.get(puzzle_end),
    D = len(Start),                       % the board is D x D
    N = D * D - 1,                        % the tiles are 1..N, 0 is the empty square
    % X[T, I, J] = the tile in row I, column J of board T (0 = empty)
    X = new_array(NSteps, D, D),
    X :: 0..N,
    % the first board is the start board and the last board is the end board
    foreach (I in 1..D, J in 1..D)
        X[1, I, J] #= Start[I, J],
        X[NSteps, I, J] #= End[I, J]
    end,
    % every board holds each tile and the empty square exactly once
    foreach (T in 1..NSteps)
        Cells = [X[T, I, J] : I in 1..D, J in 1..D],
        all_different(Cells)
    end,
    foreach (T in 2..NSteps)
        % the empty square of board T is the square that was empty on board T-1, or a square next
        % to it, since a single tile moves into the empty square
        foreach (I in 1..D, J in 1..D)
            Near = [X[T - 1, I + DR, J + DC] : {DR, DC} in [{0, 0}, {-1, 0}, {1, 0}, {0, -1}, {0, 1}],
                    I + DR >= 1, I + DR =< D, J + DC >= 1, J + DC =< D],
            X[T, I, J] #= 0 #=> (sum([V #= 0 : V in Near]) #>= 1),
            % a square that is not empty on either board keeps its tile
            X[T - 1, I, J] #= 0 #\/ X[T, I, J] #= 0 #\/ X[T - 1, I, J] #= X[T, I, J]
        end,
        % the board changes at every step
        sum([X[T - 1, I, J] #!= X[T, I, J] : I in 1..D, J in 1..D]) #>= 1
    end,
    Vars = [X[T, I, J] : T in 1..NSteps, I in 1..D, J in 1..D],
    Outputs = [steps = [[[X[T, I, J] : J in 1..D] : I in 1..D] : T in 1..NSteps]],
    Options = [].

main([File]) =>
    Fd = open(File),
    Term = read_term(Fd),
    Term = $json_object(Keys, Values),
    close(Fd),
    Data = new_map([K = V : {K, V} in zip(Keys, Values)]),
    model(Data, Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
