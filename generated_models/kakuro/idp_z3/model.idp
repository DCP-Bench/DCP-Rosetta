// kakuro: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// The object of the puzzle is to insert a digit from 1 to 9 inclusive into each white cell such that the sum of the
// numbers in each entry matches the clue associated with it and that no digit is duplicated in any entry. There is an
// unwritten rule for making Kakuro puzzles that each clue must have at least two numbers that add up to it.
//
// Save this file as model.idp. Download `kakuro.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/kakuro.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py kakuro.json
//   idp-engine model_1.idp
vocabulary V {
    n: () -> Int                       // the size of the grid: n rows and n columns
    type Range_n <: Int                // the rows and the columns of the grid, numbered from 1 to n
    type Digit := {1..9}               // the digits of the white cells
    type Seg <: Int                    // the entries (across and down), numbered from 0
    type Cell <: Int                   // the positions of the cells within an entry, numbered from 0
    type Blk <: Int                    // the black cells, numbered from 0
    type Coord <: Int                  // 0 for the row, 1 for the column of a cell
    blanks: Blk * Coord -> Int         // blanks(b, 0) and blanks(b, 1): the row and the column of black cell b
    problem_1: Seg -> Int              // problem_1(s): the clue, the sum of the digits of entry s (the conversion's piece of problem)
    problem_2: Seg * Cell * Coord -> Int  // problem_2(s, k, 0) and problem_2(s, k, 1): the row and the column of cell k of
                                          // entry s (the conversion's piece of problem, padded beyond the cells of the entry)
    problem_2_len: Seg -> Int          // problem_2_len(s): the number of cells of entry s (created by the conversion)
    black: Range_n * Range_n -> Bool   // black(r, c): the cell (r, c) is a black cell
    inseg: Seg * Range_n * Range_n -> Bool  // inseg(s, r, c): the cell (r, c) belongs to entry s
    x: Range_n * Range_n -> Int        // x(r, c): the digit in cell (r, c) of the solution, 0 for a black cell
}
theory T:V {
    // a cell is black when it is one of the black cells
    { ! r in Range_n: ! c in Range_n: black(r, c) <- ? b in Blk: blanks(b, 0) = r & blanks(b, 1) = c. }
    // a cell belongs to an entry when it is one of the cells of the entry
    { ! s in Seg: ! r in Range_n: ! c in Range_n: inseg(s, r, c) <- ? k in Cell: k < problem_2_len(s) & problem_2(s, k, 0) = r & problem_2(s, k, 1) = c. }
    // a black cell holds 0 in the solution
    ! r in Range_n: ! c in Range_n: black(r, c) => x(r, c) = 0.
    // a white cell holds a digit from 1 to 9
    ! r in Range_n: ! c in Range_n: ~black(r, c) => 1 =< x(r, c) & x(r, c) =< 9.
    // the sum of the digits in each entry matches the clue of the entry
    ! s in Seg: sum{{ x(r, c) | r in Range_n, c in Range_n: inseg(s, r, c) }} = problem_1(s).
    // no digit is duplicated in an entry
    ! s in Seg: ! d in Digit: #{ r in Range_n, c in Range_n: inseg(s, r, c) & x(r, c) = d } =< 1.
}
procedure main() {
    pretty_print(model_expand(T, S, max=1))
}
