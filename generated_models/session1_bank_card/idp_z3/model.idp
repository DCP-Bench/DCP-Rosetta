// session1_bank_card: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// My bank card has a 4 digit pin, abcd. I use the following facts to help me remember it: no two digits are the same;
// the 2-digit number cd is 3 times the 2-digit number ab; the 2-digit number da is 2 times the 2-digit number bc.
// Find the PIN (a, b, c, d).
//
//   https://dcp-bench.github.io/DCP-Rosetta/problems/session1_bank_card.html
// Save this model as model.idp and run it (`pip install idp-engine`) with:
//   idp-engine model.idp
vocabulary V {
    a: () -> Int                       // the first digit of the PIN
    b: () -> Int                       // the second digit of the PIN
    c: () -> Int                       // the third digit of the PIN
    d: () -> Int                       // the fourth digit of the PIN
}
theory T:V {
    // each digit of the PIN is a single digit from 0 to 9
    0 =< a() & a() =< 9.
    0 =< b() & b() =< 9.
    0 =< c() & c() =< 9.
    0 =< d() & d() =< 9.
    // no two digits are the same
    a() ~= b() & a() ~= c() & a() ~= d() & b() ~= c() & b() ~= d() & c() ~= d().
    // the 2-digit number cd is 3 times the 2-digit number ab
    10 * c() + d() = 3 * (10 * a() + b()).
    // the 2-digit number da is 2 times the 2-digit number bc
    10 * d() + a() = 2 * (10 * b() + c()).
}
procedure main() {
    pretty_print(model_expand(T, max=1))
}
