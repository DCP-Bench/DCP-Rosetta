// csplib_067_quasigroup_completion: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// An order m quasigroup is a Latin square of size m: an m x m multiplication table in which each element from 1 to m
// occurs exactly once in every row and every column. Complete a partially filled quasigroup, given as `start`, in
// which 0 marks an empty cell.
//
// Save this file as model.idp. Download `csplib_067_quasigroup_completion.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/csplib_067_quasigroup_completion.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py csplib_067_quasigroup_completion.json
//   idp-engine model_1.idp
vocabulary V {
    N: () -> Int                       // the order m of the quasigroup
    type Range_N <: Int                // the elements 1..N
    type I <: Int                      // the row and column positions, numbered from 0
    start: I * I -> Int                // start(r, c): the given element of row r, column c, 0 if empty
    puzzle: I * I -> Range_N           // puzzle(r, c): the element of row r, column c of the completed quasigroup (declared output)
}
theory T:V {
    // every given element is kept in the completed quasigroup
    ! r in I, c in I: start(r, c) ~= 0 => puzzle(r, c) = start(r, c).

    // each row contains each element from 1 to N exactly once
    ! r in I, v in Range_N: #{ c in I: puzzle(r, c) = v } = 1.

    // each column contains each element from 1 to N exactly once
    ! c in I, v in Range_N: #{ r in I: puzzle(r, c) = v } = 1.
}
procedure main() {
    pretty_print(model_expand(T, S, max=1))
}
