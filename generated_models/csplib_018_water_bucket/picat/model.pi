% csplib_018_water_bucket: a Picat model from DCP Rosetta.
%
% You are given a bucket of water and two empty buckets, of capacities that the data gives. Divide
% the water into two by pouring water between buckets, so that the water ends up divided as the
% goal state says. A transfer pours water from one bucket into another until the first is empty or
% the second is full. Find the minimum number of transfers of water between buckets that reaches
% the goal.
%
% Save this file as model.pi. Download `csplib_018_water_bucket.json` and `dcp_convert_picat.py` from the
% problem's page:
%   https://dcp-bench.github.io/DCP-Rosetta/problems/csplib_018_water_bucket.html
% Convert the instances once, then run the first one (Picat 3.9, https://picat-lang.org):
%   python dcp_convert_picat.py csplib_018_water_bucket.json
%   picat model.pi csplib_018_water_bucket_1.dat
%
% Data.get(capacities): the capacity of each bucket; Data.get(initial_state): the water in each
% bucket at the start; Data.get(goal_state): the water wanted in each bucket; Data.get('MAX_STEPS'):
% the length of the sequence (padding included); Data.get('PADDING_VALUE'): the value of every bucket
% in a padding state. Lists are indexed from 1.
import cp.

model(Data, Vars, Outputs, Options) =>
    Capacities = Data.get(capacities),
    Initial = Data.get(initial_state),
    Goal = Data.get(goal_state),
    MaxSteps = Data.get('MAX_STEPS'),
    Pad = Data.get('PADDING_VALUE'),
    % pouring only moves water, so the total amount of water never changes
    Total = sum(Initial),
    PadState = [Pad, Pad, Pad],
    % every way of spreading the water over the three buckets within their capacities
    States = [[I, J, K] : I in 0..Capacities[1], J in 0..Capacities[2], K in 0..Capacities[3],
                          I + J + K == Total],
    % Moves lists each legal transfer as a 6-tuple (state before, state after): pour from bucket A
    % into bucket B, moving as much as the source holds or the target accepts. A transfer starting
    % at the goal is left out, since the goal ends the sequence; after the goal only padding
    % follows, and after padding only padding.
    Moves = [to_array(Cur ++ pour(Cur, Capacities, A, B))
             : Cur in States, Cur != Goal, A in 1..3, B in 1..3, A != B,
               min(Cur[A], Capacities[B] - Cur[B]) > 0]
            ++ [to_array(Goal ++ PadState), to_array(PadState ++ PadState)],
    % S[T, B] = the water in bucket B after T - 1 transfers (or the padding value after the goal)
    S = new_array(MaxSteps, 3),
    S :: Pad..max(Capacities),
    % the sequence starts in the initial state
    foreach (B in 1..3)
        S[1, B] #= Initial[B]
    end,
    % each step is a legal transfer, or the goal followed by padding, or padding
    foreach (T in 1..MaxSteps - 1)
        table_in(to_array([S[T, B] : B in 1..3] ++ [S[T + 1, B] : B in 1..3]), Moves)
    end,
    % the goal is reached: the last state is the goal or padding
    table_in(to_array([S[MaxSteps, B] : B in 1..3]), [to_array(Goal), to_array(PadState)]),
    % the number of transfers is the number of real states (not padding) minus the initial one
    Cost #= sum([S[T, 1] #!= Pad : T in 1..MaxSteps]) - 1,
    Vars = [S, Cost],
    Outputs = [cost = Cost, sequence = S],
    % minimise the number of transfers
    Options = [$min(Cost)].

% pour(Cur, Capacities, A, B) = the state after pouring from bucket A into bucket B in state Cur.
pour(Cur, Capacities, A, B) = Next =>
    Amount = min(Cur[A], Capacities[B] - Cur[B]),
    Next = [cond_amount(C, A, B, Cur[C], Amount) : C in 1..3].

% the new content of bucket C: bucket A loses Amount, bucket B gains it, the third is unchanged
cond_amount(C, A, B, Old, Amount) = New =>
    if C == A then
        New = Old - Amount
    elseif C == B then
        New = Old + Amount
    else
        New = Old
    end.

main([File]) =>
    Fd = open(File),
    Term = read_term(Fd),
    Term = $json_object(Keys, Values),
    close(Fd),
    Data = new_map([K = V : {K, V} in zip(Keys, Values)]),
    model(Data, Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
