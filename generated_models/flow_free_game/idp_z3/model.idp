// flow_free_game: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Flow Free: connect the matching colours with pipes to create a flow. Pair all the colours, and cover the entire
// board. The pipes break if they cross or overlap. The cells of the board are connected horizontally and vertically:
// a numbered cell has exactly one neighbour of its own colour, and a filled cell has exactly two. The colours are the
// integers from 1 to 5.
//
// Save this file as model.idp. Download `flow_free_game.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/flow_free_game.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py flow_free_game.json
//   idp-engine model_1.idp
vocabulary V {
    type R <: Int                      // the rows of the board, numbered from 0
    type C <: Int                      // the columns of the board, numbered from 0
    board: R * C -> Int                // board(r, c): the given colour of cell (r, c), 0 when the cell is empty
    B: R * C -> Int                    // B(r, c): the colour of cell (r, c) in the solution, from 1 to 5
}
theory T:V {
    // every cell has a colour from 1 to 5
    ! r in R: ! c in C: 1 =< B(r, c) & B(r, c) =< 5.
    // a numbered cell keeps its given colour
    ! r in R: ! c in C: board(r, c) ~= 0 => B(r, c) = board(r, c).
    // a numbered cell has exactly one neighbour of its own colour
    ! r in R: ! c in C: board(r, c) ~= 0 => #{ r2 in R, c2 in C: abs(r - r2) + abs(c - c2) = 1 & B(r2, c2) = B(r, c) } = 1.
    // a filled cell has exactly two neighbours of its own colour
    ! r in R: ! c in C: board(r, c) = 0 => #{ r2 in R, c2 in C: abs(r - r2) + abs(c - c2) = 1 & B(r2, c2) = B(r, c) } = 2.
}
procedure main() {
    pretty_print(model_expand(T, S, max=1))
}
