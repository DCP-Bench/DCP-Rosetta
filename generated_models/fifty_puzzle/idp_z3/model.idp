// fifty_puzzle: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// A side show has a number of little dummies, each with a number on it, which are to be knocked over with baseballs. Any
// number of throws may be taken. When the numbers on the dummies knocked down add up to exactly a given target sum,
// neither more nor less, a genuine prize is won. Choose the dummies to knock over so that their numbers sum to exactly
// the target sum.
//
// Save this file as model.idp. Download `fifty_puzzle.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/fifty_puzzle.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py fifty_puzzle.json
//   idp-engine model_1.idp

vocabulary V {
    type D <: Int                      // the dummies, numbered from 0, sized from values
    target_sum: () -> Int              // the target sum the numbers knocked down must add up to
    values: D -> Int                   // values(d): the number on dummy d
    dummies: D -> Bool                 // dummies(d): dummy d is knocked over
}

theory T:V {
    // the numbers on the dummies knocked over add up to exactly the target sum
    sum{{ values(d) | d in D: dummies(d) }} = target_sum().
}

procedure main() {
    pretty_print(model_expand(T, S, max=1))
}
