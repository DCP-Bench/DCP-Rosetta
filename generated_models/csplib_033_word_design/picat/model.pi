% csplib_033_word_design: a Picat model from DCP Rosetta.
%
% Find a set S of num_words strings (words) of length n over the alphabet {A, C, G, T} with the following
% properties: each word in S has 4 symbols from {C, G}; each pair of distinct words in S differ in at least
% 4 positions; and each pair of words x and y in S (where x and y may be identical) are such that the reverse
% x^R and the Watson-Crick complement y^C differ in at least 4 positions. The reverse of (x_1, ..., x_n) is
% (x_n, ..., x_1), and the complement replaces each A by a T and vice versa, and each C by a G and vice versa.
%
% Save this file as model.pi. Download `csplib_033_word_design.json` and `dcp_convert_picat.py` from the
% problem's page:
%   https://dcp-bench.github.io/DCP-Rosetta/problems/csplib_033_word_design.html
% Convert the instances once, then run the first one (Picat 3.9, https://picat-lang.org):
%   python dcp_convert_picat.py csplib_033_word_design.json
%   picat model.pi csplib_033_word_design_1.dat
%
% Data.get(n): the length of each word; Data.get(num_words): the number of words in S.
import cp.

model(Data, Vars, Outputs, Options) =>
    N = Data.get(n),
    NumWords = Data.get(num_words),
    % Words[I, J] = the J-th letter of word I, coded 1 = A, 2 = C, 3 = G, 4 = T
    Words = new_array(NumWords, N),
    Words :: 1..4,
    % each word has exactly 4 symbols from {C, G}
    foreach (I in 1..NumWords)
        sum([(Words[I, J] #= 2) #\/ (Words[I, J] #= 3) : J in 1..N]) #= 4
    end,
    % each pair of distinct words differs in at least 4 positions
    foreach (I1 in 1..NumWords - 1, I2 in I1 + 1..NumWords)
        sum([Words[I1, J] #!= Words[I2, J] : J in 1..N]) #>= 4
    end,
    % the reverse of any word x and the Watson-Crick complement of any word y differ in at least 4
    % positions; the complement of the letter v is 5 - v (A <-> T, C <-> G), and x and y may be the same
    foreach (X in 1..NumWords, Y in 1..NumWords)
        sum([Words[X, N + 1 - J] #!= 5 - Words[Y, J] : J in 1..N]) #>= 4
    end,
    Vars = Words,
    Outputs = [words = Words],
    Options = [ff].

main([File]) =>
    Fd = open(File),
    Term = read_term(Fd),
    Term = $json_object(Keys, Values),
    close(Fd),
    Data = new_map([K = V : {K, V} in zip(Keys, Values)]),
    model(Data, Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
