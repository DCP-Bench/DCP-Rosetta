// csplib_028_bibd: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Balanced Incomplete Block Design (BIBD): arrange v distinct objects into b blocks such that each block contains
// exactly k distinct objects, each object occurs in exactly r different blocks, and every two distinct objects occur
// together in exactly lambda blocks. Equivalently, a v by b binary incidence matrix has exactly r ones per row, k ones
// per column, and a scalar product of lambda between any two distinct rows.
//
// Save this file as model.idp. Download `csplib_028_bibd.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/csplib_028_bibd.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py csplib_028_bibd.json
//   idp-engine model_1.idp
vocabulary V {
    type Range_v <: Int                // the objects, numbered 1..v
    type Range_b <: Int                // the blocks, numbered 1..b
    v: () -> Int                       // the number of objects
    b: () -> Int                       // the number of blocks
    r: () -> Int                       // the number of blocks each object occurs in
    k: () -> Int                       // the number of objects in each block
    l: () -> Int                       // the number of blocks in which every two distinct objects occur together
    matrix: Range_v * Range_b -> Bool  // matrix(o, blk): object o occurs in block blk
}
theory T:V {
    // each object occurs in exactly r different blocks
    ! o in Range_v: #{ blk in Range_b: matrix(o, blk) } = r().

    // each block contains exactly k distinct objects
    ! blk in Range_b: #{ o in Range_v: matrix(o, blk) } = k().

    // every two distinct objects occur together in exactly lambda blocks
    ! o1, o2 in Range_v: o1 ~= o2 => #{ blk in Range_b: matrix(o1, blk) & matrix(o2, blk) } = l().
}
procedure main() {
    pretty_print(model_expand(T, S, max=1))
}
