// bananas: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Five bananas cost three dollars, seven oranges cost five dollars, nine mangoes cost seven dollars, and three apples
// cost nine dollars. Buy 100 fruits for 100 dollars, buying at least one of each kind of fruit, so that the number of
// bananas and apples together is as small as possible.
//
//   https://dcp-bench.github.io/DCP-Rosetta/problems/bananas.html
// Save this model as model.idp and run it (`pip install idp-engine`) with:
//   idp-engine model.idp

vocabulary V {
    bananas: () -> Int                 // the number of bananas bought
    oranges: () -> Int                 // the number of oranges bought
    mangoes: () -> Int                 // the number of mangoes bought
    apples: () -> Int                  // the number of apples bought
    minimize: () -> Int                // the number of bananas and apples together
}

theory T:V {
    // every kind of fruit is bought at least once
    1 =< bananas() & 1 =< oranges() & 1 =< mangoes() & 1 =< apples().
    // 100 fruits are bought in all
    bananas() + oranges() + mangoes() + apples() = 100.
    // the fruits cost 100 dollars in all; the prices are multiplied by 315 to keep the numbers whole:
    // a banana costs 3/5 dollar (189), an orange 5/7 dollar (225), a mango 7/9 dollar (245), an apple 3 dollars (945)
    189 * bananas() + 225 * oranges() + 245 * mangoes() + 945 * apples() = 31500.
    // the number of bananas and apples together is to be as small as possible
    minimize() = bananas() + apples().
}

procedure main() {
    pretty_print(minimize(T, term="minimize()"))
}
