% initials_queue: a Picat model from DCP Rosetta.
%
% The first 10 people in the queue for a maths lecture each have initials that are an alphabetically ordered
% pair of distinct letters from the first five letters of the alphabet, A to E. No two people have the same
% initials, and no one shares a letter with the person in front of them. The mathematician with initials BE is
% at the front of the queue, CD is right behind, and BD is at the end of the queue.
%
%   https://dcp-bench.github.io/DCP-Rosetta/problems/initials_queue.html
% Save this model as model.pi and run it (Picat 3.9, https://picat-lang.org) with:
%   picat model.pi
import cp.

% The puzzle reads no data: the queue length and the given initials are fixed in the model.
model(_Data, Vars, Outputs, Options) =>
    N = 10,                                   % the number of people in the queue
    % Queue[I, 1] and Queue[I, 2] are the two letters of person I, with A to E coded 0 to 4
    Queue = new_array(N, 2),
    Queue :: 0..4,
    % the two letters of each person are alphabetically ordered and distinct
    foreach (I in 1..N)
        Queue[I, 1] #< Queue[I, 2]
    end,
    % no two people have the same initials
    foreach (I in 1..N-1, J in I+1..N)
        Queue[I, 1] #!= Queue[J, 1] #\/ Queue[I, 2] #!= Queue[J, 2]
    end,
    % no one shares a letter with the person in front of them
    foreach (I in 1..N-1, K in 1..2, L in 1..2)
        Queue[I, K] #!= Queue[I + 1, L]
    end,
    % the person at the front has initials BE (B = 1, E = 4)
    Queue[1, 1] #= 1, Queue[1, 2] #= 4,
    % the person right behind has initials CD (C = 2, D = 3)
    Queue[2, 1] #= 2, Queue[2, 2] #= 3,
    % the person at the end of the queue has initials BD
    Queue[N, 1] #= 1, Queue[N, 2] #= 3,
    Vars = Queue,
    Outputs = [queue = Queue],
    Options = [].

main =>
    model(new_map(), Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
