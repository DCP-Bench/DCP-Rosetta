// initials_queue: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// I noticed something weird about names of the first 10 people in the queue for a Maths lecture. Each of them had
// initials which were an alphabetically ordered pair of distinct letters from the first five letters of the alphabet
// (A,B,C,D,E)! None of the people had the same initials as any other and no-one shared a letter with the person in front
// of them. Mathematician BE was at the front of the queue with CD right behind, while BD was right at the end of the
// queue. Can you use this information to work out the initials of the ten people in the queue, starting from the front?
//
//   https://dcp-bench.github.io/DCP-Rosetta/problems/initials_queue.html
// Save this model as model.idp and run it (`pip install idp-engine`) with:
//   idp-engine model.idp
vocabulary V {
    type Pos := {0..9}                 // the positions in the queue, numbered from 0 at the front
    type Idx := {0..1}                 // the two letters of the initials, first then second
    queue: Pos * Idx -> Int            // queue(p, i): the letter in position i of the initials of the person at position p,
                                       // 0 to 4 for A to E
}
theory T:V {
    // the letters are among A to E, that is, 0 to 4
    ! p in Pos: ! i in Idx: 0 =< queue(p, i) & queue(p, i) =< 4.
    // each person's initials are an alphabetically ordered pair of distinct letters
    ! p in Pos: queue(p, 0) < queue(p, 1).
    // no two people have the same initials
    ! p in Pos: ! q in Pos: p ~= q => ~(queue(p, 0) = queue(q, 0) & queue(p, 1) = queue(q, 1)).
    // Mathematician BE (letters 1 and 4) is at the front of the queue
    queue(0, 0) = 1 & queue(0, 1) = 4.
    // CD (letters 2 and 3) is right behind him
    queue(1, 0) = 2 & queue(1, 1) = 3.
    // BD (letters 1 and 3) is right at the end of the queue
    queue(9, 0) = 1 & queue(9, 1) = 3.
    // no-one shares a letter with the person in front of them
    ! p in Pos: ! q in Pos: q = p + 1 => ~(queue(p, 0) = queue(q, 0) | queue(p, 0) = queue(q, 1) | queue(p, 1) = queue(q, 0) | queue(p, 1) = queue(q, 1)).
}
procedure main() {
    pretty_print(model_expand(T, max=1))
}
