// tsp: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// The travelling salesman problem asks the following question: "Given a list of cities and the distances between
// each pair of cities (or the locations of the cities), what is the shortest possible route that visits each city
// exactly once and returns to the origin city?" The distance is defined as the Euclidean distance between the points
// rounded to an integer.
//
// Save this file as model.idp. Download `tsp.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/tsp.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py tsp.json
//   idp-engine model_1.idp

vocabulary V {
    type City <: Int                   // the cities, numbered from 0
    type Coord <: Int                  // the two coordinates of a city, x is 0 and y is 1
    locations: City * Coord -> Int     // locations(c, k): coordinate k of city c
    sq: City * City -> Int             // sq(c, d): the squared Euclidean distance between cities c and d
    dist: City * City -> Int           // dist(c, d): the distance between cities c and d rounded to an integer
    succ: City * City -> Bool          // succ(c, d): the route goes directly from city c to city d
    pos: City -> City                  // pos(c): the position of city c on the route, city 0 being at position 0
    travel_distance: () -> Int         // the length of the route
    minimize: () -> Int                // the length of the route, to be minimised
}

theory T:V {
    {
        // the squared distance between two cities is the sum of the squares of the differences of their coordinates
        ! c in City, d in City: sq(c, d) = (locations(c, 0) - locations(d, 0)) * (locations(c, 0) - locations(d, 0))
                                          + (locations(c, 1) - locations(d, 1)) * (locations(c, 1) - locations(d, 1)).
    }

    // the distance between two cities is the Euclidean distance rounded to the nearest integer r, that is
    // r * r - r < the squared distance <= r * r + r, and 0 when the cities are at the same place
    ! c in City, d in City: sq(c, d) = 0 => dist(c, d) = 0.
    ! c in City, d in City: sq(c, d) > 0 => dist(c, d) * dist(c, d) - dist(c, d) < sq(c, d) & sq(c, d) =< dist(c, d) * dist(c, d) + dist(c, d).

    // the route leaves each city for exactly one other city
    ! c in City: #{ d in City: succ(c, d) } = 1.
    // the route enters each city from exactly one other city
    ! d in City: #{ c in City: succ(c, d) } = 1.
    // no city is followed by itself
    ! c in City: ~succ(c, c).

    // every city has its own position on the route
    ! c in City, d in City: pos(c) = pos(d) => c = d.
    // the route starts at city 0, which is at position 0
    pos(0) = 0.
    // the route goes from each city to the next position, except that it returns to city 0 from the last city
    ! c in City, d in City: succ(c, d) & d ~= 0 => pos(d) = pos(c) + 1.

    // the length of the route is the sum of the distances of the legs taken
    travel_distance() = sum{{ dist(c, d) | c in City, d in City: succ(c, d) }}.
    // the length of the route is minimised
    minimize() = travel_distance().
}

procedure main() {
    pretty_print(minimize(T, S, term="minimize()"))
}
