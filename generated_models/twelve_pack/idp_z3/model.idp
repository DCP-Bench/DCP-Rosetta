// twelve_pack: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Given a target number of items, find the combination of packs of different sizes whose total number of items is at
// least the target and as close to it as possible.
//
// Save this file as model.idp. Download `twelve_pack.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/twelve_pack.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py twelve_pack.json
//   idp-engine model_1.idp
vocabulary V {
    type Size <: Int                   // the pack sizes, numbered from 0, sized from packs
    target: () -> Int                  // the target number of items
    packs: Size -> Int                 // packs(p): the number of items in a pack of size p
    counts: Size -> Int                // counts(p): the number of packs of size p bought (declared output)
    minimize: () -> Int                // the total number of items bought, to be as small as possible
}
theory T:V {
    // the number of packs of each size is a whole number, not negative
    ! p in Size: counts(p) >= 0.

    // the total number of items is at least the target
    sum{{ (counts(p) * packs(p)) | p in Size }} >= target().

    // the total number of items bought is the value to minimize: the closest total at or above the target
    minimize() = sum{{ (counts(p) * packs(p)) | p in Size }}.
}
procedure main() {
    pretty_print(minimize(T, S, term="minimize()"))
}
