// appointment_scheduling: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Schedule 4 people into 4 interview slots based on their free-busy schedules, where m[i][j] is 1 if person i is free in
// slot j. Each person gets exactly one slot in which they are free, and each slot goes to exactly one person.
//
// Save this file as model.idp. Download `appointment_scheduling.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/appointment_scheduling.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py appointment_scheduling.json
//   idp-engine model_1.idp
vocabulary V {
    type Person <: Int                 // the people, numbered from 0
    type Slot <: Int                   // the interview slots, numbered from 0
    m: Person * Slot -> Int            // m(i, j) is 1 if person i is free in slot j, and 0 otherwise
    x: Person * Slot -> Bool           // x(i, j): person i is assigned to slot j
}
theory T:V {
    // a person is assigned only to a slot in which they are free
    ! i in Person, j in Slot: x(i, j) => m(i, j) = 1.
    // each person is assigned exactly one slot
    ! i in Person: #{ j in Slot: x(i, j) } = 1.
    // each slot is assigned exactly one person
    ! j in Slot: #{ i in Person: x(i, j) } = 1.
}
procedure main() {
    pretty_print(model_expand(T, S, max=1))
}
