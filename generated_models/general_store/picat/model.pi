% general_store: a Picat model from DCP Rosetta.
%
% The owner of a general store, who is something of a puzzlist, has put up this sign to see if any of
% his mathematical friends can translate it properly. Each different letter stands for a different digit.
% The words above the horizontal line represent numbers that add to the total of 'ALL WOOL'. The problem
% is to change all the letters to the correct digits. The sum is:
%
%   CHESS + CASH + BOWWOW + CHOPS + ALSOPS + PALEALE + COOL + BASS + HOPS + ALES + HOES + APPLES + COWS
%   + CHEESE + CHSOAP + SHEEP = ALLWOOL
%
% Leading zeros are allowed: a word may start with the digit 0.
%
%   https://dcp-bench.github.io/DCP-Rosetta/problems/general_store.html
% Save this model as model.pi and run it (Picat 3.9, https://picat-lang.org) with:
%   picat model.pi
%
% The model reads no data: the letters are the decision variables, each a digit from 0 to 9.
import cp.

model(_Data, Vars, Outputs, Options) =>
    % one digit variable per letter
    Letters = [C, H, E, S, A, B, O, W, P, L],
    Letters :: 0..9,
    % each different letter stands for a different digit
    all_different(Letters),
    Val = new_map([c = C, h = H, e = E, s = S, a = A, b = B, o = O, w = W, p = P, l = L]),
    Addends = [[c,h,e,s,s], [c,a,s,h], [b,o,w,w,o,w], [c,h,o,p,s], [a,l,s,o,p,s], [p,a,l,e,a,l,e],
               [c,o,o,l], [b,a,s,s], [h,o,p,s], [a,l,e,s], [h,o,e,s], [a,p,p,l,e,s], [c,o,w,s],
               [c,h,e,e,s,e], [c,h,s,o,a,p], [s,h,e,e,p]],
    SumWord = [a,l,l,w,o,o,l],
    NA = len(Addends),
    % AddVal[I] = the number that the I-th word stands for
    AddVal = new_list(NA),
    foreach (I in 1..NA)
        wordvalue(Addends[I], Val, AddVal[I])
    end,
    wordvalue(SumWord, Val, SumVal),
    % the words above the line add up to the word below it
    sum(AddVal) #= SumVal,
    Vars = Letters,
    Outputs = ['A' = A, 'B' = B, 'C' = C, 'E' = E, 'H' = H, 'L' = L, 'O' = O, 'P' = P, 'S' = S, 'W' = W],
    Options = [].

% Word is a list of letters, Val maps each letter to its digit; the number of the word, with its
% first letter the most significant digit, is E
wordvalue(Word, Val, E) =>
    N = len(Word),
    E #= sum([Val.get(Word[I]) * 10 ** (N - I) : I in 1..N]).

main =>
    model(new_map(), Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
