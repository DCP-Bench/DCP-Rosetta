% zebra: a Picat model from DCP Rosetta.
%
% The Zebra puzzle (Einstein's puzzle): five houses in a row, numbered from left to right, each painted
% a different colour and with one inhabitant. The inhabitants are of different nationalities, own
% different pets, drink different beverages and have different jobs. Colours: yellow, green, red,
% white, blue. Nations: Italy, Spain, Japan, England, Norway. Pets: cat, zebra, bear, snails, horse.
% Drinks: milk, water, tea, coffee, juice. Jobs: painter, sculptor, diplomat, pianist, doctor.
% Clues: the painter owns the horse; the diplomat drinks coffee; the one who drinks milk lives in the
% white house; the Spaniard is a painter; the Englishman lives in the red house; the snails are owned
% by the sculptor; the green house is immediately on the left of the red one; the Norwegian lives
% immediately on the right of the blue house; the doctor drinks milk; the diplomat is Japanese; the
% Norwegian owns the zebra; the green house is next to the white one; the horse is owned by the
% neighbour of the diplomat; the Italian lives in the red, white or green house.
%
%
%   https://dcp-bench.github.io/DCP-Rosetta/problems/zebra.html
% Save this model as model.pi and run it (Picat 3.9, https://picat-lang.org) with:
%   picat model.pi
import cp.

model(_Data, Vars, Outputs, Options) =>
    % each variable is the house, numbered 0 to 4, of that colour, nation, job, pet or drink
    Colors = [Yellow, Green, Red, White, Blue],
    Nations = [Italy, Spain, Japan, England, Norway],
    Jobs = [Painter, Sculptor, Diplomat, Pianist, Doctor],
    Pets = [Cat, Zebra, Bear, Snails, Horse],
    Drinks = [Milk, Water, Tea, Coffee, Juice],
    Groups = [Colors, Nations, Jobs, Pets, Drinks],
    % each group takes the five houses, each house once
    foreach (Group in Groups)
        Group :: 0..4,
        all_distinct(Group)
    end,
    Painter #= Horse,                      % the painter owns the horse
    Diplomat #= Coffee,                    % the diplomat drinks coffee
    White #= Milk,                         % the one who drinks milk lives in the white house
    Spain #= Painter,                      % the Spaniard is a painter
    England #= Red,                        % the Englishman lives in the red house
    Snails #= Sculptor,                    % the snails are owned by the sculptor
    Green + 1 #= Red,                      % the green house is immediately on the left of the red one
    Norway #= Blue + 1,                    % the Norwegian lives immediately on the right of the blue house
    Doctor #= Milk,                        % the doctor drinks milk
    Japan #= Diplomat,                     % the diplomat is Japanese
    Norway #= Zebra,                       % the Norwegian owns the zebra
    abs(Green - White) #= 1,               % the green house is next to the white one
    abs(Horse - Diplomat) #= 1,            % the horse is owned by the neighbour of the diplomat
    % the Italian lives in the red, the white or the green house
    Italy #= Red #\/ Italy #= White #\/ Italy #= Green,
    Vars = Colors ++ Nations ++ Jobs ++ Pets ++ Drinks,
    Outputs = [colors = Colors, nations = Nations, jobs = Jobs, pets = Pets, drinks = Drinks],
    Options = [].

main =>
    model(new_map(), Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
