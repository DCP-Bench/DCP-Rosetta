// zebra: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// The Zebra puzzle (sometimes referred to as Einstein's puzzle) is defined as follows. There are five houses in a row,
// numbered from left to right. Each of the five houses is painted a different color, and has one inhabitant. The
// inhabitants are all of different nationalities, own different pets, drink different beverages and have different jobs.
// We know that:
//  - colors are yellow, green, red, white, and blue
//  - nations of inhabitants are italy, spain, japan, england, and norway
//  - pets are cat, zebra, bear, snails, and horse
//  - drinks are milk, water, tea, coffee, and juice
//  - jobs are painter, sculptor, diplomat, pianist, and doctor
//  - the painter owns the horse
//  - the diplomat drinks coffee
//  - the one who drinks milk lives in the white house
//  - the Spaniard is a painter
//  - the Englishman lives in the red house
//  - the snails are owned by the sculptor
//  - the green house is immediately on the left of the red one
//  - the Norwegian lives immediately on the right of the blue house
//  - the doctor drinks milk
//  - the diplomat is Japanese
//  - the Norwegian owns the zebra
//  - the green house is next to the white one
//  - the horse is owned by the neighbor of the diplomat
//  - the Italian either lives in the red, white or green house
//
//   https://dcp-bench.github.io/DCP-Rosetta/problems/zebra.html
// Save this model as model.idp and run it (`pip install idp-engine`) with:
//   idp-engine model.idp
vocabulary V {
    type House := {0..4}               // the five houses, numbered from 0 (left) to 4 (right)
    type Color := {0..4}               // the colors, numbered from 0: 0 yellow, 1 green, 2 red, 3 white, 4 blue
    type Nation := {0..4}              // the nations, numbered from 0: 0 italy, 1 spain, 2 japan, 3 england, 4 norway
    type Pet := {0..4}                 // the pets, numbered from 0: 0 cat, 1 zebra, 2 bear, 3 snails, 4 horse
    type Drink := {0..4}               // the drinks, numbered from 0: 0 milk, 1 water, 2 tea, 3 coffee, 4 juice
    type Job := {0..4}                 // the jobs, numbered from 0: 0 painter, 1 sculptor, 2 diplomat, 3 pianist, 4 doctor
    colors: Color -> House             // colors(c): the house painted in color c (declared output)
    nations: Nation -> House           // nations(n): the house of the inhabitant of nation n (declared output)
    pets: Pet -> House                 // pets(p): the house of the pet p (declared output)
    drinks: Drink -> House             // drinks(d): the house of the inhabitant who drinks d (declared output)
    jobs: Job -> House                 // jobs(j): the house of the inhabitant with job j (declared output)
}
theory T:V {
    // each color is painted in a different house, and each house has one color
    ! c, d in Color: c ~= d => colors(c) ~= colors(d).

    // each nation is of a different house
    ! n, m in Nation: n ~= m => nations(n) ~= nations(m).

    // each pet is owned in a different house
    ! p, q in Pet: p ~= q => pets(p) ~= pets(q).

    // each drink is drunk in a different house
    ! d, e in Drink: d ~= e => drinks(d) ~= drinks(e).

    // each job is held in a different house
    ! j, k in Job: j ~= k => jobs(j) ~= jobs(k).

    // the painter owns the horse
    jobs(0) = pets(4).

    // the diplomat drinks coffee
    jobs(2) = drinks(3).

    // the one who drinks milk lives in the white house
    drinks(0) = colors(3).

    // the Spaniard is a painter
    nations(1) = jobs(0).

    // the Englishman lives in the red house
    nations(3) = colors(2).

    // the snails are owned by the sculptor
    pets(3) = jobs(1).

    // the green house is immediately on the left of the red one
    colors(1) + 1 = colors(2).

    // the Norwegian lives immediately on the right of the blue house
    nations(4) = colors(4) + 1.

    // the doctor drinks milk
    jobs(4) = drinks(0).

    // the diplomat is Japanese
    jobs(2) = nations(2).

    // the Norwegian owns the zebra
    nations(4) = pets(1).

    // the green house is next to the white one
    (colors(1) = colors(3) + 1) | (colors(3) = colors(1) + 1).

    // the horse is owned by the neighbor of the diplomat
    (pets(4) = jobs(2) + 1) | (jobs(2) = pets(4) + 1).

    // the Italian either lives in the red, white or green house
    nations(0) = colors(2) | nations(0) = colors(3) | nations(0) = colors(1).
}
procedure main() {
    pretty_print(model_expand(T, max=1))
}
