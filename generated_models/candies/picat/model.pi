% candies: a Picat model from DCP Rosetta.
%
% Alice gives candies to the children sitting in a line. Each child has a rating score. Every child
% gets at least 1 candy. If two children sit next to each other, the one with the higher rating gets
% more candies than the other. Alice wants to minimize the total number of candies.
%
% Save this file as model.pi. Download `candies.json` and `dcp_convert_picat.py` from the
% problem's page:
%   https://dcp-bench.github.io/DCP-Rosetta/problems/candies.html
% Convert the instances once, then run the first one (Picat 3.9, https://picat-lang.org):
%   python dcp_convert_picat.py candies.json
%   picat model.pi candies_1.dat
%
% Data.get(ratings): the rating score of each child (a list indexed from 1).
import cp.

model(Data, Vars, Outputs, Options) =>
    Ratings = Data.get(ratings),
    N = len(Ratings),                      % the number of children
    X = new_list(N),
    X :: 1..N,                             % X[I] = the number of candies given to child I
    Z :: N..N * N,                         % Z = the total number of candies
    Z #= sum(X),
    % every child gets at least one candy
    foreach (I in 1..N)
        X[I] #>= 1
    end,
    % a child with a higher rating than a neighbour gets more candies than that neighbour
    foreach (I in 2..N)
        if Ratings[I - 1] > Ratings[I] then
            X[I - 1] #> X[I]
        elseif Ratings[I - 1] < Ratings[I] then
            X[I - 1] #< X[I]
        end
    end,
    Vars = X,
    Outputs = [z = Z, x = X],
    % minimize the total number of candies
    Options = [$min(Z)].

main([File]) =>
    Fd = open(File),
    Term = read_term(Fd),
    Term = $json_object(Keys, Values),
    close(Fd),
    Data = new_map([K = V : {K, V} in zip(Keys, Values)]),
    model(Data, Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
