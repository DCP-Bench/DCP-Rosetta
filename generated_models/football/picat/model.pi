% football: a Picat model from DCP Rosetta.
%
% Statistics show that, in the Premiership, there is a strong correlation between the value of a team's
% players and their final position in that league, so you want to spend as much money as you can. The
% chairman gives you an upper limit of GBP 30 million, so you want your purchases to add up to as close
% to that figure as possible, without going over. You must buy exactly one goalkeeper, at least two
% defenders, at least three midfielders and at least two strikers, and at least eleven players in total.
%
%   https://dcp-bench.github.io/DCP-Rosetta/problems/football.html
% Save this model as model.pi and run it (Picat 3.9, https://picat-lang.org) with:
%   picat model.pi
%
% The model reads no data: the prices below are in GBP thousands.
import cp.

model(_Data, Vars, Outputs, Options) =>
    Goalkeepers = [730, 1280, 3880],
    Defenders = [920, 1310, 1620, 2410, 2790, 3280, 3910, 4570],
    Midfielders = [1800, 2630, 3170, 3769, 4140, 4750, 5380, 5930, 6780, 7130],
    Strikers = [4460, 6470, 7780, 8390, 9500],
    Prices = Goalkeepers ++ Defenders ++ Midfielders ++ Strikers,
    NG = len(Goalkeepers),                 % the number of goalkeepers
    ND = len(Defenders),
    NM = len(Midfielders),
    NS = len(Strikers),
    N = len(Prices),                       % the number of players on offer
    % Buy[P] = 1 when player P is bought
    Buy = new_list(N),
    Buy :: 0..1,
    % buy exactly one goalkeeper
    sum([Buy[P] : P in 1..NG]) #= 1,
    % buy two or more defenders
    sum([Buy[P] : P in NG+1..NG+ND]) #>= 2,
    % buy three or more midfielders
    sum([Buy[P] : P in NG+ND+1..NG+ND+NM]) #>= 3,
    % buy two or more strikers
    sum([Buy[P] : P in NG+ND+NM+1..N]) #>= 2,
    % buy at least eleven players in total
    sum(Buy) #>= 11,
    % Z = the total price of the players bought, at most GBP 30 million
    Z #= sum([Prices[P] * Buy[P] : P in 1..N]),
    Z #=< 30000,
    Vars = Buy,
    Outputs = [z = Z],
    % spend as much as possible
    Options = [$max(Z)].

main =>
    model(new_map(), Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
