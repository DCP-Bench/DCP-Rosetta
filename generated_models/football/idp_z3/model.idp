// football: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Statistics show that in the Premiership there is a strong correlation between the value of a team's players and their
// final position in the league, so the aim is to spend as much money as possible. The upper limit is GBP 30 million, so
// the purchases should add up to as close to that figure as possible without going over. The players are in groups, with
// their prices in GBP millions: goalkeepers (must buy exactly 1), defenders (must buy 2 or more), midfielders (must buy 3
// or more) and strikers (must buy 2 or more). In addition, at least eleven players must be bought in total.
//
//
//   https://dcp-bench.github.io/DCP-Rosetta/problems/football.html
// Save this model as model.idp and run it (`pip install idp-engine`) with:
//   idp-engine model.idp
vocabulary V {
    type Player <: Int                 // the players available, numbered from 0: goalkeepers, defenders, midfielders, strikers
    type Group <: Int                  // the position groups, numbered from 0: 0 goalkeepers, 1 defenders, 2 midfielders, 3 strikers
    price: Player -> Int               // price(p): price of player p in thousands of GBP (the price in GBP millions times 1000)
    group: Player -> Group             // group(p): the position group of player p
    minimum: Group -> Int              // minimum(g): the fewest players to buy in position group g
    budget: () -> Int                  // the upper limit on the total price, in thousands of GBP
    min_players: () -> Int             // the fewest players to buy in total
    bought: Player -> Bool             // bought(p): player p is bought
    z: () -> Int                       // the total price of the players bought, in thousands of GBP
    maximize: () -> Int                // the total price of the players bought, to maximize
}
theory T:V {
    // the total price of the players bought does not go over the budget
    sum{{ price(p) | p in Player: bought(p) }} =< budget().
    // at least the fewest number of players in total are bought
    min_players() =< #{ p in Player: bought(p) }.
    // each position group has at least its minimum number of players bought
    ! g in Group: minimum(g) =< #{ p in Player: bought(p) & group(p) = g }.
    // exactly one goalkeeper is bought
    #{ p in Player: bought(p) & group(p) = 0 } = 1.
    // the total price is the total price of the players bought
    z() = sum{{ price(p) | p in Player: bought(p) }}.
    // the total price is the value to maximize
    maximize() = z().
}
structure D:V {
    Player := {0..25}.
    Group := {0..3}.
    // goalkeepers g1 to g3, defenders d1 to d8, midfielders m1 to m10, strikers s1 to s5, prices in thousands of GBP
    price := { 0->730, 1->1280, 2->3880,
               3->920, 4->1310, 5->1620, 6->2410, 7->2790, 8->3280, 9->3910, 10->4570,
               11->1800, 12->2630, 13->3170, 14->3769, 15->4140, 16->4750, 17->5380, 18->5930, 19->6780, 20->7130,
               21->4460, 22->6470, 23->7780, 24->8390, 25->9500 }.
    group := { 0->0, 1->0, 2->0,
               3->1, 4->1, 5->1, 6->1, 7->1, 8->1, 9->1, 10->1,
               11->2, 12->2, 13->2, 14->2, 15->2, 16->2, 17->2, 18->2, 19->2, 20->2,
               21->3, 22->3, 23->3, 24->3, 25->3 }.
    minimum := { 0->1, 1->2, 2->3, 3->2 }.
    budget := 30000.
    min_players := 11.
}
procedure main() {
    pretty_print(maximize(T, D, term="maximize()"))
}
