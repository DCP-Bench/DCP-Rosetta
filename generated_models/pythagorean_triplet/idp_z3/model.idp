// pythagorean_triplet: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// A Pythagorean triplet is a set of three natural numbers a, b and c for which a^2 + b^2 = c^2. The order of a and b
// does not matter. There exists exactly one Pythagorean triplet for which a + b + c = 1000. Find a, b and c for this
// Pythagorean triplet such that a + b + c = 1000.
//
//   https://dcp-bench.github.io/DCP-Rosetta/problems/pythagorean_triplet.html
// Save this model as model.idp and run it (`pip install idp-engine`) with:
//   idp-engine model.idp
vocabulary V {
    a: () -> Int                       // the first number of the triplet, the smaller of the two legs
    b: () -> Int                       // the second number of the triplet, the larger of the two legs
    c: () -> Int                       // the hypotenuse of the triplet
}
theory T:V {
    // a, b and c are natural numbers, with a below b so that the triplet is written in one order
    1 =< a() & a() < b() & b() < c().
    // a squared plus b squared equals c squared
    a() * a() + b() * b() = c() * c().
    // the three numbers add up to 1000
    a() + b() + c() = 1000.
}
procedure main() {
    pretty_print(model_expand(T, max=1))
}
