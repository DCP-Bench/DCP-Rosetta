% pythagorean_triplet: a Picat model from DCP Rosetta.
%
% A Pythagorean triplet is a set of three natural numbers a, b and c with a^2 + b^2 = c^2; the order
% of a and b does not matter. Find the Pythagorean triplet whose numbers add up to 1000. There is
% exactly one such triplet.
%
%   https://dcp-bench.github.io/DCP-Rosetta/problems/pythagorean_triplet.html
% Save this model as model.pi and run it (Picat 3.9, https://picat-lang.org) with:
%   picat model.pi
import cp.

model(_Data, Vars, Outputs, Options) =>
    % a, b and c are natural numbers, so each is at least 1 and at most 998 (the other two add up to
    % at least 2)
    [A, B, C] :: 1..998,
    % the three numbers add up to 1000
    A + B + C #= 1000,
    % a^2 + b^2 = c^2
    A * A + B * B #= C * C,
    Vars = [A, B, C],
    Outputs = [a = A, b = B, c = C],
    Options = [].

main =>
    model(new_map(), Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
