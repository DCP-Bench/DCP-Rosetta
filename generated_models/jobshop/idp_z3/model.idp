// jobshop: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// One common scheduling problem is the job shop, in which multiple jobs are processed on several machines. Each job
// consists of a sequence of tasks, which must be performed in a given order, and each task must be processed on a
// specific machine. For example, the job could be the manufacture of a single consumer item, such as an automobile. The
// problem is to schedule the tasks on the machines so as to minimize the length of the schedule: the time it takes for
// all the jobs to be completed.
//
// There are several constraints for the job shop problem:
// - No task for a job can be started until the previous task for that job is completed.
// - A machine can only work on one task at a time.
// - A task, once started, must run to completion.
//
// Save this file as model.idp. Download `jobshop.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/jobshop.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py jobshop.json
//   idp-engine model_1.idp
vocabulary V {
    type Job <: Int                    // the jobs, numbered from 0
    type Task <: Int                   // the task positions within a job, numbered from 0 up to the longest job
    type Pair <: Int                   // 0 for the machine of a task, 1 for its duration
    jobs_data: Job * Task * Pair -> Int  // jobs_data(j, t, 0): the machine of task t of job j; jobs_data(j, t, 1): its
                                         // duration (padded with 0 beyond the tasks of the job)
    jobs_data_len: Job -> Int          // jobs_data_len(j): the number of tasks of job j
    start: Job * Task -> Int           // start(j, t): the start time of task t of job j (auxiliary)
    makespan: () -> Int                // the time at which all the jobs are completed
    minimize: () -> Int                // the makespan, to be minimized
}
theory T:V {
    // each task starts no earlier than time 0 and ends no later than the makespan
    ! j in Job: ! t in Task: t < jobs_data_len(j) => 0 =< start(j, t) & start(j, t) + jobs_data(j, t, 1) =< makespan().
    // no task for a job can be started until the previous task for that job is completed
    ! j in Job: ! t in Task: ! t2 in Task: (t2 = t + 1 & t2 < jobs_data_len(j)) => start(j, t) + jobs_data(j, t, 1) =< start(j, t2).
    // a machine can only work on one task at a time: two different tasks on the same machine do not overlap
    ! j in Job: ! t in Task: ! j2 in Job: ! t2 in Task:
        (t < jobs_data_len(j) & t2 < jobs_data_len(j2) & (j ~= j2 | t ~= t2) & jobs_data(j, t, 0) = jobs_data(j2, t2, 0))
        => (start(j, t) + jobs_data(j, t, 1) =< start(j2, t2) | start(j2, t2) + jobs_data(j2, t2, 1) =< start(j, t)).
    // the minimized value is the makespan
    minimize() = makespan().
}
procedure main() {
    pretty_print(minimize(T, S, term="minimize()"))
}
