// allergy: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Four friends (two women named Debra and Janet, and two men named Hugh and Rick) found that each of them is allergic
// to something different: eggs, mold, nuts and ragweed. Match each one's surname (Baxter, Lemon, Malone and Fleet) with
// his or her allergy. We know that:
//  - Rick is not allergic to mold
//  - Baxter is allergic to eggs
//  - Hugh is neither surnamed Lemon nor Fleet
//  - Debra is allergic to ragweed
//  - Janet (who isn't Lemon) is neither allergic to eggs nor to mold
//
// Each friend is numbered: Debra = 0, Janet = 1, Hugh = 2, Rick = 3.
//
//   https://dcp-bench.github.io/DCP-Rosetta/problems/allergy.html
// Save this model as model.idp and run it (`pip install idp-engine`) with:
//   idp-engine model.idp
vocabulary V {
    type Friend := {0..3}              // the four friends: 0 Debra, 1 Janet, 2 Hugh, 3 Rick
    eggs: () -> Friend                 // the friend allergic to eggs
    mold: () -> Friend                 // the friend allergic to mold
    nuts: () -> Friend                 // the friend allergic to nuts
    ragweed: () -> Friend              // the friend allergic to ragweed
    baxter: () -> Friend               // the friend surnamed Baxter
    lemon: () -> Friend                // the friend surnamed Lemon
    malone: () -> Friend               // the friend surnamed Malone
    fleet: () -> Friend                // the friend surnamed Fleet
}
theory T:V {
    // each friend has a different allergy
    eggs() ~= mold() & eggs() ~= nuts() & eggs() ~= ragweed().
    mold() ~= nuts() & mold() ~= ragweed().
    nuts() ~= ragweed().
    // each friend has a different surname
    baxter() ~= lemon() & baxter() ~= malone() & baxter() ~= fleet().
    lemon() ~= malone() & lemon() ~= fleet().
    malone() ~= fleet().
    // Rick is not allergic to mold
    mold() ~= 3.
    // Baxter is allergic to eggs
    eggs() = baxter().
    // Hugh is neither surnamed Lemon nor Fleet
    lemon() ~= 2 & fleet() ~= 2.
    // Debra is allergic to ragweed
    ragweed() = 0.
    // Janet is not surnamed Lemon
    lemon() ~= 1.
    // Janet is neither allergic to eggs nor to mold
    eggs() ~= 1 & mold() ~= 1.
}
procedure main() {
    pretty_print(model_expand(T, max=1))
}
