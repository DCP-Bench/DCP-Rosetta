% csplib_014_solitaire_battleships: a Picat model from DCP Rosetta.
%
% The Battleships puzzle is played on a grid. The fleet has battleships (four squares long),
% cruisers (three), destroyers (two) and submarines (one square each). Ships lie horizontally or
% vertically, and no two ships occupy adjacent squares, not even diagonally. The numbers along the
% right side and below the grid give the number of occupied squares in each row and each column.
% Some puzzles start with shots: each shows water, a complete submarine, or a part of a longer
% vessel. Each square is water, a submarine, or a ship part (left end, right end, top end, bottom
% end or middle), and the solution must give the fleet listed and respect the shots.
%
% Save this file as model.pi. Download `csplib_014_solitaire_battleships.json` and `dcp_convert_picat.py` from the
% problem's page:
%   https://dcp-bench.github.io/DCP-Rosetta/problems/csplib_014_solitaire_battleships.html
% Convert the instances once, then run the first one (Picat 3.9, https://picat-lang.org):
%   python dcp_convert_picat.py csplib_014_solitaire_battleships.json
%   picat model.pi csplib_014_solitaire_battleships_1.dat
%
% Data.get(rows), Data.get(cols): the number of rows and columns; Data.get(rowsum), Data.get(colsum):
% the occupied squares wanted in each row and each column (lists indexed from 1);
% Data.get(fleet_counts): one [ship size, number of ships of that size] pair per size;
% Data.get(hints): one [row, column, content] triple per shot, counted from 0; the codes of the
% square contents are Data.get('WATER'), 'CIRCLE' (a submarine), 'LEFT', 'RIGHT', 'TOP', 'BOTTOM',
% 'MIDDLE' (a ship part of that kind).
import sat.

model(Data, Vars, Outputs, Options) =>
    R = Data.get(rows),
    C = Data.get(cols),
    RowSum = Data.get(rowsum),
    ColSum = Data.get(colsum),
    Fleet = Data.get(fleet_counts),
    Hints = Data.get(hints),
    Water = Data.get('WATER'),
    Circle = Data.get('CIRCLE'),
    Left = Data.get('LEFT'),
    Right = Data.get('RIGHT'),
    Top = Data.get('TOP'),
    Bottom = Data.get('BOTTOM'),
    Middle = Data.get('MIDDLE'),
    % G is the grid with a frame of water around it, so that a square outside the grid counts
    % as water for every neighbour test. The square in row r, column c (counted from 1) of the
    % puzzle is G[r + 1, c + 1]. Inside the frame every square takes one of the seven square codes (water, submarine, the five ship parts).
    G = new_array(R + 2, C + 2),
    foreach (I in 1..R + 2, J in 1..C + 2)
        if (I == 1 ; I == R + 2 ; J == 1 ; J == C + 2) then
            G[I, J] = Water
        else
            G[I, J] :: [Water, Circle, Left, Right, Top, Bottom, Middle]
        end
    end,
    % the shots: the square of each hint holds the given content
    foreach (Hint in Hints)
        G[Hint[1] + 2, Hint[2] + 2] #= Hint[3]
    end,
    % the occupied (non-water) squares of each row and of each column are as many as the numbers say
    foreach (I in 1..R)
        sum([G[I + 1, J + 1] #> Water : J in 1..C]) #= RowSum[I]
    end,
    foreach (J in 1..C)
        sum([G[I + 1, J + 1] #> Water : I in 1..R]) #= ColSum[J]
    end,
    foreach (I in 2..R + 1, J in 2..C + 1)
        % no two ships touch, not even at a corner: an occupied square has water on its four diagonals
        G[I, J] #> Water #=>
            (G[I - 1, J - 1] #= Water #/\ G[I - 1, J + 1] #= Water #/\
             G[I + 1, J - 1] #= Water #/\ G[I + 1, J + 1] #= Water),
        % a submarine is surrounded by water on its four sides
        G[I, J] #= Circle #=>
            (G[I - 1, J] #= Water #/\ G[I + 1, J] #= Water #/\
             G[I, J - 1] #= Water #/\ G[I, J + 1] #= Water),
        % a left end has a middle or right end to its right, and water on its other sides
        G[I, J] #= Left #=>
            ((G[I, J + 1] #= Middle #\/ G[I, J + 1] #= Right) #/\
             G[I, J - 1] #= Water #/\ G[I - 1, J] #= Water #/\ G[I + 1, J] #= Water),
        % a right end has a middle or left end to its left, and water on its other sides
        G[I, J] #= Right #=>
            ((G[I, J - 1] #= Middle #\/ G[I, J - 1] #= Left) #/\
             G[I, J + 1] #= Water #/\ G[I - 1, J] #= Water #/\ G[I + 1, J] #= Water),
        % a top end has a middle or bottom end below it, and water on its other sides
        G[I, J] #= Top #=>
            ((G[I + 1, J] #= Middle #\/ G[I + 1, J] #= Bottom) #/\
             G[I - 1, J] #= Water #/\ G[I, J - 1] #= Water #/\ G[I, J + 1] #= Water),
        % a bottom end has a middle or top end above it, and water on its other sides
        G[I, J] #= Bottom #=>
            ((G[I - 1, J] #= Middle #\/ G[I - 1, J] #= Top) #/\
             G[I + 1, J] #= Water #/\ G[I, J - 1] #= Water #/\ G[I, J + 1] #= Water),
        % a middle square lies inside a horizontal ship (left or middle on its left, right or
        % middle on its right, water above and below) or inside a vertical ship (top or middle
        % above, bottom or middle below, water on both sides)
        G[I, J] #= Middle #=>
            (((G[I, J - 1] #= Left #\/ G[I, J - 1] #= Middle) #/\
              (G[I, J + 1] #= Right #\/ G[I, J + 1] #= Middle) #/\
              G[I - 1, J] #= Water #/\ G[I + 1, J] #= Water) #\/
             ((G[I - 1, J] #= Top #\/ G[I - 1, J] #= Middle) #/\
              (G[I + 1, J] #= Bottom #\/ G[I + 1, J] #= Middle) #/\
              G[I, J - 1] #= Water #/\ G[I, J + 1] #= Water))
    end,
    % the fleet: the listed number of ships of each size. A ship of one square is a submarine.
    % A longer ship is a left end and a right end Size - 1 squares apart in a row, or a top end
    % and a bottom end Size - 1 squares apart in a column; the squares between them are middles,
    % which the rules above force.
    foreach (Entry in Fleet)
        Size = Entry[1],
        Count = Entry[2],
        if Size == 1 then
            sum([G[I, J] #= Circle : I in 2..R + 1, J in 2..C + 1]) #= Count
        else
            sum([G[I, J] #= Left #/\ G[I, J + Size - 1] #= Right :
                 I in 2..R + 1, J in 2..C + 2 - Size]) +
            sum([G[I, J] #= Top #/\ G[I + Size - 1, J] #= Bottom :
                 I in 2..R + 2 - Size, J in 2..C + 1]) #= Count
        end
    end,
    % no ship beyond the fleet: every left or top end starts one of the ships counted above
    LongShips = sum([Entry[2] : Entry in Fleet, Entry[1] > 1]),
    sum([G[I, J] #= Left : I in 2..R + 1, J in 2..C + 1]) +
    sum([G[I, J] #= Top : I in 2..R + 1, J in 2..C + 1]) #= LongShips,
    Grid = [[G[I, J] : J in 2..C + 1] : I in 2..R + 1],
    Vars = [G[I, J] : I in 2..R + 1, J in 2..C + 1],
    Outputs = [grid = Grid],
    Options = [].

main([File]) =>
    Fd = open(File),
    Term = read_term(Fd),
    Term = $json_object(Keys, Values),
    close(Fd),
    Data = new_map([K = V : {K, V} in zip(Keys, Values)]),
    model(Data, Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
