// three_sum: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Given a collection of integers, find exactly m elements that sum to zero.
//
// Save this file as model.idp. Download `three_sum.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/three_sum.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py three_sum.json
//   idp-engine model_1.idp
vocabulary V {
    type I <: Int                      // the elements of the collection, numbered from 0, sized from nums
    m: () -> Int                       // the number of elements to select
    nums: I -> Int                     // nums(i): the integer at position i of the collection
    indices: I -> Bool                 // indices(i): element i is selected (declared output)
}
theory T:V {
    // exactly m elements are selected
    #{ i in I: indices(i) } = m().

    // the selected elements sum to zero
    sum{{ nums(i) | i in I: indices(i) }} = 0.
}
procedure main() {
    pretty_print(model_expand(T, S, max=1))
}
