// sudoku: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// The goal of Sudoku is to fill a 9x9 grid with numbers so that each row, column and 3x3 section contain all the digits
// between 1 and 9. The input is a grid with some cells filled with numbers and some empty.
//
// Save this file as model.idp. Download `sudoku.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/sudoku.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py sudoku.json
//   idp-engine model_1.idp
vocabulary V {
    type Row <: Int                    // the rows of the grid, numbered from 0
    type Col <: Int                    // the columns of the grid, numbered from 0
    type Digit := {1..9}               // the digits of the puzzle
    type Sec := {0..2}                 // the three bands (of rows) and the three stacks (of columns) of 3x3 sections, numbered from 0
    input_grid: Row * Col -> Int       // input_grid(r, c): the digit given in row r, column c, or 0 for an empty cell
    grid: Row * Col -> Digit           // grid(r, c): the digit in row r, column c of the solved grid (declared output)
}
theory T:V {
    // every given digit stays in its cell
    ! r in Row, c in Col: input_grid(r, c) ~= 0 => grid(r, c) = input_grid(r, c).

    // each row contains each digit exactly once
    ! r in Row, d in Digit: #{ c in Col: grid(r, c) = d } = 1.

    // each column contains each digit exactly once
    ! c in Col, d in Digit: #{ r in Row: grid(r, c) = d } = 1.

    // each 3x3 section contains each digit exactly once
    ! a, b in Sec, d in Digit:
        #{ r in Row, c in Col: 3 * a =< r & r =< 3 * a + 2 & 3 * b =< c & c =< 3 * b + 2 & grid(r, c) = d } = 1.
}
procedure main() {
    pretty_print(model_expand(T, S, max=1))
}
