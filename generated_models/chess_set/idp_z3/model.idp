// chess_set: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// A small joinery makes two different sizes of boxwood chess sets. The small set requires 3 hours of machining on a
// lathe, and the large set requires 2 hours. There are four lathes with skilled operators who each work a 40 hour week,
// so there are 160 lathe-hours per week. The small chess set requires 1 kg of boxwood, and the large set requires 3 kg.
// Boxwood is scarce and only 200 kg per week can be obtained. When sold, each of the large chess sets yields a profit of
// $20, and each of the small chess sets a profit of $5. The problem is to decide how many sets of each kind should be
// made each week so as to maximize profit.
//
//   https://dcp-bench.github.io/DCP-Rosetta/problems/chess_set.html
// Save this model as model.idp and run it (`pip install idp-engine`) with:
//   idp-engine model.idp
vocabulary V {
    small_set: () -> Int                   // the number of small chess sets made each week
    large_set: () -> Int                   // the number of large chess sets made each week
    max_profit: () -> Int                  // the profit from the sets made each week
    maximize: () -> Int                    // the profit from the sets made each week, to maximize
}
theory T:V {
    // the numbers of sets made are not negative
    0 =< small_set() & 0 =< large_set().
    // the lathe-hours used (3 per small set, 2 per large set) are at most 160 per week
    3 * small_set() + 2 * large_set() =< 160.
    // the boxwood used (1 kg per small set, 3 kg per large set) is at most 200 kg per week
    small_set() + 3 * large_set() =< 200.
    // the profit is $5 per small set and $20 per large set
    max_profit() = 5 * small_set() + 20 * large_set().
    // the profit is the value to maximize
    maximize() = max_profit().
}
procedure main() {
    pretty_print(maximize(T, term="maximize()"))
}
