// csplib_032_max_density_still_life: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Find a still life of live and dead cells on an n by m active grid that has as many live cells as possible. A still
// life does not change from one generation to the next: a live cell has 2 or 3 live neighbours, and a dead cell, also
// a dead cell just outside the active grid, does not have exactly 3 live neighbours. Cells outside the grid are dead.
//
// Save this file as model.idp. Download `csplib_032_max_density_still_life.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/csplib_032_max_density_still_life.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py csplib_032_max_density_still_life.json
//   idp-engine model_1.idp
vocabulary V {
    type Range_n <: Int                // the rows of the active grid, numbered 1..n
    type Range_m <: Int                // the columns of the active grid, numbered 1..m
    n: () -> Int                       // the number of rows of the active grid
    m: () -> Int                       // the number of columns of the active grid
    grid: Range_n * Range_m -> Bool    // grid(i, j): cell (i, j) of the active grid is alive
    neighbours: Range_n * Range_m -> Int  // neighbours(i, j): the number of live cells among the eight cells around (i, j) in the grid
    maximize: () -> Int                // the number of live cells in the grid
}
theory T:V {
    // the neighbours of a cell of the grid are the live cells in the grid next to it
    ! i in Range_n, j in Range_m: neighbours(i, j) = #{ a in Range_n, b in Range_m: grid(a, b) & i - 1 =< a & a =< i + 1 & j - 1 =< b & b =< j + 1 & (a ~= i | b ~= j) }.

    // a live cell in the grid has 2 or 3 live neighbours
    ! i in Range_n, j in Range_m: grid(i, j) => 2 =< neighbours(i, j) & neighbours(i, j) =< 3.

    // a dead cell in the grid does not have exactly 3 live neighbours
    ! i in Range_n, j in Range_m: ~grid(i, j) => neighbours(i, j) ~= 3.

    // a dead cell just above the grid does not have exactly 3 live neighbours
    ! j in Range_m: #{ a in Range_n, b in Range_m: a =< 1 & grid(a, b) & j - 1 =< b & b =< j + 1 } ~= 3.

    // a dead cell just below the grid does not have exactly 3 live neighbours
    ! j in Range_m: #{ a in Range_n, b in Range_m: n() =< a & grid(a, b) & j - 1 =< b & b =< j + 1 } ~= 3.

    // a dead cell just left of the grid does not have exactly 3 live neighbours
    ! i in Range_n: #{ a in Range_n, b in Range_m: b =< 1 & grid(a, b) & i - 1 =< a & a =< i + 1 } ~= 3.

    // a dead cell just right of the grid does not have exactly 3 live neighbours
    ! i in Range_n: #{ a in Range_n, b in Range_m: m() =< b & grid(a, b) & i - 1 =< a & a =< i + 1 } ~= 3.

    // the number of live cells in the grid is the value to maximize
    maximize() = #{ i in Range_n, j in Range_m: grid(i, j) }.
}
procedure main() {
    pretty_print(maximize(T, S, term="maximize()"))
}
