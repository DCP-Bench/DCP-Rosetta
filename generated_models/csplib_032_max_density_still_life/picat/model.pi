% csplib_032_max_density_still_life: a Picat model from DCP Rosetta.
%
% Find the most densely populated stable pattern (a "still life") of Conway's Game of Life on an n x m
% active grid. Life is played on an infinite board; cells outside the n x m grid are dead and are not
% printed, but they are still part of the board. A pattern is a still life when a live cell has exactly 2
% or 3 live neighbours, and a dead cell, including a dead cell just outside the grid, does not have exactly
% 3 live neighbours. The goal is to maximise the number of live cells in the grid.
%
% Save this file as model.pi. Download `csplib_032_max_density_still_life.json` and `dcp_convert_picat.py` from the
% problem's page:
%   https://dcp-bench.github.io/DCP-Rosetta/problems/csplib_032_max_density_still_life.html
% Convert the instances once, then run the first one (Picat 3.9, https://picat-lang.org):
%   python dcp_convert_picat.py csplib_032_max_density_still_life.json
%   picat model.pi csplib_032_max_density_still_life_1.dat
%
% Data.get(n), Data.get(m): the number of rows n and of columns m of the grid.
import sat.

model(Data, Vars, Outputs, Options) =>
    N = Data.get(n),
    M = Data.get(m),
    % Grid[I, J] = 1 when the cell in row I, column J of the grid is alive
    Grid = new_array(N, M),
    Grid :: 0..1,
    % a live cell has 2 or 3 live neighbours, a dead cell does not have exactly 3
    foreach (I in 1..N, J in 1..M)
        % the live neighbours of the cell (I, J) inside the grid
        Neighbours = [Grid[I + DI, J + DJ] : DI in -1..1, DJ in -1..1,
                      DI * DI + DJ * DJ > 0,
                      I + DI >= 1, I + DI =< N, J + DJ >= 1, J + DJ =< M],
        Count #= sum(Neighbours),
        Grid[I, J] #= 1 #=> (Count #>= 2 #/\ Count #=< 3),
        Grid[I, J] #= 0 #=> Count #!= 3
    end,
    % the dead cells just above and below the grid do not have exactly 3 live neighbours
    % (a corner cell outside the grid has at most one neighbour in the grid, so needs no rule)
    foreach (J in 1..M)
        sum([Grid[1, JJ] : JJ in max(1, J - 1)..min(M, J + 1)]) #!= 3,
        sum([Grid[N, JJ] : JJ in max(1, J - 1)..min(M, J + 1)]) #!= 3
    end,
    % the dead cells just left and right of the grid do not have exactly 3 live neighbours
    foreach (I in 1..N)
        sum([Grid[II, 1] : II in max(1, I - 1)..min(N, I + 1)]) #!= 3,
        sum([Grid[II, M] : II in max(1, I - 1)..min(N, I + 1)]) #!= 3
    end,
    % the number of live cells in the grid
    Live #= sum([Grid[I, J] : I in 1..N, J in 1..M]),
    Vars = Grid,
    Outputs = [grid = Grid],
    % maximise the number of live cells
    Options = [$max(Live)].

main([File]) =>
    Fd = open(File),
    Term = read_term(Fd),
    Term = $json_object(Keys, Values),
    close(Fd),
    Data = new_map([K = V : {K, V} in zip(Keys, Values)]),
    model(Data, Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
