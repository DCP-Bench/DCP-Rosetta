// added_corners: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Enter the digits 1 through 8 into the eight positions around the edge of a 3 by 3 grid whose centre is empty, using
// each digit exactly once. The corners are circles (C) and the middles of the sides are squares (F):
//
//   C F C
//   F   F
//   C F C
//
// The number in each square must equal the sum of the numbers in the two circles adjoining it.
//
//   https://dcp-bench.github.io/DCP-Rosetta/problems/added_corners.html
// Save this model as model.idp and run it (`pip install idp-engine`) with:
//   idp-engine model.idp
vocabulary V {
    type Pos := {0..7}                 // the eight edge positions, numbered 0..7 from the top left, reading left to right, top to bottom
    positions: Pos -> Int              // positions(p): the digit written in edge position p
}
theory T:V {
    // each digit is between 1 and 8
    ! p in Pos: 1 =< positions(p) & positions(p) =< 8.
    // each digit is used exactly once: distinct positions hold distinct digits
    ! p1, p2 in Pos: p1 ~= p2 => positions(p1) ~= positions(p2).
    // the top middle square (position 1) equals the sum of the top left and top right circles (positions 0 and 2)
    positions(1) = positions(0) + positions(2).
    // the left middle square (position 3) equals the sum of the top left and bottom left circles (positions 0 and 5)
    positions(3) = positions(0) + positions(5).
    // the right middle square (position 4) equals the sum of the top right and bottom right circles (positions 2 and 7)
    positions(4) = positions(2) + positions(7).
    // the bottom middle square (position 6) equals the sum of the bottom left and bottom right circles (positions 5 and 7)
    positions(6) = positions(5) + positions(7).
}
procedure main() {
    pretty_print(model_expand(T, max=1))
}
