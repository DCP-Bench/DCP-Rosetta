% packing_rectangles: a Picat model from DCP Rosetta.
%
% Place rectangular items, each with a given width and height, into a larger rectangle so that no
% two items overlap and every item lies within the larger rectangle. Minimize the area of the larger
% rectangle needed to pack all the items.
%
% Save this file as model.pi. Download `packing_rectangles.json` and `dcp_convert_picat.py` from the
% problem's page:
%   https://dcp-bench.github.io/DCP-Rosetta/problems/packing_rectangles.html
% Convert the instances once, then run the first one (Picat 3.9, https://picat-lang.org):
%   python dcp_convert_picat.py packing_rectangles.json
%   picat model.pi packing_rectangles_1.dat
%
% Data.get(widths): the width of each item; Data.get(heights): the height of each item (lists
% indexed from 1).
import cp.

model(Data, Vars, Outputs, Options) =>
    Widths = Data.get(widths),
    Heights = Data.get(heights),
    N = len(Widths),                       % the number of items
    % the larger rectangle is at least as wide as its widest item and at least as high as its tallest
    MinTotalX = max(Widths),
    MinTotalY = max(Heights),
    % and at most as wide and as high as the sum of all widths and heights (a generous bound)
    MaxTotalX = sum(Widths) + sum(Heights),
    MaxTotalY = sum(Widths) + sum(Heights),
    % PosX[I], PosY[I] = the lower-left corner of item I, counted from 0
    PosX = new_list(N),
    PosY = new_list(N),
    PosX :: 0..MaxTotalX,
    PosY :: 0..MaxTotalY,
    % TotalX, TotalY = the width and the height of the larger rectangle
    TotalX :: MinTotalX..MaxTotalX,
    TotalY :: MinTotalY..MaxTotalY,
    % every item lies within the larger rectangle
    foreach (I in 1..N)
        PosX[I] + Widths[I] #=< TotalX,
        PosY[I] + Heights[I] #=< TotalY
    end,
    % no two items overlap: each one is left of, right of, below or above every other one
    diffn([[PosX[I], PosY[I], Widths[I], Heights[I]] : I in 1..N]),
    % the area of the larger rectangle
    Area #= TotalX * TotalY,
    Vars = [TotalX, TotalY] ++ PosX ++ PosY,
    Outputs = [pos_x = PosX, pos_y = PosY, total_x = TotalX, total_y = TotalY],
    % minimize the area of the larger rectangle
    Options = [$min(Area)].

main([File]) =>
    Fd = open(File),
    Term = read_term(Fd),
    Term = $json_object(Keys, Values),
    close(Fd),
    Data = new_map([K = V : {K, V} in zip(Keys, Values)]),
    model(Data, Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
