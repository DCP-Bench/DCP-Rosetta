// bales_of_hay: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// There are a number of bales of hay. They were weighed in all possible combinations of two, and the weights of these
// combinations were written down in numerical order, without keeping track of which weight matched which pair of bales.
// Given the weights of the pairs, find the weight of each bale.
//
// Save this file as model.idp. Download `bales_of_hay.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/bales_of_hay.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py bales_of_hay.json
//   idp-engine model_1.idp

vocabulary V {
    type I <: Int                      // the given weights of pairs of bales, numbered from 0, sized from weights
    type Range_n <: Int                // the bales, numbered 1..n
    n: () -> Int                       // the number of bales
    weights: I -> Int                  // weights(k): the k-th given weight of a pair of bales
    bales: Range_n -> Int               // bales(i): the weight of bale i (the output)
}

theory T:V {
    // the weight of each bale is not negative
    ! i in Range_n: 0 =< bales(i).
    // the given weights are exactly the weights of the pairs of distinct bales, each pair giving one weight:
    // for each given weight, the number of pairs of bales with that total equals the number of given weights equal to it
    ! k in I: #{ i, j in Range_n: i < j & bales(i) + bales(j) = weights(k) } = #{ t in I: weights(t) = weights(k) }.
    // every pair of distinct bales has a total that is one of the given weights
    ! i, j in Range_n: i < j => (? t in I: weights(t) = bales(i) + bales(j)).
}

procedure main() {
    pretty_print(model_expand(T, S, max=1))
}
