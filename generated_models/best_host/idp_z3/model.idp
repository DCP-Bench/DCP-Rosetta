// best_host: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Six guests are to be seated around a round dinner table with six seats. Some guests do not get along with each other,
// and if two guests who do not get along sit next to each other, it creates conflict at dinner. Arrange the guests in a
// seating order around the table so that every guest sits only next to the two guests they will sit next to:
// Andrew will only sit next to Dave and Frank; Betty will only sit next to Cara and Erica; Cara will only sit next to
// Betty and Frank; Dave will only sit next to Andrew and Erica; Erica will only sit next to Betty and Dave; Frank will
// only sit next to Andrew and Cara.
//
//   https://dcp-bench.github.io/DCP-Rosetta/problems/best_host.html
// Save this model as model.idp and run it (`pip install idp-engine`) with:
//   idp-engine model.idp

vocabulary V {
    type Seat := {0..5}                // the seats around the table, numbered 0..5 in seating order (seat 5 is next to seat 0)
    type Guest := {0..5}               // the guests: 0 Andrew, 1 Betty, 2 Cara, 3 Dave, 4 Erica, 5 Frank
    x: Seat -> Guest                   // x(s): the guest sitting in seat s (the output)
    gets_along: Guest * Guest -> Bool  // gets_along(g, h): guests g and h will sit next to each other
}

theory T:V {
    // every seat is taken by one guest, and every guest sits in exactly one seat
    ! s, t in Seat: x(s) = x(t) => s = t.
    // each guest sits next to guests they will sit next to, for each pair of neighbouring seats
    ! s in Seat: s < 5 => gets_along(x(s), x(s + 1)).
    // the guest in the last seat and the guest in the first seat are neighbours too, the table being round
    gets_along(x(5), x(0)).
}

structure S2:V {
    // the pairs of guests who will sit next to each other (both ways round)
    gets_along := { (0,3), (3,0), (0,5), (5,0), (1,2), (2,1), (1,4), (4,1), (2,5), (5,2), (3,4), (4,3) }.
}

procedure main() {
    pretty_print(model_expand(T, S2, max=1))
}
