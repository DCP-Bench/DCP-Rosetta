% best_host: a Picat model from DCP Rosetta.
%
% Hosting a dinner party: six guests sit round a dinner table. Two guests who do not get along create
% conflict if they are seated next to each other, so arrange the guests in a seating order that
% minimizes conflict. Andrew will only sit next to Dave and Frank; Betty will only sit next to Cara and
% Erica; Cara will only sit next to Betty and Frank; Dave will only sit next to Andrew and Erica; Erica
% will only sit next to Betty and Dave; Frank will only sit next to Andrew and Cara. An arrangement
% without any conflict exists, so every guest must sit only next to the guests they will sit next to.
%
%   https://dcp-bench.github.io/DCP-Rosetta/problems/best_host.html
% Save this model as model.pi and run it (Picat 3.9, https://picat-lang.org) with:
%   picat model.pi
import cp.

model(_Data, Vars, Outputs, Options) =>
    % the six guests, numbered 0 Andrew, 1 Betty, 2 Cara, 3 Dave, 4 Erica, 5 Frank
    N = 6,
    % Prefs[G + 1] = the guests that guest G will sit next to
    Prefs = [[3, 5], [2, 4], [1, 5], [0, 4], [1, 3], [0, 2]],
    % X[I] = the guest in seat I, going round the table; the seats are numbered from 1
    X = new_list(N),
    X :: 0..N - 1,
    % every guest has exactly one seat
    all_different(X),
    % the pairs of guests who may sit next to each other, in either order
    Allowed = [{G, H} : G in 0..N - 1, H in Prefs[G + 1]],
    % each seat's guest sits next to the guests they will sit next to, on both sides, round the table
    foreach (I in 1..N)
        J = (I mod N) + 1,                 % the seat after seat I, the last seat being followed by the first
        table_in({X[I], X[J]}, Allowed)
    end,
    Vars = X,
    Outputs = [x = X],
    Options = [].

main =>
    model(new_map(), Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
