// De Bruijn sequence B(k, n): a cyclic sequence over the alphabet {0..k-1} (k = base) of length
// k^n in which every length-n string occurs exactly once as a (cyclic) substring.
vocabulary {
    base: () -> Int
    n: () -> Int
    type Range_n <: Int                 // 1..n: the offsets inside a window
    type Range_base <: Int              // 1..base
    type Pos <: Int                     // 1..base^n: the positions of the sequence
    Pos_size: () -> Int
    de_bruijn: Pos -> Int               // declared output
    sym: Pos * Range_n -> Int           // sym(i, j): symbol j of the window starting at position i
}

theory {
    // The length is base^n. IDP-Z3 cannot fold `base() ^ n()` into a type size, so it is
    // counted as the number of strings of length n over the alphabet, written with six
    // symbol slots of which the slots beyond n are pinned to one value: exact for n =< 6.
    Pos_size() = #{ d1, d2, d3, d4, d5, d6 in Range_base:
                    (n() < 2 => d2 = 1) & (n() < 3 => d3 = 1) & (n() < 4 => d4 = 1) &
                    (n() < 5 => d5 = 1) & (n() < 6 => d6 = 1) }.
    // the counting above is exact only up to that order
    n() =< 6.

    // every symbol is a letter of the alphabet 0..base-1
    ! i in Pos: 0 =< de_bruijn(i) & de_bruijn(i) =< base() - 1.

    // the window starting at position i reads the next n symbols, cyclically wrapping around
    // the end: symbol j of the window is at position i + j - 1 or, past the end, i + j - 1 - base^n
    ! i, p in Pos, j in Range_n: (p = i + j - 1 | p = i + j - 1 - Pos_size()) => sym(i, j) = de_bruijn(p).

    // every length-n string occurs exactly once: there are base^n windows and base^n strings,
    // so it is enough that any two windows differ in some symbol
    ! i1, i2 in Pos: i1 < i2 => ? j in Range_n: sym(i1, j) ~= sym(i2, j).
}
