// de_bruijn_sequence: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// In combinatorial mathematics, a de Bruijn sequence of order n on a size-k alphabet A is a cyclic sequence in which
// every possible length-n string on A occurs exactly once as a substring. Such a sequence is denoted B(k, n) and has
// length k^n. Find a de Bruijn sequence of the given order on the given size alphabet.
//
// Save this file as model.idp. Download `de_bruijn_sequence.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/de_bruijn_sequence.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py de_bruijn_sequence.json
//   idp-engine model_1.idp
vocabulary V {
    base: () -> Int                    // the size k of the alphabet
    n: () -> Int                       // the order: the length of the strings that must each occur once
    type Range_n <: Int                // the offsets 1..n inside a window
    type Range_base <: Int             // the symbols of the alphabet, numbered 1..k as counting slots
    type Pos <: Int                    // the positions 1..k^n of the sequence
    Pos_size: () -> Int                // k^n, the length of the sequence
    de_bruijn: Pos -> Int              // de_bruijn(i): the symbol at position i, from 0 to k-1 (declared output)
    sym: Pos * Range_n -> Int          // sym(i, j): symbol j of the window starting at position i
}
theory T:V {
    // the length is base^n, counted as the number of strings of length n over the alphabet (slots beyond n pinned)
    Pos_size() = #{ d1, d2, d3, d4, d5, d6 in Range_base:
                    (n() < 2 => d2 = 1) & (n() < 3 => d3 = 1) & (n() < 4 => d4 = 1) &
                    (n() < 5 => d5 = 1) & (n() < 6 => d6 = 1) }.
    // the counting above is exact only up to order 6
    n() =< 6.
    // every symbol is a letter of the alphabet 0..base-1
    ! i in Pos: 0 =< de_bruijn(i) & de_bruijn(i) =< base() - 1.
    // symbol j of the window starting at position i is read cyclically from the sequence
    ! i, p in Pos, j in Range_n: (p = i + j - 1 | p = i + j - 1 - Pos_size()) => sym(i, j) = de_bruijn(p).
    // every length-n string occurs exactly once: any two windows differ in some symbol
    ! i1, i2 in Pos: i1 < i2 => ? j in Range_n: sym(i1, j) ~= sym(i2, j).
}
procedure main() {
    pretty_print(model_expand(T, S, max=1, timeout_seconds=300))
}
