// csplib_084_hadamard_matrix: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// For every odd positive integer l (and m = (l - 1) / 2), find two sequences a_1, ..., a_l and b_1, ..., b_l with values
// -1 or 1 (the 2cc Hadamard matrix Legendre pairs problem), such that:
// - for each shift s = 1, ..., m, the periodic autocorrelation of a plus that of b at shift s equals -2, where
//   PAF(A, s) = sum over i of a_i a_(i+s), the index i+s taken modulo l;
// - the entries of a sum to 1, and the entries of b sum to 1.
//
// Save this file as model.idp. Download `csplib_084_hadamard_matrix.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/csplib_084_hadamard_matrix.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py csplib_084_hadamard_matrix.json
//   idp-engine model_1.idp
vocabulary V {
    l: () -> Int                       // the odd length l of the sequences
    type Range_l <: Int                // the positions 1..l of the sequences
    type Sign := {-1..1}               // the values of the entries; only -1 and 1 are allowed
    a: Range_l -> Sign                 // a(i): entry i of sequence A, 1-based (declared output)
    b: Range_l -> Sign                 // b(i): entry i of sequence B, 1-based (declared output)
}
theory T:V {
    // every entry of both sequences is -1 or 1
    ! i in Range_l: a(i) ~= 0 & b(i) ~= 0.

    // for each shift s from 1 to m = (l - 1) / 2, the periodic autocorrelations of A and B at shift s add up to -2
    // (a product of two entries is 1 when they are equal and -1 when they differ)
    ! s in Range_l: s =< (l() - 1) / 2 => sum{{ (if a(i) = a(i + s) then 1 else -1) | i in Range_l: i + s =< l() }} + sum{{ (if a(i) = a(i + s - l()) then 1 else -1) | i in Range_l: i + s > l() }} + sum{{ (if b(i) = b(i + s) then 1 else -1) | i in Range_l: i + s =< l() }} + sum{{ (if b(i) = b(i + s - l()) then 1 else -1) | i in Range_l: i + s > l() }} = -2.

    // the entries of A sum to 1
    sum{{ a(i) | i in Range_l }} = 1.

    // the entries of B sum to 1
    sum{{ b(i) | i in Range_l }} = 1.
}
procedure main() {
    pretty_print(model_expand(T, S, max=1))
}
