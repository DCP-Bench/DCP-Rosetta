% four_islands: a Picat model from DCP Rosetta.
%
% A tiny nation in the South Pacific contains four islands connected by bridges as shown:
%
%   (A) -- (B)
%    |      |
%    |      |
%   (C) -- (D)
%
% This means that A is north of C, C is west of D, etc. Each of the four islands (Pwana, Quero, Rayou,
% and Skern) boasts a different primary export (alabaster, bananas, coconuts, and durian fruit) and a
% different tourist attraction (hotel, ice skating rink, jai alai stadium, and koala preserve). Find the
% name, export, and tourist attraction of each island on the map, from these clues:
% 1. The island noted for its koala preserve is due south of Pwana.
% 2. The island with the largest alabaster quarry is due west of Quero.
% 3. The island with the resort hotel is due east of the one that exports durian fruit.
% 4. Skern and the island with the jai alai stadium are connected by a north-south bridge.
% 5. Rayou and the island that exports bananas are connected by an east-west bridge.
% 6. The islands noted for the South Pacific's largest ice skating rink and for the jai alai stadium
%    are not connected by a bridge.
%
%   https://dcp-bench.github.io/DCP-Rosetta/problems/four_islands.html
% Save this model as model.pi and run it (Picat 3.9, https://picat-lang.org) with:
%   picat model.pi
%
% The map positions are numbered A=0, B=1, C=2, D=3. Island[I] is the position of island I (Pwana,
% Quero, Rayou, Skern), Export[E] the position of the island that exports E (alabaster, bananas,
% coconuts, durian fruit), and Attraction[T] the position of the island with attraction T (hotel,
% ice skating rink, jai alai stadium, koala preserve); the lists are indexed from 1 in that order.
import cp.

model(_Data, Vars, Outputs, Options) =>
    Island = new_list(4),
    Island :: 0..3,
    all_different(Island),
    Export = new_list(4),
    Export :: 0..3,
    all_different(Export),
    Attraction = new_list(4),
    Attraction :: 0..3,
    all_different(Attraction),
    % 1. the koala preserve is due south of Pwana (C is south of A, D is south of B)
    table_in({Attraction[4], Island[1]}, [{2,0}, {3,1}]),
    % 2. the alabaster island is due west of Quero (A is west of B, C is west of D)
    table_in({Export[1], Island[2]}, [{0,1}, {2,3}]),
    % 3. the resort hotel is due east of the durian fruit island (B is east of A, D is east of C)
    table_in({Attraction[1], Export[4]}, [{1,0}, {3,2}]),
    % 4. Skern and the jai alai stadium are connected by a north-south bridge
    table_in({Island[4], Attraction[3]}, [{0,2}, {2,0}, {1,3}, {3,1}]),
    % 5. Rayou and the banana island are connected by an east-west bridge
    table_in({Island[3], Export[2]}, [{0,1}, {1,0}, {2,3}, {3,2}]),
    % 6. the ice skating rink and the jai alai stadium are not connected by a bridge
    table_in({Attraction[2], Attraction[3]}, [{0,3}, {3,0}, {1,2}, {2,1}]),
    Vars = Island ++ Export ++ Attraction,
    Outputs = [island = Island, export = Export, attraction = Attraction],
    Options = [].

main =>
    model(new_map(), Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
