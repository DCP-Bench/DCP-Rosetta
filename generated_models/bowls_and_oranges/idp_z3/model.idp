// bowls_and_oranges: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// There are bowls numbered from 1, all placed in a line at intervals of 1 metre, and a number of oranges. Place all the
// oranges in the bowls, no more than one orange in each bowl, so that there are no three oranges A, B and C such that
// the distance between A and B is equal to the distance between B and C.
//
// Save this file as model.idp. Download `bowls_and_oranges.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/bowls_and_oranges.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py bowls_and_oranges.json
//   idp-engine model_1.idp

vocabulary V {
    type Range_m <: Int                // the oranges, numbered 1..m in ascending order of bowl
    n: () -> Int                       // the number of bowls
    m: () -> Int                       // the number of oranges
    x: Range_m -> Int                  // x(i): the bowl holding the i-th orange, in ascending order (the output)
}

theory T:V {
    // every orange is in a bowl between 1 and n
    ! i in Range_m: 1 =< x(i) & x(i) =< n().
    // the bowls are in ascending order, with at most one orange in each bowl
    ! i in Range_m: i < m() => x(i) < x(i + 1).
    // no three oranges in bowls A < B < C have the distance from A to B equal to the distance from B to C
    ! i, j, k in Range_m: i < j & j < k => x(i) + x(k) ~= 2 * x(j).
}

procedure main() {
    pretty_print(model_expand(T, S, max=1))
}
