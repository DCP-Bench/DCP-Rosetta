// car_selection: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Assign participants to cars to maximize the total number of assignments. Each participant may be interested in a
// subset of the available cars. Each participant is assigned to at most one car, and each car is assigned to at most
// one participant.
//
// Save this file as model.idp. Download `car_selection.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/car_selection.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py car_selection.json
//   idp-engine model_1.idp
vocabulary V {
    type P <: Int                      // the participants, numbered from 0
    type C <: Int                      // the cars, numbered from 0
    possible_assignments: P * C -> Int // possible_assignments(p, c): 1 if participant p is interested in car c, else 0
    assignments: P * C -> Bool         // assignments(p, c): participant p is assigned to car c
    maximize: () -> Int                // the total number of assignments
}
theory T:V {
    // each participant is assigned to at most one car
    ! p in P: #{c in C: assignments(p, c)} =< 1.
    // each car is assigned to at most one participant
    ! c in C: #{p in P: assignments(p, c)} =< 1.
    // a participant is assigned only to a car the participant is interested in
    ! p in P, c in C: assignments(p, c) => possible_assignments(p, c) = 1.
    // the total number of assignments is the value to maximize
    maximize() = #{p in P, c in C: assignments(p, c)}.
}
procedure main() {
    pretty_print(maximize(T, S, term="maximize()"))
}
