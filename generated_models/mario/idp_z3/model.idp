// mario: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Mario needs to collect as much gold as possible by visiting different houses. He starts at Mario's house and ends at
// Luigi's house. Each house has a certain amount of gold and the travel between houses consumes fuel. Mario has a limited
// amount of fuel, and he needs to plan his route to maximize the gold collected without exceeding the fuel limit.
//
// Save this file as model.idp. Download `mario.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/mario.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py mario.json
//   idp-engine model_1.idp
vocabulary V {
    type House <: Int                  // the houses, numbered from 0 to nHouses-1
    nHouses: () -> Int                 // the number of houses
    marioHouse: () -> Int              // the house of Mario, where the route starts
    luigiHouse: () -> Int              // the house of Luigi, where the route ends
    fuelLimit: () -> Int               // the maximum fuel the route may consume
    arc_fuel: House * House -> Int     // arc_fuel(i, j): the fuel needed to travel from house i to house j
    goldInHouse: House -> Int          // goldInHouse(i): the gold available in house i
    s: House -> House                  // s(i): the house succeeding house i on the route, s(i) = i if house i is not on the
                                       // route; the succeeding house of Luigi's house is Mario's house
    ord: House -> Int                  // ord(i): the position of house i along the route from Mario's house, which is 0 (auxiliary)
    maximize: () -> Int                // the total gold collected on the route
}
theory T:V {
    // the successor of a house is unique: s is a permutation of the houses
    ! i in House: ! k in House: s(i) = s(k) => i = k.
    // Mario's house is on the route, so its successor is another house
    s(marioHouse()) ~= marioHouse().
    // the route ends at Luigi's house, whose succeeding house is Mario's house
    s(luigiHouse()) = marioHouse().
    // Mario's house is at position 0 of the route
    ord(marioHouse()) = 0.
    // positions along the route stay between 0 and nHouses-1
    ! i in House: 0 =< ord(i) & ord(i) =< nHouses() - 1.
    // along the route, each house is followed by the house at the next position, except that Luigi's house returns to
    // Mario's house; so every cycle of the route passes through Mario's house
    ! i in House: ! j in House: (s(i) = j & i ~= j & i ~= luigiHouse() & j ~= marioHouse()) => ord(j) = ord(i) + 1.
    // the total fuel of the travel from Mario's house to Luigi's house stays within the fuel limit
    sum{{ arc_fuel(i, s(i)) | i in House: s(i) ~= i & i ~= luigiHouse() }} =< fuelLimit().
    // the total gold collected is the gold of the houses on the route
    maximize() = sum{{ goldInHouse(i) | i in House: s(i) ~= i }}.
}
procedure main() {
    pretty_print(maximize(T, S, term="maximize()"))
}
