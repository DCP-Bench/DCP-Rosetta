// csplib_024_langford: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Consider two sets of the numbers from 1 to k. Arrange the 2k numbers of the two sets into a single sequence in which the
// two 1's appear one number apart, the two 2's appear two numbers apart, ..., and the two k's appear k numbers apart.
//
// Save this file as model.idp. Download `csplib_024_langford.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/csplib_024_langford.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py csplib_024_langford.json
//   idp-engine model_1.idp
vocabulary V {
    type Range_k <: Int                // the numbers 1..k
    type Pos <: Int                    // the positions 1..2k of the sequence, sized by Pos_size
    Pos_size: () -> Int                // the number of positions, 2k (the size of Pos)
    k: () -> Int                       // the largest number
    sol: Pos -> Range_k                // sol(p): the number at position p of the sequence
}

theory T:V {
    // the sequence has 2k positions
    Pos_size() = 2 * k().

    // each number from 1 to k occurs exactly twice in the sequence
    ! v in Range_k: #{p in Pos: sol(p) = v} = 2.

    // the two occurrences of each number v are v + 1 positions apart, so that v numbers lie between them
    ! v in Range_k, p in Pos, q in Pos: sol(p) = v & sol(q) = v & p < q => q = p + v + 1.
}

procedure main() {
    pretty_print(model_expand(T, S, max=1))
}
