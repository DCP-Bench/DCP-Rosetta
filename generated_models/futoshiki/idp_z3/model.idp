// futoshiki: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// The futoshiki puzzle is played on a square grid, such as 5 x 5. The objective is to place the numbers 1 to 5 (or
// whatever the dimensions are) such that each row and each column contains each of the digits 1 to 5. Some digits may
// be given at the start. In addition, inequality constraints are specified between some of the squares, such that one
// must be higher or lower than its neighbour. These constraints must be honoured as the grid is filled out.
//
// Save this file as model.idp. Download `futoshiki.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/futoshiki.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py futoshiki.json
//   idp-engine model_1.idp
vocabulary V {
    type R <: Int                      // the rows of the grid, numbered from 0
    type C <: Int                      // the columns of the grid, numbered from 0
    type K <: Int                      // the inequality constraints, numbered from 0
    type F <: Int                      // the four entries of a constraint: 0 row and 1 column of the smaller cell, 2 row and 3 column of the larger cell
    values: R * C -> Int               // values(r, c): the digit given in cell (r, c), 0 when the cell is empty
    lt: K * F -> Int                   // lt(k, f): entry f of constraint k; the rows and columns in the data are numbered from 1
    size: () -> Int                    // the number of rows, which is also the number of columns and the largest digit
    grid: R * C -> Int                 // grid(r, c): the digit in cell (r, c) of the completed grid
}
theory T:V {
    // the size of the grid is the number of its rows
    size() = #{ r in R: 0 =< r }.
    // each cell holds a digit from 1 to the size of the grid
    ! r in R: ! c in C: 1 =< grid(r, c) & grid(r, c) =< size().
    // each row contains each digit once
    ! r in R: ! c1 in C: ! c2 in C: c1 ~= c2 => grid(r, c1) ~= grid(r, c2).
    // each column contains each digit once
    ! c in C: ! r1 in R: ! r2 in R: r1 ~= r2 => grid(r1, c) ~= grid(r2, c).
    // a digit that is given at the start is kept
    ! r in R: ! c in C: values(r, c) > 0 => grid(r, c) = values(r, c).
    // each inequality constraint is honoured: the cell at the first pair of entries is lower than the cell at the second
    ! k in K: ! r in R: ! c in C: ! r2 in R: ! c2 in C: (r + 1 = lt(k, 0) & c + 1 = lt(k, 1) & r2 + 1 = lt(k, 2) & c2 + 1 = lt(k, 3)) => grid(r, c) < grid(r2, c2).
}
procedure main() {
    pretty_print(model_expand(T, S, max=1))
}
