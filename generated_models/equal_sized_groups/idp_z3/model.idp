// equal_sized_groups: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// A sorted list of N elements is to be divided into K groups by choosing K-1 split points between the elements. Elements
// with the same value must stay in the same group, and each group holds at least one element. Find K groups as close in
// size to round(N/K) as possible, that is, minimize the total over the groups of the absolute difference between the
// size of the group and round(N/K). The answer is the list of the K-1 split points, each given as the number of elements
// before it.
//
// Save this file as model.idp. Download `equal_sized_groups.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/equal_sized_groups.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py equal_sized_groups.json
//   idp-engine model_1.idp

vocabulary V {
    type I <: Int                      // the elements of the sorted list, numbered from 0, sized from a
    type Range_k <: Int                // the groups, numbered 1 to k
    a: I -> Int                        // a(j): the value of element j of the sorted list
    k: () -> Int                       // the number of groups
    total: () -> Int                   // the number of elements N
    target: () -> Int                  // round(N / k): the size each group should have
    stop: Range_k -> Int               // stop(i): the number of elements up to the end of group i (the split point after group i)
    start: Range_k -> Int              // start(i): the number of elements before group i
    dev: Range_k -> Int                // dev(i): the absolute difference between the size of group i and the target size
    cut: I -> Bool                     // cut(j): a split point lies just before element j
    gap: Range_k -> Bool               // gap(i): i is one of the split points, which exist for groups 1 to k - 1
    x: Range_k -> Int (domain: gap)    // x(i): the split point after group i, the number of elements before it
    minimize: () -> Int                // the total difference between the group sizes and the target size
}

theory T:V {
    // the number of elements is the length of the list
    total() = #{ j in I }.

    // round(N / k) rounds half up: it is the whole part of N / k + 1 / 2
    target() = (2 * total() + k()) / (2 * k()).

    // the split point after group i is the number of elements before it, and the last group ends at the last element
    stop(k()) = total().

    // the first group starts at the first element, and each other group starts where the group before it ends
    start(1) = 0.
    ! i in Range_k: i ~= 1 => start(i) = stop(i - 1).

    // each group holds at least one element
    ! i in Range_k: stop(i) > start(i).

    // a split point never separates two elements of the same value: no split point lies just before element j
    // when element j - 1 has the same value as element j
    ! j in I: cut(j) <=> ?i in Range_k: i < k() & stop(i) = j.
    ! j in I: j ~= 0 & cut(j) => a(j - 1) ~= a(j).

    // the difference of each group is the absolute difference between its size and the target size
    ! i in Range_k: dev(i) = abs(stop(i) - start(i) - target()).

    // the total of the differences is to be minimized
    minimize() = sum{{ dev(i) | i in Range_k }}.

    // the split points are the groups 1 to k - 1
    { ! i in Range_k: gap(i) <- i < k(). }
    ! i in Range_k: gap(i) => x(i) = stop(i).
}

procedure main() {
    pretty_print(minimize(T, S, term="minimize()"))
}
