% csplib_001_car_sequencing: a Picat model from DCP Rosetta.
%
% A number of cars are to be produced; they are not identical, because different options are available as variants
% on the basic model. The assembly line has different stations which install the various options (air-conditioning,
% sunroof, etc.). These stations have been designed to handle at most a certain percentage of the cars passing along
% the assembly line. Furthermore, the cars requiring a certain option must not be bunched together, otherwise the
% station will not be able to cope. Consequently, the cars must be arranged in a sequence so that the capacity of
% each station is never exceeded. For example, if a particular station can only cope with at most half of the cars
% passing along the line, the sequence must be built so that at most 1 car in any 2 requires that option.
%
% Save this file as model.pi. Download `csplib_001_car_sequencing.json` and `dcp_convert_picat.py` from the
% problem's page:
%   https://dcp-bench.github.io/DCP-Rosetta/problems/csplib_001_car_sequencing.html
% Convert the instances once, then run the first one (Picat 3.9, https://picat-lang.org):
%   python dcp_convert_picat.py csplib_001_car_sequencing.json
%   picat model.pi csplib_001_car_sequencing_1.dat

% Data.get(at_most), Data.get(per_slots): for each option, the capacity p and the window length q of its station
% (lists, indexed from 1). Data.get(demand): the number of cars wanted of each type (list). Data.get(requires):
% Requires[t, o] = 1 when type t needs option o (list of lists).
import cp.

model(Data, Vars, Outputs, Options) =>
    AtMost = Data.get(at_most),        % capacity of the station of each option
    PerSlots = Data.get(per_slots),    % length of the window the capacity refers to
    Demand = Data.get(demand),         % number of cars wanted of each type
    Requires = Data.get(requires),     % Requires[t, o] = 1 if type t needs option o
    NCars = sum(Demand),               % one slot per car to produce
    NTypes = len(Demand),
    NOptions = len(AtMost),
    % Totals[o] = number of cars that need option o
    Totals = [sum([Demand[T] * Requires[T, O] : T in 1..NTypes]) : O in 1..NOptions],
    % Search order of the types, the hardest to place first: a type scores the sum, over
    % the options it needs, of the option's utilisation (proportional to Totals[o] * q / p; a station that
    % must work near its capacity is the tightest). Perm[r] = the type (from 1) of rank r.
    Sorted = sort_down([{sum([Requires[T, O] * Totals[O] * PerSlots[O] / AtMost[O] : O in 1..NOptions]), T} : T in 1..NTypes]),
    Perm = [Pair[2] : Pair in Sorted],
    % Seq[s] = the rank of the type of the car in slot s
    Seq = new_list(NCars),
    Seq :: 1..NTypes,
    % each car type is produced exactly as often as demanded
    foreach (R in 1..NTypes)
        count(R, Seq, #=, Demand[Perm[R]])
    end,
    % no option's station is overloaded: at most p of any q consecutive cars need option o
    foreach (O in 1..NOptions)
        P = AtMost[O],
        Q = PerSlots[O],
        % Total = number of cars that need option o
        Total = sum([Demand[T] * Requires[T, O] : T in 1..NTypes]),
        % Setup[s] = 1 if the car in slot s needs option o
        Setup = new_list(NCars),
        Setup :: 0..1,
        Column = [Requires[Perm[R], O] : R in 1..NTypes],
        foreach (S in 1..NCars)
            element(Seq[S], Column, Setup[S])
        end,
        % Count[s] = number of cars needing option o among the first s slots (Count[1] is for
        % s = 0). The first t slots hold at most floor(t / q) * p + min(p, t mod q) of them
        % (the capacity of the windows), and the last n - t slots hold the same at most, so
        % Count[t] lies between Total - cap(n - t) and cap(t): these bounds are implied.
        Count = new_list(NCars + 1),
        foreach (T0 in 0..NCars)
            Upper = min(Total, (T0 // Q) * P + min(P, T0 mod Q)),
            Rest = NCars - T0,
            Lower = max(0, Total - ((Rest // Q) * P + min(P, Rest mod Q))),
            Count[T0 + 1] :: Lower..Upper
        end,
        Count[1] #= 0,
        foreach (S in 1..NCars)
            Count[S + 1] #= Count[S] + Setup[S]
        end,
        % in every window of q consecutive slots, at most p cars need option o
        foreach (S in 0..NCars - Q)
            Count[S + Q + 1] - Count[S + 1] #=< P
        end
    end,
    % Sequence[s] = the type of the car in slot s, numbered from 0
    Sequence = new_list(NCars),
    Sequence :: 0..NTypes - 1,
    Types0 = [T - 1 : T in Perm],
    foreach (S in 1..NCars)
        element(Seq[S], Types0, Sequence[S])
    end,
    Vars = Seq,
    Outputs = [sequence = Sequence],
    Options = [].

main([File]) =>
    Fd = open(File),
    Term = read_term(Fd),
    Term = $json_object(Keys, Values),
    close(Fd),
    Data = new_map([K = V : {K, V} in zip(Keys, Values)]),
    model(Data, Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
