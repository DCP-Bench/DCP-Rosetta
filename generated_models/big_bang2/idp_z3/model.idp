// big_bang2: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Nontransitive dice: find a set of five dice such that the dominance relationships between the dice are isomorphic to
// the relationships in the game Rock-Paper-Scissors extended by Lizard and Spock. Each choice beats two other choices
// and is beaten by two others. The beats relationships are: Rock crushes Scissors and Lizard; Paper covers Rock and
// disproves Spock; Scissors cuts Paper and decapitates Lizard; Lizard eats Paper and poisons Spock; Spock vaporizes Rock
// and smashes Scissors. Each die has six integer faces, each face value between 1 and 12 inclusive, and face values may
// repeat within a die and across dice. A die A beats a die B when A has a strictly larger face value than B in more than
// half of all possible pairs of faces.
//
//   https://dcp-bench.github.io/DCP-Rosetta/problems/big_bang2.html
// Save this model as model.idp and run it (`pip install idp-engine`) with:
//   idp-engine model.idp

vocabulary V {
    type Die := {0..4}                 // the five dice: 0 Rock, 1 Paper, 2 Scissors, 3 Lizard, 4 Spock
    type Face := {0..5}                // the six faces of a die, numbered 0..5
    dice: Die * Face -> Int            // dice(d, f): the value of face f of die d, between 1 and 12 (the output)
    beats: Die * Die -> Bool           // beats(a, b): die a beats die b
}

theory T:V {
    // every face value is an integer between 1 and 12
    ! d in Die, f in Face: 1 =< dice(d, f) & dice(d, f) =< 12.
    // die a beats die b exactly when a has a larger face value than b in more than half of the 36 pairs of faces
    ! a, b in Die: beats(a, b) <=> #{ f, g in Face: dice(a, f) > dice(b, g) } * 2 > 36.
}

structure S2:V {
    // the beats relationships of the game: 0 Rock beats 2 and 3, 1 Paper beats 0 and 4, 2 Scissors beats 1 and 3,
    // 3 Lizard beats 1 and 4, 4 Spock beats 0 and 2
    beats := { (0,2), (0,3), (1,0), (1,4), (2,1), (2,3), (3,1), (3,4), (4,0), (4,2) }.
}

procedure main() {
    pretty_print(model_expand(T, S2, max=1))
}
