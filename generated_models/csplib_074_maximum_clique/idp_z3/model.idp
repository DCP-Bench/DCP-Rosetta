// csplib_074_maximum_clique: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Given a simple undirected graph G = (V, E), a clique is a subset of vertices where every two distinct vertices in the
// subset are adjacent (connected by an edge). Find a clique of the largest possible size in the graph.
//
// Save this file as model.idp. Download `csplib_074_maximum_clique.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/csplib_074_maximum_clique.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py csplib_074_maximum_clique.json
//   idp-engine model_1.idp
vocabulary V {
    type I <: Int                      // the vertices, numbered from 0, sized from adj
    adj: I * I -> Int                  // adj(i, j): 1 if vertices i and j are adjacent, 0 otherwise
    c: I -> Bool                       // c(i): vertex i is in the clique (declared output)
    maximize: () -> Int                // the number of vertices in the clique
}
theory T:V {
    // every two distinct vertices of the clique are adjacent
    ! i, j in I: (i ~= j & c(i) & c(j)) => adj(i, j) = 1.

    // the size of the clique is the number of its vertices
    maximize() = #{ i in I: c(i) }.
}
procedure main() {
    pretty_print(maximize(T, S, term="maximize()"))
}
