% csplib_006_golomb_rulers: a Picat model from DCP Rosetta.
%
% These problems are said to have many practical applications including sensor placements for x-ray
% crystallography and radio astronomy. A Golomb ruler may be defined as a set of m integers 0 = a_1 < a_2 < ... <
% a_m such that the m(m-1)/2 differences a_j - a_i, for 1 <= i < j <= m, are distinct. Such a ruler is said to
% contain m marks and is of length a_m. The objective is to find optimal (minimum length) rulers.
%
% Save this file as model.pi. Download `csplib_006_golomb_rulers.json` and `dcp_convert_picat.py` from the
% problem's page:
%   https://dcp-bench.github.io/DCP-Rosetta/problems/csplib_006_golomb_rulers.html
% Convert the instances once, then run the first one (Picat 3.9, https://picat-lang.org):
%   python dcp_convert_picat.py csplib_006_golomb_rulers.json
%   picat model.pi csplib_006_golomb_rulers_1.dat
%
% Data.get(size): the number m of marks.
import cp.

model(Data, Vars, Outputs, Options) =>
    M = Data.get(size),
    % Mark[K] = the position of mark K, the marks being numbered from 1 in increasing order
    Mark = new_list(M),
    Mark :: 0..M * M,                      % an optimal ruler is shorter than m * m, so this bound loses no optimum
    % the first mark is at 0
    Mark[1] #= 0,
    % the marks are in increasing order
    foreach (K in 1..M - 1)
        Mark[K] #< Mark[K + 1]
    end,
    % every pair of marks I < J gives a difference, and the differences are all distinct
    Pairs = [[I, J] : I in 1..M, J in I + 1..M],
    NumPairs = len(Pairs),
    Diff = new_list(NumPairs),
    Diff :: 1..M * M,
    foreach (P in 1..NumPairs)
        [I, J] = Pairs[P],
        Diff[P] #= Mark[J] - Mark[I]
    end,
    all_different(Diff),
    % the length of the ruler is the position of the last mark
    Length #= Mark[M],
    Vars = Mark,
    Outputs = [marks = Mark, length = Length],
    % minimize the length of the ruler
    Options = [$min(Length)].

main([File]) =>
    Fd = open(File),
    Term = read_term(Fd),
    Term = $json_object(Keys, Values),
    close(Fd),
    Data = new_map([K = V : {K, V} in zip(Keys, Values)]),
    model(Data, Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
