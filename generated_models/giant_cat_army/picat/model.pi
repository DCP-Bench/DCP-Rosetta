% giant_cat_army: a Picat model from DCP Rosetta.
%
% Start with [0] and build a list by repeatedly adding 5, adding 7, or taking the square root of the last
% number. The finished list has 24 numbers, all distinct integers of at most 60, and it ends with 14. It must
% contain 2, then later 10, then 14, with any other numbers allowed between them.
%
%   https://dcp-bench.github.io/DCP-Rosetta/problems/giant_cat_army.html
% Save this model as model.pi and run it (Picat 3.9, https://picat-lang.org) with:
%   picat model.pi
import cp.

% The riddle reads no data: its numbers are fixed in the model.
model(_Data, Vars, Outputs, Options) =>
    MaxValue = 60,                              % every number is at most 60
    Len = 24,                                   % the list has 24 numbers
    X = new_list(Len),                          % X[I] is the I-th number of the list
    X :: 0..MaxValue,                           % integers from 0 to 60
    % the list starts with 0 and ends with 14
    X[1] #= 0,
    X[Len] #= 14,
    % all the numbers are distinct
    all_distinct(X),
    % each number follows the one before it by adding 5, by adding 7, or by taking its square root
    Steps = [{V, W} : V in 0..MaxValue, W in 0..MaxValue,
             (W == V + 5 ; W == V + 7 ; W * W == V)],
    foreach (I in 1..Len-1)
        table_in({X[I], X[I + 1]}, Steps)
    end,
    % the list contains 2 and 10, with 2 before 10 (14 is already last)
    [P2, P10] :: 1..Len,
    element(P2, X, 2),
    element(P10, X, 10),
    P2 #< P10,
    Vars = X,
    Outputs = [x = X],
    Options = [].

main =>
    model(new_map(), Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
