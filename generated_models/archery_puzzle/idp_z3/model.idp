// archery_puzzle: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// How close can the young archer come to scoring a total of a target score using as many arrows as she pleases? The
// targets are given as a list of integers, and each may be hit any number of times. Her score is the sum of the values
// of all her hits, and the aim is to minimize the absolute difference between that score and the target score.
//
// Save this file as model.idp. Download `archery_puzzle.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/archery_puzzle.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py archery_puzzle.json
//   idp-engine model_1.idp
vocabulary V {
    type Target <: Int                 // the targets, numbered from 0
    target_score: () -> Int            // the score the archer aims for
    targets: Target -> Int             // targets(k): the value of a hit on target k
    hits: Target -> Int                // hits(k): the number of hits on target k
    score: () -> Int                   // the total of the values of all the hits
    minimize: () -> Int                // the absolute difference between the score and the target score
}
theory T:V {
    // the number of hits on each target is not negative
    ! k in Target: hits(k) >= 0.
    // the score is the total of the values of all the hits
    score() = sum{{ (targets(k) * hits(k)) | k in Target }}.
    // the objective is the absolute difference between the score and the target score
    minimize() = abs(score() - target_score()).
}
procedure main() {
    pretty_print(minimize(T, S, term="minimize()"))
}
