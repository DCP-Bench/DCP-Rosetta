// divisible_by_1_through_9: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Find a 10 digit number that uses each of the digits 0 to 9 exactly once and where the number formed by the first n
// digits of the number is divisible by n, for every n from 1 to 10. Read the digits from left to right: the first digit
// is divisible by 1, the first two digits form a number divisible by 2, and so on up to the whole number.
//
//   https://dcp-bench.github.io/DCP-Rosetta/problems/divisible_by_1_through_9.html
// Save this model as model.idp and run it (`pip install idp-engine`) with:
//   idp-engine model.idp

vocabulary V {
    type P := {1..10}                  // the positions of the digits, numbered from 1 (left to right)
    type D := {0..9}                   // a digit
    digits: P -> D                     // digits(i): the digit at position i of the number
    prefix: P -> Int                   // prefix(n): the number formed by the first n digits
}

theory T:V {
    // the ten digits are all different, so each digit from 0 to 9 is used exactly once
    ! i, j in P: i ~= j => digits(i) ~= digits(j).

    // the number formed by the first digit is that digit
    prefix(1) = digits(1).

    // the number formed by the first n digits (n above 1) is the number formed by the first n - 1 digits followed by digit n
    ! n in P: n ~= 1 => prefix(n) = 10 * prefix(n - 1) + digits(n).

    // the number formed by the first n digits is divisible by n
    ! n in P: prefix(n) % n = 0.
}

procedure main() {
    pretty_print(model_expand(T, max=1))
}
