% divisible_by_1_through_9: a Picat model from DCP Rosetta.
%
% Find a 10 digit number that uses each of the digits 0 to 9 exactly once and where the number formed by the
% first n digits of the number is divisible by n. Read the digits from left to right: in the number abcd, the
% number a is divisible by 1, the number ab by 2, the number abc by 3 and the entire number abcd by 4.
%
%   https://dcp-bench.github.io/DCP-Rosetta/problems/divisible_by_1_through_9.html
% Save this model as model.pi and run it (Picat 3.9, https://picat-lang.org) with:
%   picat model.pi
import cp.

model(_Data, Vars, Outputs, Options) =>
    Digits = new_list(10),                 % Digits[I] = the I-th digit from the left
    Digits :: 0..9,
    % each of the digits 0 to 9 is used exactly once
    all_distinct(Digits),
    % a 10 digit number does not start with 0
    Digits[1] #!= 0,
    % for each n from 1 to 10, the number formed by the first n digits is divisible by n
    foreach (N in 1..10)
        sum([Digits[I] * 10**(N - I) : I in 1..N]) mod N #= 0
    end,
    Vars = Digits,
    Outputs = [digits = Digits],
    % a satisfaction problem: no objective
    Options = [].

main =>
    model(new_map(), Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
