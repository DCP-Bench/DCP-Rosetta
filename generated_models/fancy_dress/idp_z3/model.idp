// fancy_dress: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Mr. Greenfan wants to give a dress party where the male guests must wear green dresses. The rules are: (1) if someone
// wears a green tie he has to wear a green shirt; (2) a guest who wears green socks or a green shirt must also wear a green
// tie or a green hat; (3) a guest wearing a green shirt or a green hat or who does not wear green socks must wear a green
// tie; (4) a guest who is not dressed according to rules 1-3 must pay an entrance fee of $11. Mr Greenguest wants to
// participate but already owns a green shirt, so the shirt costs nothing; he could buy a green tie for $10, a green hat
// (used) for $2 and green socks for $12. What is the cheapest way for Mr Greenguest to participate?
//
//   https://dcp-bench.github.io/DCP-Rosetta/problems/fancy_dress.html
// Save this model as model.idp and run it (`pip install idp-engine`) with:
//   idp-engine model.idp

vocabulary V {
    t: () -> Bool                      // the guest wears a green tie (bought for $10)
    h: () -> Bool                      // the guest wears a green hat (used, bought for $2)
    r: () -> Bool                      // the guest wears a green shirt (already owned, costs nothing)
    s: () -> Bool                      // the guest wears green socks (bought for $12)
    n: () -> Bool                      // the guest pays the $11 entrance fee
    minimize: () -> Int                // the total cost in dollars
}

theory T:V {
    // rule 1: a guest who wears a green tie has to wear a green shirt, or else pays the entrance fee (rule 4)
    (t() => r()) | n().

    // rule 2: a guest who wears green socks or a green shirt must also wear a green tie or a green hat, or else pays the fee (rule 4)
    ((s() | r()) => (t() | h())) | n().

    // rule 3: a guest wearing a green shirt or a green hat, or who does not wear green socks, must wear a green tie, or else pays the fee (rule 4)
    ((r() | h() | ~s()) => t()) | n().

    // the total cost is the cost of the tie, the hat and the socks, and the entrance fee if it is paid
    minimize() = (if t() then 10 else 0) + (if h() then 2 else 0) + (if s() then 12 else 0) + (if n() then 11 else 0).
}

procedure main() {
    pretty_print(minimize(T, term="minimize()"))
}
