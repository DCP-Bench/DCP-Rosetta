// csplib_057_killer_sudoku: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Killer sudoku: fill the grid with the numbers 1 to 9 so that each row, column and nonet (3 x 3 block) contains each
// number exactly once, the sum of all numbers in a cage matches the small number printed in its corner, and no number
// appears more than once in a cage (so no cage has more than 9 cells).
//
// Save this file as model.idp. Download `csplib_057_killer_sudoku.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/csplib_057_killer_sudoku.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py csplib_057_killer_sudoku.json
//   idp-engine model_1.idp
vocabulary V {
    type Range_n <: Int                // the rows, columns and numbers, 1..n
    n: () -> Int                       // the grid size (9)
    type Cage <: Int                   // the cages, numbered from 0, sized from the cage sums (problem_1)
    type Cell <: Int                   // the positions of a cell within a cage, numbered from 0 (padded to the longest cage)
    type Coord <: Int                  // 0 for the row, 1 for the column of a cell (0-based index into the pair)
    problem_1: Cage -> Int             // problem_1(i): the sum of the numbers in cage i
    problem_2: Cage * Cell * Coord -> Int  // problem_2(i, j, 0), problem_2(i, j, 1): row and column (1-based) of cell j of cage i
    problem_2_len: Cage -> Int         // problem_2_len(i): the number of cells in cage i (created by the conversion)
    in_cage: Cage * Range_n * Range_n -> Bool  // in_cage(i, r, c): cell (r, c) belongs to cage i
    x: Range_n * Range_n -> Range_n    // x(r, c): the number in row r, column c (declared output)
}
theory T:V {
    // a cell belongs to a cage when it is one of the cells listed for that cage
    { ! i in Cage, r in Range_n, c in Range_n: in_cage(i, r, c) <- ?j in Cell: j < problem_2_len(i) & problem_2(i, j, 0) = r & problem_2(i, j, 1) = c. }

    // the sum of all numbers in a cage matches the small number printed in its corner
    ! i in Cage: sum{{ x(r, c) | r in Range_n, c in Range_n: in_cage(i, r, c) }} = problem_1(i).

    // no number appears more than once in a cage
    ! i in Cage, d in Range_n: #{ r in Range_n, c in Range_n: in_cage(i, r, c) & x(r, c) = d } =< 1.

    // each row contains each number exactly once
    ! r in Range_n, c1, c2 in Range_n: c1 ~= c2 => x(r, c1) ~= x(r, c2).

    // each column contains each number exactly once
    ! c in Range_n, r1, r2 in Range_n: r1 ~= r2 => x(r1, c) ~= x(r2, c).

    // each nonet (3 x 3 block) contains each number exactly once
    ! r1, r2 in Range_n, c1, c2 in Range_n: ((r1 ~= r2 | c1 ~= c2) & (r1 - 1) / 3 = (r2 - 1) / 3 & (c1 - 1) / 3 = (c2 - 1) / 3) => x(r1, c1) ~= x(r2, c2).
}
procedure main() {
    pretty_print(model_expand(T, S, max=1))
}
