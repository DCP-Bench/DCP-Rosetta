% csplib_041_n_fractions: a Picat model from DCP Rosetta.
%
% Find distinct non-zero digits such that the following equation holds: A / BC + D / EF + G / HI = 1, where
% BC, EF and HI are two-digit numbers formed by B and C, E and F, and H and I, respectively.
%
%   https://dcp-bench.github.io/DCP-Rosetta/problems/csplib_041_n_fractions.html
% Save this model as model.pi and run it (Picat 3.9, https://picat-lang.org) with:
%   picat model.pi
%
% The puzzle has no data: the model is built from nothing.
import cp.

model(_Data, Vars, Outputs, Options) =>
    % the nine digits A..I, each from 1 to 9
    Digits = [A, B, C, D, E, F, G, H, I],
    Digits :: 1..9,
    % the nine digits are different
    all_different(Digits),
    % the two-digit numbers BC, EF and HI
    [BC, EF, HI] :: 11..99,
    BC #= 10 * B + C,
    EF #= 10 * E + F,
    HI #= 10 * H + I,
    % A/BC + D/EF + G/HI = 1, multiplied through by BC * EF * HI
    A * EF * HI + D * BC * HI + G * BC * EF #= BC * EF * HI,
    Vars = Digits,
    Outputs = ['A' = A, 'B' = B, 'C' = C, 'D' = D, 'E' = E, 'F' = F, 'G' = G, 'H' = H, 'I' = I],
    Options = [].

main =>
    model(new_map(), Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
