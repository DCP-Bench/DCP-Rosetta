// session3_people_in_a_room: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// There are 13 people. 4 of them are male. They randomly enter a room one at a time. Find a way that the males and
// females enter so that the ratio of females to males in the room at any one time is no greater than 7/3?
//
//   https://dcp-bench.github.io/DCP-Rosetta/problems/session3_people_in_a_room.html
// Save this model as model.idp and run it (`pip install idp-engine`) with:
//   idp-engine model.idp
vocabulary V {
    type Pos := {0..12}                // the 13 places in the order the people enter the room, numbered from 0
    sequence: Pos -> Bool              // sequence(p): the person entering at place p is female (false: male)
}
theory T:V {
    // there are 4 males among the 13 people
    #{ p in Pos: ~sequence(p) } = 4.

    // at any time, the number of females in the room is at most 7/3 of the number of males: 3 times the females
    // is at most 7 times the males, counted over everyone who has entered up to that time
    ! k in Pos: 3 * #{ p in Pos: sequence(p) & p =< k } =< 7 * #{ p in Pos: ~sequence(p) & p =< k }.
}
procedure main() {
    pretty_print(model_expand(T, max=1))
}
