% csplib_034_warehouse_location: a Picat model from DCP Rosetta.
%
% A company must decide which warehouses to open from a set of candidate locations to supply a set of
% stores. Each warehouse has a fixed maintenance cost and a capacity limiting the number of stores it can
% supply. Each store must be supplied by exactly one open warehouse, and there is an associated supply cost
% that varies depending on the store and warehouse. The objective is to minimise the total cost, which is the
% sum of the maintenance costs for all opened warehouses and the supply costs for all stores.
%
% Save this file as model.pi. Download `csplib_034_warehouse_location.json` and `dcp_convert_picat.py` from the
% problem's page:
%   https://dcp-bench.github.io/DCP-Rosetta/problems/csplib_034_warehouse_location.html
% Convert the instances once, then run the first one (Picat 3.9, https://picat-lang.org):
%   python dcp_convert_picat.py csplib_034_warehouse_location.json
%   picat model.pi csplib_034_warehouse_location_1.dat
%
% Data.get(n_suppliers): the number of candidate warehouses; Data.get(n_stores): the number of stores;
% Data.get(building_cost): the maintenance cost of an open warehouse; Data.get(capacity): the number of
% stores each warehouse can supply (lists, indexed from 1); Data.get(cost_matrix): the supply cost of each
% store from each warehouse, cost_matrix[store][warehouse] (a list of rows, indexed from 1).
import cp.

model(Data, Vars, Outputs, Options) =>
    NSuppliers = Data.get(n_suppliers),
    NStores = Data.get(n_stores),
    BuildingCost = Data.get(building_cost),
    Capacity = Data.get(capacity),
    CostMatrix = Data.get(cost_matrix),
    % Supplier[S] = the warehouse, numbered from 0, that supplies store S
    Supplier = new_list(NStores),
    Supplier :: 0..NSuppliers - 1,
    % Open[W] = 1 when the warehouse W, numbered from 1, is open
    Open = new_list(NSuppliers),
    Open :: 0..1,
    foreach (W in 1..NSuppliers)
        % the number of stores that warehouse W supplies
        Served #= sum([Supplier[S] #= W - 1 : S in 1..NStores]),
        % each warehouse supplies no more stores than its capacity
        Served #=< Capacity[W],
        % a warehouse is open exactly when it supplies some store
        Open[W] #<=> (Served #>= 1)
    end,
    % SupplyCost[S] = the cost of supplying store S from the warehouse that supplies it
    SupplyCost = new_list(NStores),
    foreach (S in 1..NStores)
        element0(Supplier[S], CostMatrix[S], SupplyCost[S])
    end,
    % the total cost: the supply costs of the stores plus the maintenance of the open warehouses
    TotalCost #= sum(SupplyCost) + BuildingCost * sum(Open),
    Vars = Supplier ++ Open,
    Outputs = [total_cost = TotalCost, open_warehouses = Open, supplier_assignment = Supplier],
    % minimise the total cost
    Options = [ff, $min(TotalCost)].

main([File]) =>
    Fd = open(File),
    Term = read_term(Fd),
    Term = $json_object(Keys, Values),
    close(Fd),
    Data = new_map([K = V : {K, V} in zip(Keys, Values)]),
    model(Data, Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
