% csplib_053_graceful_graphs: a Picat model from DCP Rosetta.
%
% A labelling f of the nodes of a graph with q edges is graceful if f assigns each node a unique label from
% {0, 1, ..., q} and, when each edge xy is labelled with |f(x) - f(y)|, the edge labels are all different.
% The problem is to find such a labelling for the graph.
%
% Save this file as model.pi. Download `csplib_053_graceful_graphs.json` and `dcp_convert_picat.py` from the
% problem's page:
%   https://dcp-bench.github.io/DCP-Rosetta/problems/csplib_053_graceful_graphs.html
% Convert the instances once, then run the first one (Picat 3.9, https://picat-lang.org):
%   python dcp_convert_picat.py csplib_053_graceful_graphs.json
%   picat model.pi csplib_053_graceful_graphs_1.dat
%
% Data.get(n): the number of nodes; Data.get(m): the number of edges q; Data.get(graph): the edges, one
% pair of node numbers per edge, graph[E][1] and graph[E][2] (a list of pairs, indexed from 1; the node
% numbers are 0-based, as in the data).
import sat.

model(Data, Vars, Outputs, Options) =>
    M = Data.get(m),
    N = Data.get(n),
    Graph = Data.get(graph),
    % Nodes[I] = the label of node I - 1, labels from 0 to M
    Nodes = new_list(N),
    Nodes :: 0..M,
    % Edges[E] = the label of edge E, the difference of the labels of its two ends, from 1 to M
    Edges = new_list(M),
    Edges :: 1..M,
    % each node has a unique label
    all_different(Nodes),
    % the edge labels are all different
    all_different(Edges),
    % an edge is labelled with the absolute difference of the labels of its two ends
    foreach (E in 1..M)
        U = Graph[E, 1] + 1,
        V = Graph[E, 2] + 1,
        Edges[E] #= abs(Nodes[U] - Nodes[V])
    end,
    Vars = Nodes ++ Edges,
    Outputs = [nodes = Nodes, edges = Edges],
    Options = [].

main([File]) =>
    Fd = open(File),
    Term = read_term(Fd),
    Term = $json_object(Keys, Values),
    close(Fd),
    Data = new_map([K = V : {K, V} in zip(Keys, Values)]),
    model(Data, Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
