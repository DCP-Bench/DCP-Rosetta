// multi: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// This is a multi-commodity transportation problem. Given a set of origins, a set of destinations, and a set of
// products. Each origin i has a certain supply of each product p, and each destination j has a certain demand for each
// product p. The cost of shipping one unit of product p from origin i to destination j is ShippingCost(i, j, p). The
// problem aims to minimize the total cost of shipping all products from the origins to the destinations.
//
// Save this file as model.idp. Download `multi.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/multi.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py multi.json
//   idp-engine model_1.idp
vocabulary V {
    type Origin <: Int                 // the origins, numbered from 0, sized from supply
    type Dest <: Int                   // the destinations, numbered from 0, sized from demand
    type Product <: Int                // the products, numbered from 0, sized from supply
    supply: Origin * Product -> Int    // supply(i, p): units of product p available at origin i
    demand: Dest * Product -> Int      // demand(j, p): units of product p needed at destination j
    limit: Origin * Dest -> Int        // limit(i, j): the most units, of all products together, shipped from origin i to destination j
    cost: Origin * Dest * Product -> Int   // cost(i, j, p): the cost of shipping one unit of product p from origin i to destination j
    ship: Origin * Dest * Product -> Int   // ship(i, j, p): the units of product p shipped from origin i to destination j
    total_cost: () -> Int              // the total cost of all the shipments
    minimize: () -> Int                // the total cost of all the shipments, to minimize
}
theory T:V {
    // every shipment is a whole number of units, not negative
    ! i in Origin, j in Dest, p in Product: ship(i, j, p) >= 0.
    // the units of a product shipped out of an origin do not exceed its supply
    ! i in Origin, p in Product: sum{{ ship(i, j, p) | j in Dest }} =< supply(i, p).
    // each destination receives exactly its demand of each product
    ! j in Dest, p in Product: sum{{ ship(i, j, p) | i in Origin }} = demand(j, p).
    // the units of all products shipped from an origin to a destination do not exceed the limit of that lane
    ! i in Origin, j in Dest: sum{{ ship(i, j, p) | p in Product }} =< limit(i, j).
    // the total cost is the cost of all the shipments
    total_cost() = sum{{ (cost(i, j, p) * ship(i, j, p)) | i in Origin, j in Dest, p in Product }}.
    // the total shipping cost is minimized
    minimize() = total_cost().
}
procedure main() {
    pretty_print(minimize(T, S, term="minimize()"))
}
