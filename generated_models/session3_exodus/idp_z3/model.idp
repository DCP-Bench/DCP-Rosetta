// session3_exodus: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// In preparation for Passover, five children at Hebrew school (Bernice, Carl, Debby, Sammy, and Ted) have been chosen to
// present different parts of the story of the Exodus from Egypt (burning bush, captivity, Moses's youth, Passover, or
// the Ten Commandments). Each child is a different age (three, five, seven, eight, or ten), and the family of each child
// has recently made its own exodus to America from a different country (Ethiopia, Kazakhstan, Lithuania, Morocco, or
// Yemen). Can you find the age of each child, his or her family's country of origin, and the part of the Exodus story
// each related?
// 1. Debby's family is from Lithuania.
// 2. The child who told the story of the Passover is two years older than Bernice.
// 3. The child whose family is from Yemen is younger than the child from the Ethiopian family.
// 4. The child from the Moroccan family is three years older than Ted.
// 5. Sammy is three years older than the child who told the story of Moses's youth in the house of the Pharaoh.
// Determine the association: Age-Child-Country-Story.
//
//   https://dcp-bench.github.io/DCP-Rosetta/problems/session3_exodus.html
// Save this model as model.idp and run it (`pip install idp-engine`) with:
//   idp-engine model.idp
vocabulary V {
    type Child := {0..4}               // the children in the order Bernice, Carl, Debby, Sammy, Ted: 0 to 4
    type Age := {0..4}                 // the ages in the order three, five, seven, eight, ten: 0 to 4
    type Country := {0..4}             // the countries in the order Ethiopia, Kazakhstan, Lithuania, Morocco, Yemen: 0 to 4
    type Story := {0..4}               // the parts of the story in the order burning bush, captivity, Moses's youth, Passover, Ten Commandments: 0 to 4
    type Bundle := {1..5}              // the numbers 1 to 5 that tie together the child, age, country and story of one family
    years: Age -> Int                  // years(a): the age in years of age a
    children: Child -> Bundle          // children(c): the number of the bundle of child c
    ages: Age -> Bundle                // ages(a): the number of the bundle of age a
    countries: Country -> Bundle       // countries(k): the number of the bundle of country k
    stories: Story -> Bundle           // stories(s): the number of the bundle of story part s
    age_of: Bundle -> Age              // age_of(b): the age of the bundle b (auxiliary)
    country_of: Bundle -> Country      // country_of(b): the country of the bundle b (auxiliary)
    story_of: Bundle -> Story          // story_of(b): the story part of the bundle b (auxiliary)
}
theory T:V {
    // the ages in years are three, five, seven, eight and ten
    years(0) = 3.
    years(1) = 5.
    years(2) = 7.
    years(3) = 8.
    years(4) = 10.
    // each category gives five different bundle numbers
    ! a1 in Age: ! a2 in Age: ages(a1) = ages(a2) => a1 = a2.
    ! k1 in Country: ! k2 in Country: countries(k1) = countries(k2) => k1 = k2.
    ! s1 in Story: ! s2 in Story: stories(s1) = stories(s2) => s1 = s2.
    ! c1 in Child: ! c2 in Child: children(c1) = children(c2) => c1 = c2.
    // the age, country and story of each bundle are those of the entries carrying its number
    ! b in Bundle: ages(age_of(b)) = b.
    ! b in Bundle: countries(country_of(b)) = b.
    ! b in Bundle: stories(story_of(b)) = b.
    // Debby's family is from Lithuania
    countries(2) = children(2).
    // the child who told the story of the Passover is two years older than Bernice
    years(age_of(stories(3))) = years(age_of(children(0))) + 2.
    // the child whose family is from Yemen is younger than the child from the Ethiopian family
    years(age_of(countries(4))) < years(age_of(countries(0))).
    // the child from the Moroccan family is three years older than Ted
    years(age_of(countries(3))) = years(age_of(children(4))) + 3.
    // Sammy is three years older than the child who told the story of Moses's youth
    years(age_of(children(3))) = years(age_of(stories(2))) + 3.
}
procedure main() {
    pretty_print(model_expand(T, max=1))
}
