// session1_thick_as_thieves: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Following a robbery at Sparkles the Jeweller's, Inspector Korner of the Yard interviewed six of the usual suspects.
// He knew that the getaway car had been barely big enough to hold two, so he reckoned that at least four of them were
// innocent - but which ones? He also supposed that the innocent ones would tell the truth, while the guilty one or ones
// would lie. What they actually said was:
// - ARTIE: "It wasn't me."
// - BILL: "Crackitt was in it up to his neck."
// - CRACKITT: "No I wasn't."
// - DODGY: "If Crackitt did it, Bill did it with him."
// - EDGY: "Nobody did it alone."
// - FINGERS: "That's right: it was Artie and Dodgy together."
// If the good inspector's suppositions were correct, who is guilty?
//
//   https://dcp-bench.github.io/DCP-Rosetta/problems/session1_thick_as_thieves.html
// Save this model as model.idp and run it (`pip install idp-engine`) with:
//   idp-engine model.idp
vocabulary V {
    type Suspect := {1..6}             // the six suspects in the order Artie, Bill, Crackitt, Dodgy, Edgy, Fingers: 1 to 6
    artie: () -> Bool                  // Artie is guilty
    bill: () -> Bool                   // Bill is guilty
    crackitt: () -> Bool               // Crackitt is guilty
    dodgy: () -> Bool                  // Dodgy is guilty
    edgy: () -> Bool                   // Edgy is guilty
    fingers: () -> Bool                // Fingers is guilty
    guilty: Suspect -> Bool            // guilty(s): suspect s is guilty
}
theory T:V {
    // suspect s is guilty exactly when the named suspect is guilty
    guilty(1) <=> artie().
    guilty(2) <=> bill().
    guilty(3) <=> crackitt().
    guilty(4) <=> dodgy().
    guilty(5) <=> edgy().
    guilty(6) <=> fingers().
    // at least four of the suspects are innocent, so at most two are guilty
    #{ s in Suspect: guilty(s) } =< 2.
    // Artie says "It wasn't me.": his statement is true exactly when he is innocent
    ~artie() <=> ~artie().
    // Bill says "Crackitt was in it up to his neck.": his statement is true exactly when he is innocent
    crackitt() <=> ~bill().
    // Crackitt says "No I wasn't.": his statement is true exactly when he is innocent
    ~crackitt() <=> ~crackitt().
    // Dodgy says "If Crackitt did it, Bill did it with him.": his statement is true exactly when he is innocent
    (crackitt() => bill()) <=> ~dodgy().
    // Edgy says "Nobody did it alone.": his statement is true exactly when he is innocent
    (#{ s in Suspect: guilty(s) } ~= 1) <=> ~edgy().
    // Fingers says "it was Artie and Dodgy together.": his statement is true exactly when he is innocent
    (artie() & dodgy() & #{ s in Suspect: guilty(s) } = 2) <=> ~fingers().
}
procedure main() {
    pretty_print(model_expand(T, max=1))
}
