// cur_num: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// The number 48 has this peculiarity: if you add 1 to it the result is a square number, and if you add 1 to its half
// you also get a square number. Find another number with this peculiarity, between 1 and 10000.
//
//   https://dcp-bench.github.io/DCP-Rosetta/problems/cur_num.html
// Save this model as model.idp and run it (`pip install idp-engine`) with:
//   idp-engine model.idp
vocabulary V {
    type Peculiar := {1..10000}        // the candidate numbers, between 1 and 10000
    type Root := {1..101}              // roots k of the square numbers up to 10001
    peculiar: () -> Peculiar           // the number with the peculiarity (declared output)
}
theory T:V {
    // the number is not 48, the number given as the example
    peculiar() ~= 48.

    // adding 1 to the number gives a square number
    ? k in Root: k * k = peculiar() + 1.

    // the number is even, so that its half is a whole number
    2 * (peculiar() / 2) = peculiar().

    // adding 1 to the half of the number gives a square number
    ? q in Root: q * q = peculiar() / 2 + 1.
}
procedure main() {
    pretty_print(model_expand(T, max=1))
}
