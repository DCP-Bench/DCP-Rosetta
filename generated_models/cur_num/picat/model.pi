% cur_num: a Picat model from DCP Rosetta.
%
% The number 48 has this peculiarity: if you add 1 to it the result is a square number, and if you add 1
% to its half you also get a square number. Find another number between 1 and 10000 with this peculiarity.
%
%   https://dcp-bench.github.io/DCP-Rosetta/problems/cur_num.html
% Save this model as model.pi and run it (Picat 3.9, https://picat-lang.org) with:
%   picat model.pi

% The data is empty: the model takes no instance fields.
import cp.

model(_Data, Vars, Outputs, Options) =>
    Max = 10000,                          % the number lies between 1 and Max
    X :: 1..Max,                          % the number
    X #!= 48,                             % another number than 48
    % its half is a whole number, so the number is even
    H :: 1..(Max // 2),                         % its half
    X #= 2 * H,
    % adding 1 to the number gives a square number
    Y :: 1..to_int(sqrt(Max + 1)),
    Y * Y #= X + 1,
    % adding 1 to its half gives a square number
    T :: 1..to_int(sqrt(Max + 1)),
    T * T #= H + 1,
    Vars = [X],
    Outputs = [peculiar = X],
    Options = [].                         % satisfaction: no objective

main =>
    model(new_map(), Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
