% coins_grid: a Picat model from DCP Rosetta.
%
% In a quadratic grid (or a larger chessboard) n by n, place coins so that:
%   1. in each row exactly c coins are placed;
%   2. in each column exactly c coins are placed;
%   3. the sum of the quadratic horizontal distance from the main diagonal of all cells containing a
%      coin is as small as possible; for a coin in row i and column j this distance is (i - j)^2;
%   4. in each cell at most one coin is placed.
%
% Save this file as model.pi. Download `coins_grid.json` and `dcp_convert_picat.py` from the
% problem's page:
%   https://dcp-bench.github.io/DCP-Rosetta/problems/coins_grid.html
% Convert the instances once, then run the first one (Picat 3.9, https://picat-lang.org):
%   python dcp_convert_picat.py coins_grid.json
%   picat model.pi coins_grid_1.dat
%
% Data.get(n): the size of the grid; Data.get(c): the number of coins in each row and each column.
import cp.

model(Data, Vars, Outputs, Options) =>
    N = Data.get(n),
    C = Data.get(c),
    X = new_array(N, N),
    X :: 0..1,                             % X[I,J] = 1 when a coin is placed in row I, column J
    foreach (I in 1..N)
        % in each row exactly c coins are placed
        sum([X[I,J] : J in 1..N]) #= C
    end,
    foreach (J in 1..N)
        % in each column exactly c coins are placed
        sum([X[I,J] : I in 1..N]) #= C
    end,
    % the sum of the quadratic horizontal distances from the main diagonal of the coins placed
    Z #= sum([(I - J) * (I - J) * X[I,J] : I in 1..N, J in 1..N]),
    Vars = X,
    Outputs = [x = X, z = Z],
    % minimize the sum of the quadratic horizontal distances from the main diagonal
    Options = [$min(Z)].

main([File]) =>
    Fd = open(File),
    Term = read_term(Fd),
    Term = $json_object(Keys, Values),
    close(Fd),
    Data = new_map([K = V : {K, V} in zip(Keys, Values)]),
    model(Data, Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
