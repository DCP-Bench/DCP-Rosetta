// coins_grid: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// In a quadratic grid (or a larger chessboard) n by n, one should place coins in such a way that the following
// conditions are fulfilled: 1. In each row exactly c coins must be placed. 2. In each column exactly c coins must be
// placed. 3. The sum of the quadratic horizontal distance from the main diagonal of all cells containing a coin must be
// as small as possible. For a coin in row i and column j, this distance is (i - j)^2. 4. In each cell at most one coin
// can be placed.
//
// Save this file as model.idp. Download `coins_grid.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/coins_grid.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py coins_grid.json
//   idp-engine model_1.idp
vocabulary V {
    type Range_n <: Int                        // the rows and the columns of the grid, numbered from 1 to n
    n: () -> Int                               // the size of the grid: n rows and n columns
    c: () -> Int                               // the number of coins in each row and in each column
    type Bit := {0..1}                         // 1 if a coin is placed in a cell, 0 if not
    x: Range_n * Range_n -> Bit                // x(i, j): 1 if a coin is placed in row i, column j, else 0
    dist: Range_n * Range_n -> Int             // dist(i, j): the quadratic horizontal distance (i - j)^2 of cell (i, j) from the main diagonal (auxiliary)
    z: () -> Int                               // the sum of the quadratic distances of the cells containing a coin
    minimize: () -> Int                        // the sum of the quadratic distances of the cells containing a coin, to minimize
}
theory T:V {
    // the quadratic distance of cell (i, j) from the main diagonal is (i - j)^2
    ! i in Range_n, j in Range_n: dist(i, j) = (i - j) * (i - j).
    // in each row exactly c coins are placed
    ! i in Range_n: #{j in Range_n: x(i, j) = 1} = c().
    // in each column exactly c coins are placed
    ! j in Range_n: #{i in Range_n: x(i, j) = 1} = c().
    // the sum of the quadratic distances from the main diagonal of all cells containing a coin
    z() = sum{{ dist(i, j) | i in Range_n, j in Range_n: x(i, j) = 1 }}.
    // the value to minimize is that sum
    minimize() = z().
}
procedure main() {
    pretty_print(minimize(T, S, term="minimize()"))
}
