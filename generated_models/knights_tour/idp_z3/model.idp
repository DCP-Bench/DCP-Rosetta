// knights_tour: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// A knight's tour is a sequence of moves of a knight on a chessboard such that the knight visits every square exactly
// once (without returning to the starting square). The objective is to find a knight's tour on a chessboard. The tour
// is represented by integers from 0 to n*n-1, where n is the size of the chessboard.
//
// Save this file as model.idp. Download `knights_tour.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/knights_tour.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py knights_tour.json
//   idp-engine model_1.idp
vocabulary V {
    n: () -> Int                       // the size of the chessboard: n rows and n columns
    type Range_n <: Int                // the rows and the columns of the chessboard, numbered from 1 to n
    x: Range_n * Range_n -> Int        // x(r, c): the move number of the knight on the square (r, c), from 0 to n*n-1
}
theory T:V {
    // every square holds a move number from 0 to n*n-1
    ! r in Range_n: ! c in Range_n: 0 =< x(r, c) & x(r, c) =< n() * n() - 1.
    // every square is visited exactly once: different squares hold different move numbers
    ! r1 in Range_n: ! c1 in Range_n: ! r2 in Range_n: ! c2 in Range_n: (r1 ~= r2 | c1 ~= c2) => x(r1, c1) ~= x(r2, c2).
    // each move after the first is a knight move from the square holding the previous move number
    ! r1 in Range_n: ! c1 in Range_n: x(r1, c1) < n() * n() - 1 => ? r2 in Range_n: ? c2 in Range_n:
        x(r2, c2) = x(r1, c1) + 1 &
        ((r2 = r1 + 1 | r1 = r2 + 1) & (c2 = c1 + 2 | c1 = c2 + 2) | (r2 = r1 + 2 | r1 = r2 + 2) & (c2 = c1 + 1 | c1 = c2 + 1)).
}
procedure main() {
    pretty_print(model_expand(T, S, max=1))
}
