% knights_tour: a Picat model from DCP Rosetta.
%
% Find a sequence of moves of a knight on an N x N chessboard such that the knight visits every
% square exactly once, without returning to its starting square. The move numbers run from 0 to
% N*N-1, the number of a square being the move on which the knight arrives there.
%
% Save this file as model.pi. Download `knights_tour.json` and `dcp_convert_picat.py` from the
% problem's page:
%   https://dcp-bench.github.io/DCP-Rosetta/problems/knights_tour.html
% Convert the instances once, then run the first one (Picat 3.9, https://picat-lang.org):
%   python dcp_convert_picat.py knights_tour.json
%   picat model.pi knights_tour_1.dat
%
% Data.get(n): the size N of the chessboard (N rows and N columns).
import cp.

model(Data, Vars, Outputs, Options) =>
    N = Data.get(n),                       % the size of the chessboard
    NN = N * N,                            % the number of squares
    % squares are numbered row by row: square (R, C) is number (R-1)*N + C
    Dummy = NN + 1,                        % an extra node that closes the path into a cycle
    % Succ[S] = the square the knight moves to from square S, or Dummy when S is the last square
    % (Succ[Dummy] is the starting square)
    Succ = new_list(NN + 1),
    Succ :: 1..NN + 1,
    circuit(Succ),                         % the moves form one cycle through all squares
    Moves = [{1, 2}, {2, 1}, {-1, 2}, {-2, 1}, {1, -2}, {2, -1}, {-1, -2}, {-2, -1}],
    foreach (R in 1..N, C in 1..N)
        S = (R - 1) * N + C,
        % from a square the knight moves to a square a knight's move away, or ends the tour
        Nbs = [(R + DR - 1) * N + C + DC : {DR, DC} in Moves,
               R + DR >= 1, R + DR =< N, C + DC >= 1, C + DC =< N],
        Succ[S] :: [Dummy | Nbs]
    end,
    Succ[Dummy] :: 1..NN,
    % Pos[S] = the move number of square S
    Pos = new_list(NN + 1),
    Pos :: 0..NN - 1,
    all_different([Pos[S] : S in 1..NN]),
    % the starting square is move 0
    element(Succ[Dummy], Pos, 0),
    foreach (S in 1..NN)
        % the move number of the square the knight moves to next
        NextPos :: 0..NN - 1,
        element(Succ[S], Pos, NextPos),
        % the last square is move NN-1
        (Succ[S] #= Dummy) #=> (Pos[S] #= NN - 1),
        % otherwise the square the knight moves to next has the next move number
        (Succ[S] #!= Dummy) #=> (NextPos #= Pos[S] + 1)
    end,
    % X[R, C] = the move number of the square in row R, column C
    X = new_array(N, N),
    foreach (R in 1..N, C in 1..N)
        X[R, C] #= Pos[(R - 1) * N + C]
    end,
    Vars = [Succ, Pos],
    Outputs = [x = X],
    Options = [ff].                        % label the most constrained square first

main([File]) =>
    Fd = open(File),
    Term = read_term(Fd),
    Term = $json_object(Keys, Values),
    close(Fd),
    Data = new_map([K = V : {K, V} in zip(Keys, Values)]),
    model(Data, Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
