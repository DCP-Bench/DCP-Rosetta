// session2_subsets_100: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Out of a set of integers, you are given a list of different integers. From this set A of integers you can always find
// two disjoint non-empty subsets, S and T, such that the sum of elements in S equals the sum of elements in T. Note:
// S union T does not need to be all the elements of A. Find sets S and T for the given set A.
//
// Save this file as model.idp. Download `session2_subsets_100.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/session2_subsets_100.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py session2_subsets_100.json
//   idp-engine model_1.idp
vocabulary V {
    type Elem <: Int                   // the elements of A, numbered from 0
    A: Elem -> Int                     // A(i): the i-th integer of the set
    in_S: Elem -> Bool                 // in_S(i): element i is in the subset S
    in_T: Elem -> Bool                 // in_T(i): element i is in the subset T
}
theory T:V {
    // S is not empty
    ?i in Elem: in_S(i).
    // T is not empty
    ?i in Elem: in_T(i).
    // S and T are disjoint
    ! i in Elem: ~(in_S(i) & in_T(i)).
    // the sum of the elements of S equals the sum of the elements of T
    sum{{ A(i) | i in Elem: in_S(i) }} = sum{{ A(i) | i in Elem: in_T(i) }}.
}
procedure main() {
    pretty_print(model_expand(T, S, max=1))
}
