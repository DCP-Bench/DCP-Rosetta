// crossword: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Complete a crossword puzzle on a 5 by 5 grid with black cells. The numbered entries 1 to 8 are the words that start at
// those numbers, across or down: entry 1 is across in the top row, entry 2 is down from the top of column 3, entry 3 is
// down from the top of column 5, entry 4 is across in row 3, entry 5 is down from row 3 of column 4, entry 6 is down from
// row 4 of column 1, entry 7 is across in row 4 from column 3, and entry 8 is across in row 5. Given the list of 15 words
// AFT, ALE, EEL, HEEL, HIKE, HOSES, KEEL, KNOT, LASER, LEE, LINE, SAILS, SHEET, STEER, TIE, select 8 words, one for each
// numbered entry, so that every word has the length of its entry, no word is used twice, and the letters where two
// entries cross agree.
//
//   https://dcp-bench.github.io/DCP-Rosetta/problems/crossword.html
// Save this model as model.idp and run it (`pip install idp-engine`) with:
//   idp-engine model.idp

vocabulary V {
    type Slot := {1..8}                 // the numbered entries of the grid, numbered 1 to 8
    type Word := {0..14}                // the 15 given words, numbered from 0: longest first, then alphabetically
    type Pos := {1..5}                  // letter positions within a word, numbered from 1
    type Letter := {0..26}              // letter codes: A = 1 up to Z = 26, 0 = no letter (beyond the word's length)
    E: Slot -> Word                     // E(s): the word chosen for the numbered entry s (0-based word number)
    letter: Word * Pos -> Letter        // letter(w, p): the letter code at position p of word w
    wl: Word -> Int                     // wl(w): the number of letters of word w
    sl: Slot -> Int                     // sl(s): the number of cells of the numbered entry s
}

theory T:V {
    // the lengths of the words: the five-letter words are 0 to 4, the four-letter words 5 to 9, the three-letter words 10 to 14
    wl(0) = 5. wl(1) = 5. wl(2) = 5. wl(3) = 5. wl(4) = 5.
    wl(5) = 4. wl(6) = 4. wl(7) = 4. wl(8) = 4. wl(9) = 4.
    wl(10) = 3. wl(11) = 3. wl(12) = 3. wl(13) = 3. wl(14) = 3.

    // the letters of the five-letter words: HOSES, LASER, SAILS, SHEET, STEER
    letter(0,1) = 8. letter(0,2) = 15. letter(0,3) = 19. letter(0,4) = 5. letter(0,5) = 19.
    letter(1,1) = 12. letter(1,2) = 1. letter(1,3) = 19. letter(1,4) = 5. letter(1,5) = 18.
    letter(2,1) = 19. letter(2,2) = 1. letter(2,3) = 9. letter(2,4) = 12. letter(2,5) = 19.
    letter(3,1) = 19. letter(3,2) = 8. letter(3,3) = 5. letter(3,4) = 5. letter(3,5) = 20.
    letter(4,1) = 19. letter(4,2) = 20. letter(4,3) = 5. letter(4,4) = 5. letter(4,5) = 18.
    // the letters of the four-letter words: HEEL, HIKE, KEEL, KNOT, LINE
    letter(5,1) = 8. letter(5,2) = 5. letter(5,3) = 5. letter(5,4) = 12. letter(5,5) = 0.
    letter(6,1) = 8. letter(6,2) = 9. letter(6,3) = 11. letter(6,4) = 5. letter(6,5) = 0.
    letter(7,1) = 11. letter(7,2) = 5. letter(7,3) = 5. letter(7,4) = 12. letter(7,5) = 0.
    letter(8,1) = 11. letter(8,2) = 14. letter(8,3) = 15. letter(8,4) = 20. letter(8,5) = 0.
    letter(9,1) = 12. letter(9,2) = 9. letter(9,3) = 14. letter(9,4) = 5. letter(9,5) = 0.
    // the letters of the three-letter words: AFT, ALE, EEL, LEE, TIE
    letter(10,1) = 1. letter(10,2) = 6. letter(10,3) = 20. letter(10,4) = 0. letter(10,5) = 0.
    letter(11,1) = 1. letter(11,2) = 12. letter(11,3) = 5. letter(11,4) = 0. letter(11,5) = 0.
    letter(12,1) = 5. letter(12,2) = 5. letter(12,3) = 12. letter(12,4) = 0. letter(12,5) = 0.
    letter(13,1) = 12. letter(13,2) = 5. letter(13,3) = 5. letter(13,4) = 0. letter(13,5) = 0.
    letter(14,1) = 20. letter(14,2) = 9. letter(14,3) = 5. letter(14,4) = 0. letter(14,5) = 0.

    // the number of cells of each entry: entries 1, 2, 3, 8 have five cells, entries 4, 5 have four, entries 6, 7 have three
    sl(1) = 5. sl(2) = 5. sl(3) = 5. sl(4) = 4. sl(5) = 4. sl(6) = 3. sl(7) = 3. sl(8) = 5.

    // each numbered entry is filled by a word of its own length
    ! s in Slot: wl(E(s)) = sl(s).

    // no word is used for two entries: the 8 selected words are different
    ! s, t in Slot: s ~= t => E(s) ~= E(t).

    // entry 1 across and entry 2 down cross at the top row, column 3: the 3rd letter of 1 is the 1st letter of 2
    letter(E(1), 3) = letter(E(2), 1).
    // entry 1 across and entry 3 down cross at the top row, column 5: the 5th letter of 1 is the 1st letter of 3
    letter(E(1), 5) = letter(E(3), 1).
    // entry 2 down and entry 4 across cross at row 3, column 3: the 3rd letter of 2 is the 2nd letter of 4
    letter(E(2), 3) = letter(E(4), 2).
    // entry 4 across and entry 5 down cross at row 3, column 4: the 3rd letter of 4 is the 1st letter of 5
    letter(E(4), 3) = letter(E(5), 1).
    // entry 3 down and entry 4 across cross at row 3, column 5: the 3rd letter of 3 is the 4th letter of 4
    letter(E(3), 3) = letter(E(4), 4).
    // entry 2 down and entry 7 across cross at row 4, column 3: the 4th letter of 2 is the 1st letter of 7
    letter(E(2), 4) = letter(E(7), 1).
    // entry 5 down and entry 7 across cross at row 4, column 4: the 2nd letter of 5 is the 2nd letter of 7
    letter(E(5), 2) = letter(E(7), 2).
    // entry 3 down and entry 7 across cross at row 4, column 5: the 4th letter of 3 is the 3rd letter of 7
    letter(E(3), 4) = letter(E(7), 3).
    // entry 6 down and entry 8 across cross at row 5, column 1: the 2nd letter of 6 is the 1st letter of 8
    letter(E(6), 2) = letter(E(8), 1).
    // entry 2 down and entry 8 across cross at row 5, column 3: the 5th letter of 2 is the 3rd letter of 8
    letter(E(2), 5) = letter(E(8), 3).
    // entry 5 down and entry 8 across cross at row 5, column 4: the 3rd letter of 5 is the 4th letter of 8
    letter(E(5), 3) = letter(E(8), 4).
    // entry 3 down and entry 8 across cross at row 5, column 5: the 5th letter of 3 is the 5th letter of 8
    letter(E(3), 5) = letter(E(8), 5).
}

procedure main() {
    pretty_print(model_expand(T, max=1))
}
