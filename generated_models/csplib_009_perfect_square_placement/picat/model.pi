% csplib_009_perfect_square_placement: a Picat model from DCP Rosetta.
%
% The perfect square placement problem (also called the squared square problem) is to pack a set of squares
% with given integer sizes into a bigger square in such a way that no squares overlap each other and all square
% borders are parallel to the border of the big square. The sum of the square surfaces is equal to the surface
% of the packing square, so that there is no spare capacity.
%
% Save this file as model.pi. Download `csplib_009_perfect_square_placement.json` and `dcp_convert_picat.py` from the
% problem's page:
%   https://dcp-bench.github.io/DCP-Rosetta/problems/csplib_009_perfect_square_placement.html
% Convert the instances once, then run the first one (Picat 3.9, https://picat-lang.org):
%   python dcp_convert_picat.py csplib_009_perfect_square_placement.json
%   picat model.pi csplib_009_perfect_square_placement_1.dat
%
% Data.get(base): the side of the big square; Data.get(sides): the side of each square (lists indexed from 1).
import cp.

model(Data, Vars, Outputs, Options) =>
    Base = Data.get(base),
    Sides = Data.get(sides),
    N = len(Sides),                        % the number of squares
    % X[I], Y[I] = the coordinates of the lower left corner of square I, from 0
    X = new_list(N),
    Y = new_list(N),
    X :: 0..Base - 1,
    Y :: 0..Base - 1,
    foreach (I in 1..N)
        % every square lies inside the big square
        X[I] + Sides[I] #=< Base,
        Y[I] + Sides[I] #=< Base
    end,
    % no two squares overlap: one lies to the left of, to the right of, below or above the other
    foreach (I in 1..N - 1, J in I + 1..N)
        (X[I] + Sides[I] #=< X[J]) #\/ (X[J] + Sides[J] #=< X[I]) #\/
        (Y[I] + Sides[I] #=< Y[J]) #\/ (Y[J] + Sides[J] #=< Y[I])
    end,
    % redundant: the squares crossing any vertical or horizontal line fit within the big square's side
    cumulative(X, Sides, Sides, Base),
    cumulative(Y, Sides, Sides, Base),
    Vars = [X, Y],
    Outputs = [x_coords = X, y_coords = Y],
    % any placement of the squares will do
    Options = [].

main([File]) =>
    Fd = open(File),
    Term = read_term(Fd),
    Term = $json_object(Keys, Values),
    close(Fd),
    Data = new_map([K = V : {K, V} in zip(Keys, Values)]),
    model(Data, Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
