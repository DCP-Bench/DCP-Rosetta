% csplib_015_schurs_lemma: a Picat model from DCP Rosetta.
%
% Put the n balls labelled 1, ..., n into c boxes so that for every triple of balls (x, y, z)
% with x + y = z, where x and y may be equal, not all three balls are in the same box.
%
% Save this file as model.pi. Download `csplib_015_schurs_lemma.json` and `dcp_convert_picat.py` from the
% problem's page:
%   https://dcp-bench.github.io/DCP-Rosetta/problems/csplib_015_schurs_lemma.html
% Convert the instances once, then run the first one (Picat 3.9, https://picat-lang.org):
%   python dcp_convert_picat.py csplib_015_schurs_lemma.json
%   picat model.pi csplib_015_schurs_lemma_1.dat
%
% Data.get(n): the number of balls; Data.get(c): the number of boxes.
import cp.

model(Data, Vars, Outputs, Options) =>
    N = Data.get(n),
    Boxes = Data.get(c),
    % Balls[I] = the box, numbered from 1, that ball I is in
    Balls = new_list(N),
    Balls :: 1..Boxes,
    % for every x + y = z up to n, the balls x, y and z are not all in one box: two of them
    % are in different boxes (x = y is allowed: the triple is then x, x, 2x)
    foreach (X in 1..N - 1, Y in 1..N - X)
        Z = X + Y,
        Balls[X] #!= Balls[Y] #\/ Balls[X] #!= Balls[Z] #\/ Balls[Y] #!= Balls[Z]
    end,
    Vars = Balls,
    Outputs = [balls = Balls],
    Options = [].

main([File]) =>
    Fd = open(File),
    Term = read_term(Fd),
    Term = $json_object(Keys, Values),
    close(Fd),
    Data = new_map([K = V : {K, V} in zip(Keys, Values)]),
    model(Data, Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
