// csplib_015_schurs_lemma: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Put the balls labelled 1, ..., n into c boxes so that for any triple of balls (x, y, z) with x + y = z, where x and y
// may be equal, not all three are in the same box. This has a solution exactly when n < 14.
//
// Save this file as model.idp. Download `csplib_015_schurs_lemma.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/csplib_015_schurs_lemma.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py csplib_015_schurs_lemma.json
//   idp-engine model_1.idp
vocabulary V {
    type Range_n <: Int                // the balls 1..n
    type Range_c <: Int                // the boxes 1..c
    balls: Range_n -> Range_c          // balls(i): the box that ball i is put in
}

theory T:V {
    // no three balls x, y, z with x + y = z (x and y may be equal) are all in the same box
    ! x in Range_n, y in Range_n, z in Range_n: x + y = z => ~(balls(x) = balls(y) & balls(y) = balls(z)).
}

procedure main() {
    pretty_print(model_expand(T, S, max=1))
}
