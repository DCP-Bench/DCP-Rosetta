% diet: a Picat model from DCP Rosetta.
%
% Given the prices and the nutritional requirements (at least) for each nutrition type, what is the optimal diet?
% The optimal diet is to minimize the cost of the products. The foods are chocolate cake (1 slice: 400 calories,
% 3 ounces of chocolate, 2 ounces of sugar, 2 ounces of fat), chocolate ice cream (1 scoop: 200 calories, 2 ounces
% of chocolate, 2 ounces of sugar, 4 ounces of fat), cola (1 bottle: 150 calories, 0 chocolate, 4 ounces of sugar,
% 1 ounce of fat) and pineapple cheesecake (1 piece: 500 calories, 0 chocolate, 4 ounces of sugar, 5 ounces of fat).
% Each food is bought in a whole number of units.
%
% Save this file as model.pi. Download `diet.json` and `dcp_convert_picat.py` from the
% problem's page:
%   https://dcp-bench.github.io/DCP-Rosetta/problems/diet.html
% Convert the instances once, then run the first one (Picat 3.9, https://picat-lang.org):
%   python dcp_convert_picat.py diet.json
%   picat model.pi diet_1.dat
%
% Data.get(price): the price of one unit of each food; Data.get(limits): the minimum required of each nutrition
% type, in the order calories, chocolate, sugar, fat (both lists indexed from 1).
import cp.

model(Data, Vars, Outputs, Options) =>
    Price = Data.get(price),
    Limits = Data.get(limits),
    N = len(Price),                        % the number of foods
    % Nutrition[F,K]: the amount of nutrition K (calories, chocolate, sugar, fat) in one unit of food F
    Nutrition = [[400, 3, 2, 2], [200, 2, 2, 4], [150, 0, 4, 1], [500, 0, 4, 5]],
    X = new_list(N),
    X :: 0..max(Limits),                   % X[F] = the number of units of food F bought, at most the largest limit
    % the diet provides at least the required amount of each nutrition type
    foreach (K in 1..len(Limits))
        sum([Nutrition[F,K] * X[F] : F in 1..N]) #>= Limits[K]
    end,
    % the cost of the diet is the price of the units bought
    Cost #= sum([Price[F] * X[F] : F in 1..N]),
    Vars = X,
    Outputs = [cost = Cost],
    % minimise the cost of the diet
    Options = [$min(Cost)].

main([File]) =>
    Fd = open(File),
    Term = read_term(Fd),
    Term = $json_object(Keys, Values),
    close(Fd),
    Data = new_map([K = V : {K, V} in zip(Keys, Values)]),
    model(Data, Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
