// diet: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Given the prices and the nutritional requirements (at least) for each nutrition type, find the optimal diet: the
// number of units of each food to buy, each a whole number, that meets the minimum requirement of each nutrition type
// (calories, chocolate, sugar and fat) at the lowest total cost. The foods are chocolate cake (1 slice), chocolate ice
// cream (1 scoop), cola (1 bottle) and pineapple cheesecake (1 piece); their nutrition per unit is given in the theory.
//
// Save this file as model.idp. Download `diet.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/diet.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py diet.json
//   idp-engine model_1.idp
vocabulary V {
    type Food <: Int                   // the foods, numbered from 0, sized from price
    type Nut <: Int                    // the nutrition types, numbered from 0, sized from limits: calories, chocolate, sugar, fat
    price: Food -> Int                 // price(f): the price of one unit of food f
    limits: Nut -> Int                 // limits(j): the minimum required amount of nutrition type j
    per_unit: Food * Nut -> Int        // per_unit(f, j): the amount of nutrition type j in one unit of food f (the table, in the theory)
    buy: Food -> Int                   // buy(f): the number of units of food f bought
    cost: () -> Int                    // the total cost of the diet (declared output)
    minimize: () -> Int                // the total cost of the diet, to minimize
}
theory T:V {
    // each food is bought in a whole, not negative, number of units; the upper bound (the sum of the limits) is an implied
    // bound that an optimal diet never needs, not part of the problem
    ! f in Food: buy(f) >= 0 & buy(f) =< sum{{ limits(j) | j in Nut }}.

    // the foods bought supply at least the required amount of each nutrition type
    ! j in Nut: sum{{ (per_unit(f, j) * buy(f)) | f in Food }} >= limits(j).

    // the nutrition per unit of each food (calories, chocolate in ounces, sugar in ounces, fat in ounces):
    // chocolate cake 400, 3, 2, 2; chocolate ice cream 200, 2, 2, 4; cola 150, 0, 4, 1; pineapple cheesecake 500, 0, 4, 5
    per_unit(0, 0) = 400 & per_unit(0, 1) = 3 & per_unit(0, 2) = 2 & per_unit(0, 3) = 2.
    per_unit(1, 0) = 200 & per_unit(1, 1) = 2 & per_unit(1, 2) = 2 & per_unit(1, 3) = 4.
    per_unit(2, 0) = 150 & per_unit(2, 1) = 0 & per_unit(2, 2) = 4 & per_unit(2, 3) = 1.
    per_unit(3, 0) = 500 & per_unit(3, 1) = 0 & per_unit(3, 2) = 4 & per_unit(3, 3) = 5.

    // the total cost is the price of each food times the units bought
    cost() = sum{{ (price(f) * buy(f)) | f in Food }}.

    // the cost to minimize is the total cost of the diet
    minimize() = cost().
}
procedure main() {
    pretty_print(minimize(T, S, term="minimize()"))
}
