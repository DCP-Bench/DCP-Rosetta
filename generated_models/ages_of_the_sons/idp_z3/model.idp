// ages_of_the_sons: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// An old man asked a mathematician to guess the ages of his three sons. The old man said: "The product of their ages
// is 36." The mathematician said: "I need more information." The old man said: "Over there you can see a building. The
// sum of their ages equals the number of the windows in that building." After a short while the mathematician said: "I
// need more information." The old man said: "The oldest son has blue eyes." The mathematician said: "I got it."
//
//   https://dcp-bench.github.io/DCP-Rosetta/problems/ages_of_the_sons.html
// Save this model as model.idp and run it (`pip install idp-engine`) with:
//   idp-engine model.idp
vocabulary V {
    type Age := {1..36}                // a son's age in years; at most 36, since the three ages are positive and multiply to 36
    A1: () -> Int                      // the age of the oldest son
    A2: () -> Int                      // the age of the middle son
    A3: () -> Int                      // the age of the youngest son
}
theory T:V {
    // the ages are listed from the oldest: A1 >= A2 >= A3 >= 1
    1 =< A3() & A3() =< A2() & A2() =< A1().
    // the product of the three ages is 36
    A1() * A2() * A3() = 36.
    // the product alone does not determine the ages: another triple of ages (oldest first) has product 36
    ?x, y, z in Age: x >= y & y >= z & x * y * z = 36 & (x ~= A1() | y ~= A2() | z ~= A3()).
    // the sum of the ages is the number of windows, which does not determine the ages either: another triple of ages
    // with product 36 has the same sum
    ?x, y, z in Age: x >= y & y >= z & x * y * z = 36 & x + y + z = A1() + A2() + A3() & (x ~= A1() | y ~= A2() | z ~= A3()).
    // the oldest son is identified by having blue eyes: among the triples with product 36 and the same sum, only the
    // true ages have a single oldest son
    ! x, y, z in Age: (x >= y & y >= z & x * y * z = 36 & x + y + z = A1() + A2() + A3() & x > y) => (x = A1() & y = A2() & z = A3()).
    // and the oldest son is a single oldest son
    A1() > A2().
}
procedure main() {
    pretty_print(model_expand(T, max=1))
}
