% jobs_puzzle: a Picat model from DCP Rosetta.
%
% Four people, numbered 0 to 3, hold eight different jobs between them: chef, guard, nurse, clerk, police
% officer, teacher, actor and boxer. Each person holds exactly two jobs. The clues are:
% 1. The nurse is not a teacher, a police officer or a clerk.
% 2. The clerk is not the chef.
% 3. Person 0 is not the boxer.
% 4. Person 3 is not the teacher, police officer or nurse.
% 5. Person 0, the chef, and the police officer went golfing together.
%
%   https://dcp-bench.github.io/DCP-Rosetta/problems/jobs_puzzle.html
% Save this model as model.pi and run it (Picat 3.9, https://picat-lang.org) with:
%   picat model.pi
import cp.

% The puzzle reads no data: the people and the clues are fixed in the model.
model(_Data, Vars, Outputs, Options) =>
    % each job is the person, 0 to 3, who holds it
    Jobs = [Chef, Guard, Nurse, Clerk, PoliceOfficer, Teacher, Actor, Boxer],
    Jobs :: 0..3,
    % each person holds exactly two of the jobs
    foreach (Person in 0..3)
        count(Person, Jobs) #= 2
    end,
    % 1. the nurse is not a teacher, a police officer or a clerk
    Nurse #!= Teacher,
    Nurse #!= PoliceOfficer,
    Nurse #!= Clerk,
    % 2. the clerk is not the chef
    Clerk #!= Chef,
    % 3. person 0 is not the boxer
    Boxer #!= 0,
    % 4. person 3 is not the teacher, the police officer or the nurse
    Teacher #!= 3,
    PoliceOfficer #!= 3,
    Nurse #!= 3,
    % 5. person 0, the chef and the police officer are three different people
    Chef #!= 0,
    PoliceOfficer #!= 0,
    Chef #!= PoliceOfficer,
    Vars = Jobs,
    Outputs = [chef = Chef, guard = Guard, nurse = Nurse, clerk = Clerk,
               police_officer = PoliceOfficer, teacher = Teacher, actor = Actor, boxer = Boxer],
    Options = [].

main =>
    model(new_map(), Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
