% csplib_011_acc_basketball_schedule: a Picat model from DCP Rosetta.
%
% The 1997/98 Atlantic Coast Conference basketball timetable: a double round-robin for 9 teams
% (Clemson, Duke, Florida State, Georgia Tech, Maryland, North Carolina, North Carolina State,
% Virginia, Wake Forest) over 18 dates, where each team plays every other team once at home and
% once away. The odd dates are weekday fixtures and the even dates weekend fixtures. Besides this,
% the timetable must satisfy: a mirroring scheme (dates (1,8), (2,9), (3,12), (4,13), (5,14),
% (6,15), (7,16), (10,17), (11,18) pair up, and a team meets the same opponent on both dates of a
% pair with home and away swapped); no team plays away on both last dates; no more than two home
% or two away matches in a row, and no more than three away matches or byes, or four home matches
% or byes, in a row; over the weekends each team has four home matches, four away matches and one
% bye; each team has a home match or a bye on at least two of the first five weekends; on the last
% date every team except Florida State plays its traditional rival (Duke-UNC, Clemson-Georgia Tech,
% NC State-Wake Forest, Maryland-Virginia), unless it plays Florida State or has a bye; Wake Forest
% and Georgia Tech each meet UNC and Duke at least once on dates 11 to 18; no team plays away at
% UNC and at Duke on consecutive dates, nor plays UNC, Duke and Wake Forest on three consecutive
% dates; and a list of fixed facts about particular dates (UNC v Duke on dates 11 and 18, UNC v
% Clemson on date 2, Duke bye on date 16, Wake Forest home on date 17 forbidden, Wake Forest bye
% on date 1, and others).
%
% Save this file as model.pi. Download `csplib_011_acc_basketball_schedule.json` and `dcp_convert_picat.py` from the
% problem's page:
%   https://dcp-bench.github.io/DCP-Rosetta/problems/csplib_011_acc_basketball_schedule.html
% Convert the instances once, then run the first one (Picat 3.9, https://picat-lang.org):
%   python dcp_convert_picat.py csplib_011_acc_basketball_schedule.json
%   picat model.pi csplib_011_acc_basketball_schedule_1.dat
%
% Data.get(n_teams): the number of teams; Data.get(n_days): the number of dates.
import sat.

model(Data, Vars, Outputs, Options) =>
    NTeams = Data.get(n_teams),
    NDays = Data.get(n_days),
    % the teams, numbered 1..9 (the output numbers them from 0)
    Clem = 1, Duke = 2, FSU = 3, GT = 4, UMD = 5, UNC = 6, NCSt = 7, UVA = 8, Wake = 9,
    % Rival[T] = the traditional rival of team T (Florida State has none, so it is its own rival)
    Rival = [GT, UNC, FSU, Clem, UVA, Duke, Wake, UMD, NCSt],
    % the mirroring scheme: dates R1 and R2 of each pair
    Mirroring = [{1, 8}, {2, 9}, {3, 12}, {4, 13}, {5, 14}, {6, 15}, {7, 16}, {10, 17}, {11, 18}],
    % Host[D, T, U] = 1 if on date D team T plays at home against team U
    Host = new_array(NDays, NTeams, NTeams),
    Host :: 0..1,
    % a team does not play itself
    foreach (D in 1..NDays, T in 1..NTeams)
        Host[D, T, T] #= 0
    end,
    % Home[D, T], Away[D, T], Bye[D, T] = 1 if on date D team T plays at home, plays away or
    % has a bye; exactly one of them holds, so a team plays at most one match a date
    Home = new_array(NDays, NTeams),
    Away = new_array(NDays, NTeams),
    Bye = new_array(NDays, NTeams),
    Home :: 0..1,
    Away :: 0..1,
    Bye :: 0..1,
    foreach (D in 1..NDays, T in 1..NTeams)
        Home[D, T] #= sum([Host[D, T, U] : U in 1..NTeams]),
        Away[D, T] #= sum([Host[D, U, T] : U in 1..NTeams]),
        Bye[D, T] #= 1 - Home[D, T] - Away[D, T]
    end,
    % Meet[D, T, U] = 1 if teams T and U play each other on date D, wherever
    Meet = new_array(NDays, NTeams, NTeams),
    Meet :: 0..1,
    foreach (D in 1..NDays, T in 1..NTeams, U in 1..NTeams)
        Meet[D, T, U] #= Host[D, T, U] + Host[D, U, T]
    end,
    % double round-robin: each team plays each other team once at home
    foreach (T in 1..NTeams, U in 1..NTeams, T != U)
        sum([Host[D, T, U] : D in 1..NDays]) #= 1
    end,
    % 1. mirroring: a team that hosts another on one date of a pair plays away at it on the other
    foreach ({D1, D2} in Mirroring, T in 1..NTeams, U in 1..NTeams)
        Host[D1, T, U] #= Host[D2, U, T]
    end,
    % 2. no two final aways: no team plays away on both of the last two dates
    foreach (T in 1..NTeams)
        Away[NDays - 1, T] + Away[NDays, T] #=< 1
    end,
    % 3. home, away and bye patterns, in a row
    foreach (T in 1..NTeams)
        % no more than two home matches in a row
        foreach (D in 1..NDays - 2)
            sum([Home[E, T] : E in D..D + 2]) #=< 2
        end,
        % no more than two away matches in a row
        foreach (D in 1..NDays - 2)
            sum([Away[E, T] : E in D..D + 2]) #=< 2
        end,
        % no more than three away matches or byes in a row
        foreach (D in 1..NDays - 3)
            sum([Away[E, T] + Bye[E, T] : E in D..D + 3]) #=< 3
        end,
        % no more than four home matches or byes in a row
        foreach (D in 1..NDays - 4)
            sum([Home[E, T] + Bye[E, T] : E in D..D + 4]) #=< 4
        end
    end,
    % 4. weekend pattern: over the weekends (the even dates) each team plays four at home,
    %    four away and has one bye
    Weekends = [D : D in 1..NDays, D mod 2 == 0],
    foreach (T in 1..NTeams)
        sum([Home[D, T] : D in Weekends]) #= 4,
        sum([Away[D, T] : D in Weekends]) #= 4,
        sum([Bye[D, T] : D in Weekends]) #= 1
    end,
    % 5. first weekends: each team has a home match or a bye on at least two of the first five weekends
    FirstWeekends = [Weekends[I] : I in 1..5],
    foreach (T in 1..NTeams)
        sum([Home[D, T] + Bye[D, T] : D in FirstWeekends]) #>= 2
    end,
    % 6. rival matches: on the last date every team except Florida State plays its rival, unless
    %    it plays Florida State or has a bye
    foreach (T in 1..NTeams, T != FSU)
        Meet[NDays, T, Rival[T]] + Meet[NDays, T, FSU] + Bye[NDays, T] #>= 1
    end,
    % 7. constrained matches: Wake Forest-UNC, Wake Forest-Duke, Georgia Tech-UNC and
    %    Georgia Tech-Duke are each played at least once on dates 11 to 18
    foreach ({T, U} in [{Wake, UNC}, {Wake, Duke}, {GT, UNC}, {GT, Duke}])
        sum([Meet[D, T, U] : D in 11..NDays]) #>= 1
    end,
    % 8. opponent sequences: no team other than UNC and Duke plays away at UNC and at Duke on
    %    two consecutive dates, in either order
    foreach (T in 1..NTeams, T != Duke, T != UNC, D in 1..NDays - 1)
        Host[D, UNC, T] + Host[D + 1, Duke, T] #=< 1,
        Host[D, Duke, T] + Host[D + 1, UNC, T] #=< 1
    end,
    %    no team other than UNC, Duke and Wake Forest plays those three on three consecutive
    %    dates, in any order (home or away)
    Trios = [{UNC, Duke, Wake}, {UNC, Wake, Duke}, {Duke, UNC, Wake},
             {Duke, Wake, UNC}, {Wake, UNC, Duke}, {Wake, Duke, UNC}],
    foreach (T in 1..NTeams, T != UNC, T != Duke, T != Wake, D in 1..NDays - 2,
             {A, B, C} in Trios)
        Meet[D, T, A] + Meet[D + 1, T, B] + Meet[D + 2, T, C] #=< 2
    end,
    % 9. other constraints
    %    UNC plays Duke on the last date and on date 11
    Meet[NDays, UNC, Duke] #= 1,
    Meet[11, UNC, Duke] #= 1,
    %    UNC plays Clemson on the second date
    Meet[2, UNC, Clem] #= 1,
    %    Duke has a bye on date 16
    Bye[16, Duke] #= 1,
    %    Wake Forest does not play at home on date 17
    Home[17, Wake] #= 0,
    %    Wake Forest has a bye on the first date
    Bye[1, Wake] #= 1,
    %    Clemson, Duke, Maryland and Wake Forest do not play away on the last date
    foreach (T in [Clem, Duke, UMD, Wake])
        Away[NDays, T] #= 0
    end,
    %    Clemson, Florida State, Georgia Tech and Wake Forest do not play away on the first date
    foreach (T in [Clem, FSU, GT, Wake])
        Away[1, T] #= 0
    end,
    %    neither Florida State nor NC State has a bye on the last date
    Bye[NDays, FSU] #= 0,
    Bye[NDays, NCSt] #= 0,
    %    UNC does not have a bye on the first date
    Bye[1, UNC] #= 0,
    % Config[D, T] = the team, numbered from 0, that team T plays on date D (T itself on a bye);
    % Where[D, T] = 0 for home, 1 for a bye, 2 for away
    Config = new_array(NDays, NTeams),
    Config :: 0..NTeams - 1,
    Where = new_array(NDays, NTeams),
    Where :: 0..2,
    foreach (D in 1..NDays, T in 1..NTeams)
        Config[D, T] #= sum([(U - 1) * Meet[D, T, U] : U in 1..NTeams]) + (T - 1) * Bye[D, T],
        Where[D, T] #= 2 * Away[D, T] + Bye[D, T]
    end,
    Vars = [Host, Home, Away, Bye, Meet, Config, Where],
    Outputs = [config = Config, where = Where],
    Options = [].

main([File]) =>
    Fd = open(File),
    Term = read_term(Fd),
    Term = $json_object(Keys, Values),
    close(Fd),
    Data = new_map([K = V : {K, V} in zip(Keys, Values)]),
    model(Data, Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
