// circular_table_averbach_1_2: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Three players (X, Y, Z) of different nationalities (American, English, French) are seated around a circular table
// playing a game of Hearts. Each passed three cards to the person on their right. Y passed three hearts to the
// American, X passed the queen of spades and two diamonds to the person who passed their cards to the Frenchwoman.
// Determine the nationality of each person. The seats are numbered 0, 1, 2, where 1 is right of 0, 2 is right of 1,
// and 0 is right of 2.
//
//   https://dcp-bench.github.io/DCP-Rosetta/problems/circular_table_averbach_1_2.html
// Save this model as model.idp and run it (`pip install idp-engine`) with:
//   idp-engine model.idp
vocabulary V {
    x: () -> Int                       // the seat of player X, a seat is 0, 1 or 2
    y: () -> Int                       // the seat of player Y
    z: () -> Int                       // the seat of player Z
    american: () -> Int                // the seat of the American player
    english: () -> Int                 // the seat of the English player
    french: () -> Int                  // the seat of the French player
}
theory T:V {
    // each seat is 0, 1 or 2
    0 =< x() & x() =< 2 & 0 =< y() & y() =< 2 & 0 =< z() & z() =< 2.
    0 =< american() & american() =< 2 & 0 =< english() & english() =< 2 & 0 =< french() & french() =< 2.
    // the players X, Y and Z sit in three different seats
    x() ~= y() & y() ~= z() & x() ~= z().
    // the nationalities American, English and French belong to three different seats
    american() ~= english() & english() ~= french() & american() ~= french().
    // the person on the right of the seat p sits in seat p + 1, and the person on the right of seat 2 sits in seat 0
    // Y passed three hearts to the American, so the American sits on the right of Y
    (y() = 0 & american() = 1) | (y() = 1 & american() = 2) | (y() = 2 & american() = 0).
    // X passed to the person P on X's right, and P passed to the Frenchwoman, so the Frenchwoman sits two seats right of X
    (x() = 0 & french() = 2) | (x() = 1 & french() = 0) | (x() = 2 & french() = 1).
}
procedure main() {
    pretty_print(model_expand(T, max=1))
}
