% session1_five_floors: a Picat model from DCP Rosetta.
%
% Baker, Cooper, Fletcher, Miller, and Smith live on the first five floors of an apartment house. Baker does not
% live on the fifth floor. Cooper does not live on the first floor. Fletcher does not live on either the fifth or the
% first floor. Miller lives on a higher floor than does Cooper. Smith does not live on a floor adjacent to Fletcher's.
% Fletcher does not live on a floor adjacent to Cooper's. They all live on different floors. Find the floors where
% these people live.
%
%   https://dcp-bench.github.io/DCP-Rosetta/problems/session1_five_floors.html
% Save this model as model.pi and run it (Picat 3.9, https://picat-lang.org) with:
%   picat model.pi

% The puzzle has no data: the floor of each person is a decision variable.
import cp.

model(_Data, Vars, Outputs, Options) =>
    % the floor of each person, from 1 (first) to 5 (fifth)
    Floors = [Baker, Cooper, Fletcher, Miller, Smith],
    Floors :: 1..5,
    % they all live on different floors
    all_different(Floors),
    % Baker does not live on the fifth floor
    Baker #!= 5,
    % Cooper does not live on the first floor
    Cooper #!= 1,
    % Fletcher does not live on either the fifth or the first floor
    Fletcher #!= 5,
    Fletcher #!= 1,
    % Miller lives on a higher floor than Cooper
    Miller #> Cooper,
    % Smith does not live on a floor adjacent to Fletcher's
    abs(Smith - Fletcher) #!= 1,
    % Fletcher does not live on a floor adjacent to Cooper's
    abs(Fletcher - Cooper) #!= 1,
    Vars = Floors,
    Outputs = ['B' = Baker, 'C' = Cooper, 'F' = Fletcher, 'M' = Miller, 'S' = Smith],
    Options = [].

main =>
    model(new_map(), Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
