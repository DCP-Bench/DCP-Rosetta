// assignment_costs: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Assign people to 4 tasks with different costs, so that the total cost is minimized. Each task must be assigned to
// exactly one person, but it is not necessary to assign all people to a task.
//
// Save this file as model.idp. Download `assignment_costs.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/assignment_costs.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py assignment_costs.json
//   idp-engine model_1.idp
vocabulary V {
    type Task <: Int                   // the tasks, numbered from 0
    type Person <: Int                 // the people, numbered from 0
    cost: Task * Person -> Int         // cost(t, p): the cost of assigning task t to person p
    x: Task * Person -> Bool           // x(t, p): task t is assigned to person p
    minimize: () -> Int                // the total cost of the assignment
}
theory T:V {
    // each task is assigned to exactly one person
    ! t in Task: #{ p in Person: x(t, p) } = 1.
    // each person is assigned at most one task
    ! p in Person: #{ t in Task: x(t, p) } =< 1.
    // the total cost is the cost of the assignments made
    minimize() = sum{{ cost(t, p) | t in Task, p in Person: x(t, p) }}.
}
procedure main() {
    pretty_print(minimize(T, S, term="minimize()"))
}
