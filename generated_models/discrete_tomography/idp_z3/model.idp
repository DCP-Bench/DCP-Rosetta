// discrete_tomography: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// A matrix of zeroes and ones is "x-rayed" vertically and horizontally, giving the total number of ones in each row and
// in each column. The problem is to reconstruct the contents of the matrix from this information.
//
// Save this file as model.idp. Download `discrete_tomography.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/discrete_tomography.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py discrete_tomography.json
//   idp-engine model_1.idp

vocabulary V {
    type R <: Int                      // the rows, numbered from 0, sized from row_sums
    type C <: Int                      // the columns, numbered from 0, sized from col_sums
    type Bit := {0..1}                 // a cell holds zero or one
    row_sums: R -> Int                 // row_sums(r): the number of ones in row r
    col_sums: C -> Int                 // col_sums(c): the number of ones in column c
    matrix: R * C -> Bit               // matrix(r, c): the cell in row r and column c
}

theory T:V {
    // each row contains exactly the number of ones given for it
    ! r in R: sum{{ matrix(r, c) | c in C }} = row_sums(r).

    // each column contains exactly the number of ones given for it
    ! c in C: sum{{ matrix(r, c) | r in R }} = col_sums(c).
}

procedure main() {
    pretty_print(model_expand(T, S, max=1))
}
