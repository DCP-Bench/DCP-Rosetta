// csplib_026_sports_tournament_scheduling: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Schedule a tournament of n teams over n - 1 weeks, with each week divided into n/2 periods. In each period one match is
// played: the first team plays at home, and the second plays the first team away. A tournament must satisfy three
// constraints: every team plays once a week; every team plays at most twice in the same period over the tournament; and
// every team plays every other team.
//
// Save this file as model.idp. Download `csplib_026_sports_tournament_scheduling.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/csplib_026_sports_tournament_scheduling.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py csplib_026_sports_tournament_scheduling.json
//   idp-engine model_1.idp
vocabulary V {
    type Range_n_teams <: Int          // the teams 1..n_teams
    type Week <: Int                   // the weeks 1..n_teams - 1, sized by Week_size
    type Period <: Int                 // the periods 1..n_teams / 2 of a week, sized by Period_size
    Week_size: () -> Int               // the number of weeks (the size of Week)
    Period_size: () -> Int             // the number of periods in a week (the size of Period)
    n_teams: () -> Int                 // the number of teams
    home: Week * Period -> Range_n_teams   // home(w, p): the team playing at home in week w, period p
    away: Week * Period -> Range_n_teams   // away(w, p): the team playing away in week w, period p
}

theory T:V {
    // the tournament has n - 1 weeks
    Week_size() = n_teams() - 1.

    // each week has n / 2 periods
    Period_size() = n_teams() / 2.

    // the two teams of a match are different
    ! w in Week, p in Period: home(w, p) ~= away(w, p).

    // every team plays exactly once in every week
    ! w in Week, t in Range_n_teams: #{p in Period: (home(w, p) = t | away(w, p) = t)} = 1.

    // every team plays at most twice in the same period over the tournament
    ! t in Range_n_teams, p in Period: #{w in Week: (home(w, p) = t | away(w, p) = t)} =< 2.

    // every team plays every other team exactly once
    ! a, b in Range_n_teams: a < b => #{w in Week, p in Period: (home(w, p) = a & away(w, p) = b) | (home(w, p) = b & away(w, p) = a)} = 1.
}

procedure main() {
    pretty_print(model_expand(T, S, max=1))
}
