% csplib_026_sports_tournament_scheduling: a Picat model from DCP Rosetta.
%
% The problem is to schedule a tournament of n teams over n-1 weeks, with each week divided into n/2
% periods, and each period divided into two slots. The first team in each slot plays at home, whilst the
% second plays the first team away. A tournament must satisfy the following three constraints: every team
% plays once a week; every team plays at most twice in the same period over the tournament; every team plays
% every other team.
%
% Save this file as model.pi. Download `csplib_026_sports_tournament_scheduling.json` and `dcp_convert_picat.py` from the
% problem's page:
%   https://dcp-bench.github.io/DCP-Rosetta/problems/csplib_026_sports_tournament_scheduling.html
% Convert the instances once, then run the first one (Picat 3.9, https://picat-lang.org):
%   python dcp_convert_picat.py csplib_026_sports_tournament_scheduling.json
%   picat model.pi csplib_026_sports_tournament_scheduling_1.dat
%
% Data.get(n_teams): the number of teams n (teams are numbered from 1 to n).
import cp.

model(Data, Vars, Outputs, Options) =>
    NTeams = Data.get(n_teams),
    NWeeks = NTeams - 1,             % the number of weeks
    NPeriods = NTeams // 2,          % the number of periods in each week
    % Home[W, P] / Away[W, P] = the team at home / away in week W, period P
    Home = new_array(NWeeks, NPeriods),
    Away = new_array(NWeeks, NPeriods),
    Home :: 1..NTeams,
    Away :: 1..NTeams,
    % the two teams of a period are different
    foreach (W in 1..NWeeks, P in 1..NPeriods)
        Home[W, P] #!= Away[W, P]
    end,
    % every team plays once a week: the teams of each week are all different
    foreach (W in 1..NWeeks)
        all_different([Home[W, P] : P in 1..NPeriods] ++ [Away[W, P] : P in 1..NPeriods])
    end,
    % every team plays every other team: each pair of teams meets at least once
    foreach (T1 in 1..NTeams - 1, T2 in T1 + 1..NTeams)
        sum([(Home[W, P] #= T1 #/\ Away[W, P] #= T2) #\/ (Home[W, P] #= T2 #/\ Away[W, P] #= T1)
             : W in 1..NWeeks, P in 1..NPeriods]) #>= 1
    end,
    % every team plays at most twice in the same period over the tournament
    foreach (T in 1..NTeams, P in 1..NPeriods)
        sum([(Home[W, P] #= T) #\/ (Away[W, P] #= T) : W in 1..NWeeks]) #=< 2
    end,
    Vars = [Home, Away],
    Outputs = [home = Home, away = Away],
    Options = [].

main([File]) =>
    Fd = open(File),
    Term = read_term(Fd),
    Term = $json_object(Keys, Values),
    close(Fd),
    Data = new_map([K = V : {K, V} in zip(Keys, Values)]),
    model(Data, Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
