% five_brigands: a Picat model from DCP Rosetta.
%
% The five Spanish brigands, Alfonso, Benito, Carlos, Diego, and Esteban, were counting their spoils
% after a raid, and found that they had captured altogether exactly 200 doubloons. One of the band
% pointed out that if Alfonso had twelve times as much, Benito three times as much, Carlos the same
% amount, Diego half as much, and Esteban one-third as much, they would still have altogether just
% 200 doubloons. How many doubloons had each? Also, no brigand had less than one doubloon.
%
%   https://dcp-bench.github.io/DCP-Rosetta/problems/five_brigands.html
% Save this model as model.pi and run it (Picat 3.9, https://picat-lang.org) with:
%   picat model.pi
%
% The model reads no data: the numbers of doubloons are the decision variables A, B, C, D, E.
import cp.

model(_Data, Vars, Outputs, Options) =>
    Vars = [A, B, C, D, E],
    Vars :: 1..200,
    % the brigands had altogether exactly 200 doubloons
    A + B + C + D + E #= 200,
    % with the changed amounts (12A, 3B, C, D/2, E/3) they would still have 200 doubloons;
    % multiplied by 6 to stay in whole numbers
    6 * (12 * A + 3 * B + C) + 3 * D + 2 * E #= 1200,
    Outputs = ['A' = A, 'B' = B, 'C' = C, 'D' = D, 'E' = E],
    Options = [].

main =>
    model(new_map(), Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
