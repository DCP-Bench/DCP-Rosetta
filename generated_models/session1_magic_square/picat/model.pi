% session1_magic_square: a Picat model from DCP Rosetta.
%
% A magic square is an n x n grid (n != 2) such that each cell contains a different integer from 1 to n^2 and the
% sum of the integers in each row, column and diagonal is equal. Find a magic square for a given size n, knowing that
% the sum of integers of each row, column and diagonal has to be equal to n(n^2 + 1)/2 (integer).
%
% Save this file as model.pi. Download `session1_magic_square.json` and `dcp_convert_picat.py` from the
% problem's page:
%   https://dcp-bench.github.io/DCP-Rosetta/problems/session1_magic_square.html
% Convert the instances once, then run the first one (Picat 3.9, https://picat-lang.org):
%   python dcp_convert_picat.py session1_magic_square.json
%   picat model.pi session1_magic_square_1.dat
%
% Data.get(n): the side n of the square.
import sat.

model(Data, Vars, Outputs, Options) =>
    N = Data.get(n),
    % the magic sum n(n^2 + 1)/2
    Sum = N * (N * N + 1) // 2,
    % Square[I, J] = the number in row I, column J
    Square = new_array(N, N),
    Square :: 1..N * N,
    % each cell contains a different integer
    all_different([Square[I, J] : I in 1..N, J in 1..N]),
    % every row and every column adds up to the magic sum
    foreach (I in 1..N)
        sum([Square[I, J] : J in 1..N]) #= Sum,
        sum([Square[J, I] : J in 1..N]) #= Sum
    end,
    % the main diagonal adds up to the magic sum
    sum([Square[I, I] : I in 1..N]) #= Sum,
    % the other diagonal adds up to the magic sum
    sum([Square[I, N + 1 - I] : I in 1..N]) #= Sum,
    Vars = Square,
    Outputs = [square = Square],
    Options = [].

% Reads the data file, builds the model, solves it and prints each output.
main([File]) =>
    Fd = open(File),
    Term = read_term(Fd),
    Term = $json_object(Keys, Values),
    close(Fd),
    Data = new_map([K = V : {K, V} in zip(Keys, Values)]),
    model(Data, Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
