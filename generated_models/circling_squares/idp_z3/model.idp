// circling_squares: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Circling the squares: place a different number in each of the ten squares, so that the sum of the squares of any
// two adjacent numbers is equal to the sum of the squares of the two numbers diametrically opposite to them. Fractions
// are not allowed. The numbers placed as examples are A = 16, B = 2, F = 8 and G = 14, and they must stand as they are.
// The squares in the circle are, in order, A, B, C, D, E, F, G, H, I, K, and each square is adjacent to the next one.
//
//   https://dcp-bench.github.io/DCP-Rosetta/problems/circling_squares.html
// Save this model as model.idp and run it (`pip install idp-engine`) with:
//   idp-engine model.idp
vocabulary V {
    type Num <: Int                    // the positive integers that may be placed (each of at most two figures)
    type Sq := {0..9}                  // the ten squares of the circle, numbered 0 to 9 in the order A, B, C, D, E, F, G, H, I, K
    pos: Sq -> Num                     // pos(k): the number placed in square k (auxiliary, equal to the letter below)
    sq: Num -> Int                     // sq(n): the square of the number n (auxiliary)
    A: () -> Int                       // the number in square A
    B: () -> Int                       // the number in square B
    C: () -> Int                       // the number in square C
    D: () -> Int                       // the number in square D
    E: () -> Int                       // the number in square E
    F: () -> Int                       // the number in square F
    G: () -> Int                       // the number in square G
    H: () -> Int                       // the number in square H
    I: () -> Int                       // the number in square I
    K: () -> Int                       // the number in square K
}
structure N:V {
    Num := {1..99}.
}
theory T:V {
    // the square of each number
    ! n in Num: sq(n) = n * n.
    // a different number is placed in each of the ten squares
    ! k, m in Sq: k ~= m => pos(k) ~= pos(m).
    // the squares are the letters of the circle
    A() = pos(0) & B() = pos(1) & C() = pos(2) & D() = pos(3) & E() = pos(4).
    F() = pos(5) & G() = pos(6) & H() = pos(7) & I() = pos(8) & K() = pos(9).
    // the examples: A = 16, B = 2, F = 8, G = 14
    A() = 16 & B() = 2 & F() = 8 & G() = 14.
    // the squares of each two adjacent squares k and k+1 (round the circle) equal the squares of the two diametrically
    // opposite squares k+5 and k+6
    ! k in Sq: sq(pos(k)) + sq(pos((k + 1) % 10)) = sq(pos((k + 5) % 10)) + sq(pos((k + 6) % 10)).
}
procedure main() {
    pretty_print(model_expand(T, N, max=1))
}
