// hidato: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Hidato puzzles start semi-filled with numbered tiles. Connect the numbers together to win. Consecutive numbers must
// touch horizontally, vertically, or diagonally. The numbers must be in increasing order. Fill in the empty cells,
// marked 0 in the given puzzle, with the numbers that complete the puzzle, so that the grid holds each number from 1 to
// the number of cells exactly once.
//
// Save this file as model.idp. Download `hidato.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/hidato.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py hidato.json
//   idp-engine model_1.idp
vocabulary V {
    type Row <: Int                    // the rows of the grid, numbered from 0
    type Col <: Int                    // the columns of the grid, numbered from 0
    puzzle: Row * Col -> Int           // puzzle(r, c): the given number in cell (r, c), 0 if the cell is empty
    cells: () -> Int                   // the number of cells in the grid
    x: Row * Col -> Int                // x(r, c): the number in cell (r, c) of the solved grid
}
theory T:V {
    // the number of cells is the number of cells of the grid
    cells() = #{ r in Row, c in Col: true }.
    // every cell holds a number from 1 to the number of cells
    ! r in Row: ! c in Col: 1 =< x(r, c) & x(r, c) =< cells().
    // every number from 1 to the number of cells is in exactly one cell
    ! r in Row: ! c in Col: ! s in Row: ! d in Col: (r ~= s | c ~= d) => x(r, c) ~= x(s, d).
    // the given numbers stay in their cells
    ! r in Row: ! c in Col: puzzle(r, c) ~= 0 => x(r, c) = puzzle(r, c).
    // the cell of a number and the cell of the next number touch horizontally, vertically or diagonally
    ! r in Row: ! c in Col: ! s in Row: ! d in Col: x(s, d) = x(r, c) + 1 => (r - s =< 1 & s - r =< 1 & c - d =< 1 & d - c =< 1).
}
procedure main() {
    pretty_print(model_expand(T, S, max=1, timeout_seconds=300))
}
