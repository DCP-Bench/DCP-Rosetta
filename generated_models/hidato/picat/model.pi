% hidato: a Picat model from DCP Rosetta.
%
% A Hidato puzzle is a grid partly filled with numbers. Fill in the empty cells so that the grid holds each
% number from 1 to the number of cells exactly once, and consecutive numbers are in cells that touch
% horizontally, vertically or diagonally. The numbers must be in increasing order.
%
% Save this file as model.pi. Download `hidato.json` and `dcp_convert_picat.py` from the
% problem's page:
%   https://dcp-bench.github.io/DCP-Rosetta/problems/hidato.html
% Convert the instances once, then run the first one (Picat 3.9, https://picat-lang.org):
%   python dcp_convert_picat.py hidato.json
%   picat model.pi hidato_1.dat
%
% Data.get(puzzle): the grid as a list of rows, indexed from 1; 0 marks an empty cell, other numbers are given.
import cp.

model(Data, Vars, Outputs, Options) =>
    Puzzle = Data.get(puzzle),
    R = len(Puzzle),                          % the number of rows
    C = len(Puzzle[1]),                       % the number of columns
    N = R * C,                                % the number of cells, and the largest number
    % Grid[(I - 1) * C + J] is the number in row I, column J (the cells in reading order)
    Grid = new_list(N),
    Grid :: 1..N,
    % each number from 1 to N appears exactly once
    all_different(Grid),
    % the numbers given in the puzzle stay where they are
    foreach (I in 1..R, J in 1..C, Puzzle[I, J] > 0)
        Grid[(I - 1) * C + J] #= Puzzle[I, J]
    end,
    % Row[K], Col[K] are the row and the column of the cell holding number K, and Pos[K] its place in reading order
    Row = new_list(N),
    Col = new_list(N),
    Pos = new_list(N),
    Row :: 1..R,
    Col :: 1..C,
    Pos :: 1..N,
    foreach (K in 1..N)
        Pos[K] #= (Row[K] - 1) * C + Col[K],
        % the cell at that place holds the number K
        element(Pos[K], Grid, K)
    end,
    % the number K + 1 touches the number K: its cell is at most one row and one column away
    % (two different numbers never share a cell, so the two cells are never the same)
    foreach (K in 1..N - 1)
        abs(Row[K] - Row[K + 1]) #=< 1,
        abs(Col[K] - Col[K + 1]) #=< 1
    end,
    % search along the path of the numbers 1, 2, 3, ...
    Vars = [V : K in 1..N, V in [Row[K], Col[K]]],
    Outputs = [x = [[Grid[(I - 1) * C + J] : J in 1..C] : I in 1..R]],
    Options = [].

main([File]) =>
    Fd = open(File),
    Term = read_term(Fd),
    Term = $json_object(Keys, Values),
    close(Fd),
    Data = new_map([K = V : {K, V} in zip(Keys, Values)]),
    model(Data, Vars, Outputs, Options),
    solve(Options, Vars),
    solve(vars(Outputs)),
    foreach(Name = Value in Outputs)
        printf("%w = %w\n", Name, Value)
    end.
