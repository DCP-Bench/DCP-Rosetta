% four_numbers: an ECLiPSe model from DCP Rosetta.
%
% Given a list of up to four distinct integers between 1 and 10 (inclusive), find a list of three integers (also between
% 1 and 10, inclusive) such that all the original numbers can be generated by summing subsets of these three numbers.
% For example, if the input is [1, 3, 7, 8], a valid solution is [1, 2, 5], because 1 = 1, 3 = 1 + 2, 7 = 2 + 5 and
% 8 = 1 + 2 + 5.
%
% Save this file as model.ecl. Download `four_numbers.json` and `dcp_convert_ecl.py` from the
% problem's page:
%   https://dcp-bench.github.io/DCP-Rosetta/problems/four_numbers.html
% Convert the instances once, then run the first one (ECLiPSe 7.2, https://eclipseclp.org):
%   python dcp_convert_ecl.py four_numbers.json
%   eclipse -b model.ecl -e "run('four_numbers_1.dat'), halt"
%
% The data fields: numbers is the list of the given numbers.

:- lib(ic).

% Xs = [X1, X2, X3] is the list of three integers to find.
model(Instance, Xs, [x-Xs]) :-
    memberchk(numbers-Numbers, Instance),
    Xs = [X1, X2, X3],

    % each of the three integers is between 1 and 10
    Xs :: 1..10,

    % every given number is the sum of a non-empty subset of the three integers
    subsets(X1, X2, X3, Subsets),
    ( foreach(N, Numbers), param(Subsets) do
        covered(N, Subsets)
    ).

% the seven non-empty subsets of the three integers
subsets(X1, X2, X3,
        [[X1], [X2], [X3], [X1, X2], [X1, X3], [X2, X3], [X1, X2, X3]]).

% a given number N is covered when at least one subset sums to N
covered(N, Subsets) :-
    ( foreach(S, Subsets), foreach(B, Bs), param(N) do
        B :: 0..1,
        B #= (sum(S) #= N)
    ),
    sum(Bs) #>= 1.

% Reads the data file, builds the model, solves it and prints each output.
run(File) :-
    open(File, read, Stream), read(Stream, Instance), close(Stream),
    solve_model(Instance).

:- lib(branch_and_bound).

solve_model(Instance) :-
    (   current_module(gfd) -> Lib = gfd ; Lib = ic ),
    (   current_predicate(model/4)
    ->  model(Instance, Vars, Outputs, Objective)
    ;   model(Instance, Vars, Outputs), Objective = none
    ),
    (   Objective = max(Expr)
    ->  call(Lib:(Total #= Expr)), call(Lib:(Cost #= -Total)),
        minimize(run_search(Vars, Outputs), Cost)
    ;   Objective = min(Expr)
    ->  call(Lib:(Cost #= Expr)),
        minimize(run_search(Vars, Outputs), Cost)
    ;   run_search(Vars, Outputs)
    ),
    ( foreach(Name-Value, Outputs) do printf("%w = %w%n", [Name, Value]) ).

run_search(Vars, Outputs) :-
    (   current_predicate(search_goal/1) -> search_goal(Vars) ; labeling(Vars) ),
    term_variables(Outputs, Free),
    labeling(Free).
