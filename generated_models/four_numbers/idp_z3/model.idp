// four_numbers: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Given a list of up to four distinct integers between 1 and 10 (inclusive), find a list of three integers, also between
// 1 and 10 (inclusive), such that every one of the given numbers can be generated by summing subsets of these three
// numbers. For example, for the numbers 1, 3, 7 and 8, the three integers 1, 2 and 5 work: 1 = 1, 3 = 1 + 2, 7 = 2 + 5
// and 8 = 1 + 2 + 5.
//
// Save this file as model.idp. Download `four_numbers.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/four_numbers.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py four_numbers.json
//   idp-engine model_1.idp
vocabulary V {
    type Num <: Int                    // the given numbers, numbered from 0
    type Idx <: Int                    // the three integers of the answer, numbered from 0
    numbers: Num -> Int                // numbers(k): the k-th given number
    take: Num * Idx -> Bool            // take(k, j): the j-th integer of the answer is in the subset summing to numbers(k)
    x: Idx -> Int                      // x(j): the j-th of the three integers, between 1 and 10
}
structure D:V {
    Idx := {0..2}.
}
theory T:V {
    // each of the three integers is between 1 and 10 inclusive
    ! j in Idx: 1 =< x(j) & x(j) =< 10.
    // each given number is the sum of a subset of the three integers
    ! k in Num: numbers(k) = sum{{ x(j) | j in Idx: take(k, j) }}.
}
procedure main() {
    pretty_print(model_expand(T, S, D, max=1))
}
