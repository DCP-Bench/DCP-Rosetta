% four_numbers: a MiniZinc model from DCP Rosetta.
%
% Given a list of up to four distinct integers between 1 and 10 (inclusive), find a list of three
% integers (also between 1 and 10, inclusive) such that all the original numbers can be generated by
% summing subsets of these three numbers.
%
% Save this file as model.mzn. Download `four_numbers.json` and `dcp_convert_mzn.py` from the
% problem's page:
%   https://dcp-bench.github.io/DCP-Rosetta/problems/four_numbers.html
% Convert the instances once, then run the first one (MiniZinc 2.8 or later):
%   python dcp_convert_mzn.py four_numbers.json
%   minizinc model.mzn four_numbers_1.json

array[int] of int: numbers;                       % the given numbers
set of int: Numbers = index_set(numbers);         % one index per given number
set of int: Values = 1..10;                       % the given and the sought integers lie in 1..10

set of int: Sought = 1..3;                        % the positions of the three sought integers
array[Sought] of var Values: x;                     % the three integers sought

% in_subset[i,j]: x[j] is part of the subset of x that sums to numbers[i]
array[Numbers, Sought] of var bool: in_subset;

% each given number is the sum of the chosen subset of x
constraint forall(i in Numbers)(
    sum(j in Sought)(bool2int(in_subset[i,j]) * x[j]) = numbers[i]);

solve satisfy;

output ["{\"x\": ", showJSON(x), "}"];
