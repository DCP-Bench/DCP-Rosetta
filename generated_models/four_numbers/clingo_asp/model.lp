% four_numbers: a clingo model from DCP Rosetta.
%
% Given a list of up to four distinct integers between 1 and 10 (inclusive), find a list of three integers
% (also between 1 and 10, inclusive) such that all the original numbers can be generated by summing subsets
% of these three numbers.
%
% Save this file as model.lp. Download `four_numbers.json` and `dcp_convert_asp.py` from the
% problem's page:
%   https://dcp-bench.github.io/DCP-Rosetta/problems/four_numbers.html
% Convert the instances once, then run the first one (clingo 5.8, e.g. `pip install clingo`):
%   python dcp_convert_asp.py four_numbers.json
%   python -m clingo model.lp four_numbers_1.lp
%
% Input: numbers(I, N) holds the given number N at position I (indices are 0-based, as in the data).

% the positions of the three integers, and the values they can take
pos(0..2).
value(1..10).

% x(J, V): the J-th of the three integers is V
1 { x(J, V) : value(V) } 1 :- pos(J).

% use(I, J): the J-th integer is in the subset that sums to the I-th given number
{ use(I, J) : pos(J) } :- numbers(I, _).

% every given number is the sum of the integers in its subset
:- numbers(I, N), #sum { V, J : use(I, J), x(J, V) } != N.

#show x/2.
