// just_forgotten: an FO(·) model for IDP-Z3 from DCP Rosetta.
//
// Joe was furious when he forgot one of his bank account numbers. He remembered that it had all the digits from 0 to
// n-1 in some order, so he tried a number of sets without success. When Joe finally remembered his account number, he
// realised that in each set just a specific number of the digits were in their correct position and that, if one knew
// that, it was possible to work out his account number.
//
// Save this file as model.idp. Download `just_forgotten.json` and `dcp_convert_idp.py` from the
// problem's page:
//   https://dcp-bench.github.io/DCP-Rosetta/problems/just_forgotten.html
// Convert the instances once (the data is added to the model as a structure), then run the first
// one (`pip install idp-engine`, which the converter needs too):
//   python dcp_convert_idp.py just_forgotten.json
//   idp-engine model_1.idp
vocabulary V {
    type Guess <: Int                  // the sets of digits Joe tried, numbered from 0
    type Pos <: Int                    // the positions of the account number (and the digits), numbered from 0 to n-1
    sets: Guess * Pos -> Int           // sets(g, p): the digit in position p of set g
    num_correct_digits: () -> Int      // the number of digits in their correct position in each set
    digits: () -> Int                  // n, the number of digits (and of positions)
    x: Pos -> Int                      // x(p): the digit in position p of Joe's account number
}
theory T:V {
    // the number of digits is the number of positions
    digits() = #{ p in Pos: true }.
    // the account number has the digits from 0 to n-1
    ! p in Pos: 0 =< x(p) & x(p) =< digits() - 1.
    // the digits of the account number are all different, so each digit appears exactly once
    ! p in Pos: ! q in Pos: p ~= q => x(p) ~= x(q).
    // in each set, exactly num_correct_digits() digits are in their correct position
    ! g in Guess: #{ p in Pos: x(p) = sets(g, p) } = num_correct_digits().
}
procedure main() {
    pretty_print(model_expand(T, S, max=1))
}
